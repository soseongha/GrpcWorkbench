@page "/"
@rendermode InteractiveServer
@inject ISessionService SessionService
@inject IProtoLoader ProtoLoader
@inject IDynamicProtoCompiler ProtoCompiler
@inject IGrpcStreamingService StreamingService
@inject IUnaryGrpcService UnaryGrpcService
@inject IGrpcChannelProvider ChannelProvider
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnv
@inject IConfiguration Configuration
@inject WorkbenchNotificationService Notify
@inject WorkbenchStateService State
@inject TriggerExecutor TriggerExec
@inject UiStateService Ui
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IDdsSessionService DdsSessions
@inject DdsStateService DdsState
@inject INatsSessionService NatsSessions
@using ASAP.Models.Session
@using ASAP.Models.Dds
@using ASAP.Services
@using ASAP.Dds
@implements IDisposable

<PageTitle>Signal Forge</PageTitle>

<div class="wb-page pa-3">
    @{
        var connectedSessions = _sessionTabs;
        var aggregateSnapshots = State.SnapshotAggregates();
        var triggerSnapshot = State.SnapshotTriggers();
        var visibleIncomingCalls = aggregateSnapshots
            .SelectMany(State.SnapshotRecentCalls)
            .ToList();
        var visibleIncomingRpcCount = visibleIncomingCalls
            .Select(call => $"{call.Service}.{call.Method}")
            .Distinct(StringComparer.Ordinal)
            .Count();
        var visibleIncomingActiveCount = visibleIncomingCalls.Count(call => string.IsNullOrEmpty(call.Result));
        var visibleOutboundMessages = State.SnapshotOutbound()
            .Where(item => _session == null || string.Equals(item.SessionId, _session.SessionId, StringComparison.Ordinal))
            .ToList();
        var configuredScenarioCount = BuildScenarioGroups(triggerSnapshot).Count;
        var enabledTriggerCount = triggerSnapshot.Count(x => x.Enabled);
        var selectedMethodLabel = _selectedMethod == null
            ? "메서드 미선택"
            : $"{_selectedService?.ServiceName.Split('.').Last()}.{_selectedMethod.MethodName}";
        var protoLabel = CurrentProtoLabel();
        var currentSessionTarget = _session?.UnixSocketPath ?? "연결된 세션 없음";
        var currentOpenLocalStreams = _session == null ? [] : OpenLocalStreamsForCurrentSession();
        var currentOpenLocalStreamCount = currentOpenLocalStreams.Count;
        var selectedLocalStream = currentOpenLocalStreams.FirstOrDefault(stream => string.Equals(stream.StreamId, State.StreamId, StringComparison.Ordinal))
            ?? currentOpenLocalStreams.FirstOrDefault();
        var selectedLocalStreamLabel = selectedLocalStream == null ? "미선택" : ShortStreamId(selectedLocalStream.StreamId);
        var selectedLocalStreamSummary = selectedLocalStream == null
            ? "선택된 스트림 없음"
            : $"{selectedLocalStream.ServiceName.Split('.').Last()}.{selectedLocalStream.MethodName} · 보냄 {selectedLocalStream.MessagesSent} · 받음 {selectedLocalStream.ReceivedCount}";
    }

    @if (_evicted)
    {
        <div class="wb-panel wb-panel--contain pa-3 mb-4" style="border-color:color-mix(in srgb, var(--mud-palette-warning) 55%, var(--mud-palette-lines-default));">
            <div class="d-flex align-center flex-wrap" style="gap:10px;">
                <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Color="Color.Warning" />
                <div style="flex:1 1 320px;min-width:0;">
                    <div class="wb-panel-heading" title="다른 탭이 현재 활성입니다">비활성</div>
                    <div class="wb-inline-note" title="편집과 확인은 계속 가능하고, 이 탭을 다시 앞으로 가져오려면 오른쪽 버튼을 누르면 됩니다.">다른 탭 사용 중</div>
                </div>
                <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="ReclaimActive">이 탭 활성로 전환</MudButton>
            </div>
        </div>
    }

    <div class="wb-session-shell mb-4">
        <div class="wb-session-tabs">
            @foreach (var sessionTab in connectedSessions)
            {
                <div class="wb-session-tab @(IsGrpcSessionActive(sessionTab.SessionId) ? "is-active" : null)">
                    <button type="button"
                            class="wb-session-tab-main"
                            @onclick="@(() => ActivateSessionTab(sessionTab.SessionId))">
                        <span class="wb-session-tab-title">@FormatSessionTabLabel(sessionTab)</span>
                        <span class="wb-session-tab-note">gRPC · @(sessionTab.UnixSocketPath ?? sessionTab.SessionId[..8])</span>
                    </button>
                    <button type="button"
                            class="wb-session-tab-close"
                            title="gRPC 세션 탭 닫기"
                            @onclick:stopPropagation="true"
                            @onclick="@(async () => await CloseSessionTab(sessionTab.SessionId))">
                        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                    </button>
                </div>
            }
            @foreach (var dds in _ddsSessionTabs)
            {
                <div class="wb-session-tab @(IsDdsSessionActive(dds.SessionId) ? "is-active" : null)">
                    <button type="button" class="wb-session-tab-main"
                            @onclick="@(() => ActivateDdsSession(dds.SessionId))">
                        <span class="wb-session-tab-title">@FormatDdsSessionTabLabel(dds)</span>
                        <span class="wb-session-tab-note">@FormatDdsSessionTabNote(dds)</span>
                    </button>
                    <button type="button" class="wb-session-tab-close" title="DDS 탭 닫기"
                            @onclick:stopPropagation="true"
                            @onclick="@(async () => await CloseDdsSession(dds.SessionId))">
                        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                    </button>
                </div>
            }
            @foreach (var nats in _natsSessionTabs)
            {
                <div class="wb-session-tab @(IsNatsSessionActive(nats.SessionId) ? "is-active" : null)">
                    <button type="button" class="wb-session-tab-main"
                            @onclick="@(() => ActivateNatsSession(nats.SessionId))">
                        <span class="wb-session-tab-title">@FormatNatsSessionTabLabel(nats)</span>
                        <span class="wb-session-tab-note">@FormatNatsSessionTabNote(nats)</span>
                    </button>
                    <button type="button" class="wb-session-tab-close" title="NATS 탭 닫기"
                            @onclick:stopPropagation="true"
                            @onclick="@(async () => await CloseNatsSession(nats.SessionId))">
                        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                    </button>
                </div>
            }
            <button type="button"
                    class="wb-session-tab wb-session-tab--new @(IsAddTabActive() ? "is-active" : null)"
                    @onclick="ActivateAddTab">
                <span class="wb-session-tab-title">새 탭</span>
                <span class="wb-session-tab-note">작업 탭 추가</span>
            </button>
        </div>

        @if (ShouldShowNewTabPanel())
        {
            <div class="wb-panel wb-panel--contain pa-4 mt-3">
                <div class="wb-panel-kicker">새로</div>
                <div class="wb-panel-heading" title="먼저 열 작업 공간 하나를 고르세요">탭</div>
                <div class="wb-inline-note mt-2" title="@(HasOpenTabs() ? "새 탭은 현재 흐름을 끊지 않고 나란히 여는 용도입니다." : "아직 열린 탭이 없습니다. gRPC, DDS, NATS 중 하나부터 열어 보세요.")">작업 선택</div>

                <div class="wb-mode-strip mt-3">
                    <button type="button"
                            class="wb-mode-card @(_newTabKind == WorkbenchNewTabKind.GrpcSession ? "is-active" : null)"
                            @onclick="@(() => SelectNewTabKind(WorkbenchNewTabKind.GrpcSession))">
                        <MudIcon Icon="@Icons.Material.Filled.Cable" Size="Size.Small" Color="Color.Primary" />
                        <div class="wb-mode-title">gRPC 세션 탭</div>
                        <div class="wb-mode-note">소켓 하나에 연결해 호출, 스트림, proto 작업을 한 탭에서 관리</div>
                    </button>
                    <button type="button"
                            class="wb-mode-card @(_newTabKind == WorkbenchNewTabKind.DdsSession ? "is-active" : null)"
                            @onclick="@(() => SelectNewTabKind(WorkbenchNewTabKind.DdsSession))">
                        <MudIcon Icon="@Icons.Material.Filled.Hub" Size="Size.Small" Color="Color.Secondary" />
                        <div class="wb-mode-title">DDS 세션 탭</div>
                        <div class="wb-mode-note">Domain과 XML 설정으로 DDS 송수신, 수동 발행, 자동 실행을 시작</div>
                    </button>
                    <button type="button"
                            class="wb-mode-card @(_newTabKind == WorkbenchNewTabKind.NatsSession ? "is-active" : null)"
                            @onclick="@(() => SelectNewTabKind(WorkbenchNewTabKind.NatsSession))">
                        <MudIcon Icon="@Icons.Material.Filled.AlternateEmail" Size="Size.Small" Color="Color.Tertiary" />
                        <div class="wb-mode-title">NATS 세션 탭</div>
                        <div class="wb-mode-note">브로커 URL 하나로 subject 구독, 발행, 최근 메시지 흐름을 확인</div>
                    </button>
                </div>

                @if (_newTabKind == WorkbenchNewTabKind.GrpcSession)
                {
                    <div class="wb-subpanel mt-3">
                        <div class="wb-panel-kicker">gRPC</div>
                        <div class="wb-panel-heading" title="소켓 연결 후 전용 탭으로 열기">세션</div>
                        <div class="wb-home-form mt-3">
                            <MudTextField @bind-Value="_newGrpcSessionName"
                                          Label="탭 이름" Placeholder="예: B 피어 테스트"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudTextField @bind-Value="_socketPath"
                                          Label="연결할 소켓 경로" Placeholder="현재 인스턴스 수신 소켓"
                                          Variant="Variant.Outlined" Margin="Margin.Dense"
                                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Shortcut"
                                          AdornmentAriaLabel="현재 인스턴스 수신 소켓 경로" OnAdornmentClick="FillWorkbenchSocketPath" />
                            <MudNumericField @bind-Value="_timeoutSeconds" Label="타임아웃 (초)"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="300" />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       OnClick="ConnectSession" Disabled="_connecting"
                                       StartIcon="@Icons.Material.Filled.AddLink">
                                @if (_connecting)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <text>연결 중…</text>
                                }
                                else
                                {
                                    <text>gRPC 세션 탭 열기</text>
                                }
                            </MudButton>
                        </div>
                        <div class="wb-inline-note mt-3" title="탭 이름은 비워도 괜찮습니다. 소켓 경로나 세션 ID를 기준으로 자동 이름을 붙입니다.">내 소켓: @_mySocketPath</div>
                    </div>
                }
                else if (_newTabKind == WorkbenchNewTabKind.DdsSession)
                {
                    <div class="mt-3">
                        <DdsSessionCreateForm
                            OnCreated="OnDdsSessionCreated"
                            OnCancelled="ActivatePreferredFallbackTab" />
                    </div>
                }
                else
                {
                    <div class="mt-3">
                        <NatsSessionCreateForm
                            OnCreated="OnNatsSessionCreated"
                            OnCancelled="ActivatePreferredFallbackTab" />
                    </div>
                }
            </div>
        }
    </div>

    @if (IsDdsPanelActive())
    {
        <DdsSessionPanel Session="_activeDdsSession" />
    }
    else if (IsNatsPanelActive())
    {
        <NatsSessionPanel Session="_activeNatsSession" />
    }
    else if (IsGrpcPanelActive())
    {
    <div class="wb-panel wb-panel--major wb-panel--contain pa-3 mb-4">
        <div class="d-flex align-center flex-wrap mb-2" style="gap:8px;">
            <MudIcon Icon="@Icons.Material.Filled.Cable" Size="Size.Small" Color="@(_session == null ? Color.Default : Color.Success)" />
            <div>
                <div class="wb-panel-kicker">세션</div>
                <div class="wb-panel-heading" title="활성 대상과 proto 기준만 먼저 정합니다">작업</div>
            </div>
            <MudChip T="string" Size="Size.Small" Color="@(_session == null ? Color.Default : Color.Success)" Variant="Variant.Text" Class="ma-0">@(_session == null ? "미연결" : "연결됨")</MudChip>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@_services.Count 개 서비스</MudChip>
        </div>

        <div class="wb-summary-grid mt-3">
            <div class="wb-code wb-summary-card">
                <span style="color:var(--mud-palette-text-secondary);">현재 대상</span><br />
                @currentSessionTarget
            </div>
            <div class="wb-code wb-summary-card">
                <span style="color:var(--mud-palette-text-secondary);">로드된 proto</span><br />
                @protoLabel
            </div>
            <div class="wb-code wb-summary-card">
                <span style="color:var(--mud-palette-text-secondary);">현재 선택 메서드</span><br />
                @selectedMethodLabel
            </div>
            <div class="wb-code wb-summary-card">
                <span style="color:var(--mud-palette-text-secondary);">로컬 스트림</span><br />
                @currentOpenLocalStreamCount 개 열림 · 선택 @selectedLocalStreamLabel
                <br />
                @selectedLocalStreamSummary
            </div>
        </div>

        <div class="wb-topbar-grid mt-3">
            <div>
                <MudSelect T="string"
                           Label="활성 세션"
                           Value="@_activeSessionId"
                           ValueChanged="OnActiveSessionChanged"
                           Class="wb-select wb-select--comfortable wb-select--ellipsis"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Disabled="@(connectedSessions.Count == 0)">
                    @foreach (var sessionTab in connectedSessions)
                    {
                        <MudSelectItem T="string" Value="@sessionTab.SessionId">@($"{FormatSessionTabLabel(sessionTab)} · {sessionTab.UnixSocketPath ?? "소켓 경로 없음"}")</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div>
                <MudFileUpload T="IBrowserFile" FilesChanged="OnProtoFileSelected" Accept=".proto">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Outlined" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.UploadFile">
                            다른 .proto 업로드
                        </MudButton>
                    </ActivatorContent>
                </MudFileUpload>
            </div>
        </div>

        @if (_session != null)
        {
            var openLocalStreams = OpenLocalStreamsForCurrentSession().OrderBy(stream => stream.OpenedAt).ToList();
            <div class="wb-subpanel mt-3">
                <div class="wb-subpanel-head mb-3">
                    <div>
                        <div class="wb-panel-kicker">로컬</div>
                        <div class="wb-panel-heading" title="필요한 스트림만 열어 두고 재사용합니다">스트림</div>
                    </div>
                    <div class="wb-chip-row">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@openLocalStreams.Count 개 열림</MudChip>
                        @if (_streamOpen)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Class="ma-0">선택됨</MudChip>
                        }
                    </div>
                </div>

                <div class="wb-request-method-selectors">
                    <MudSelect T="string" Value="@(_selectedService?.ServiceName ?? string.Empty)"
                               ValueChanged="OnServiceSelected"
                               Label="스트림 대상 서비스" Margin="Margin.Dense" Variant="Variant.Outlined">
                        @foreach (var service in _services)
                        {
                            <MudSelectItem T="string" Value="@service.ServiceName">@service.ServiceName</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="string" Value="@(_selectedMethod?.MethodName ?? string.Empty)"
                               ValueChanged="OnMethodNameSelected"
                               Label="스트림 대상 메서드" Margin="Margin.Dense" Variant="Variant.Outlined"
                               Disabled="@(_selectedService == null)">
                        @foreach (var method in _selectedService?.Methods ?? [])
                        {
                            <MudSelectItem T="string" Value="@method.MethodName">@method.MethodName  ·  @method.RpcType</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="d-flex align-center flex-wrap mt-3" style="gap:8px;">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.PlayArrow"
                               Disabled="@(!CanOpenSelectedStreamMethod())"
                               OnClick="StartStream">
                        스트림 열기
                    </MudButton>
                    <MudTooltip Text="@SelectedStreamMethodNote()">
                        <MudIcon Icon="@Icons.Material.Outlined.HelpOutline" Size="Size.Small" Style="cursor:help;color:var(--mud-palette-text-secondary);" />
                    </MudTooltip>
                </div>

                @if (openLocalStreams.Count == 0)
                {
                    <div class="wb-empty mt-3">
                        <MudIcon Icon="@Icons.Material.Outlined.Stream" Class="mb-2" />
                        <div>현재 세션에 열린 로컬 스트림이 없습니다</div>
                    </div>
                }
                else
                {
                    <div class="wb-scroll mt-3" style="max-height:240px;overflow-y:auto;">
                        @for (var index = 0; index < openLocalStreams.Count; index++)
                        {
                            var stream = openLocalStreams[index];
                               <div class="wb-scenario-step mb-2 @(State.StreamId == stream.StreamId ? "is-selected" : null)"
                                   style="width:100%;text-align:left;cursor:pointer;"
                                   @onclick="@(() => SelectLocalStream(stream.StreamId))">
                                <div class="wb-scenario-step-top">
                                    <div>
                                        <div class="wb-scenario-step-order">#@(index + 1) · @stream.RpcType</div>
                                        <div class="wb-scenario-step-title">@(stream.ServiceName.Split('.').Last() + "." + stream.MethodName)</div>
                                    </div>
                                    <div class="wb-chip-row">
                                        @if (State.StreamId == stream.StreamId)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Class="ma-0">현재 선택</MudChip>
                                        }
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@ShortStreamId(stream.StreamId)</MudChip>
                                    </div>
                                </div>
                                <div class="wb-scenario-step-meta">
                                    <div>
                                        <span class="wb-scenario-label">세션</span>
                                        <span class="wb-scenario-value">@FormatSessionTabLabel(_session)</span>
                                    </div>
                                    <div>
                                        <span class="wb-scenario-label">열림</span>
                                        <span class="wb-scenario-value">@FormatOpenedAt(stream.OpenedAt)</span>
                                    </div>
                                    <div>
                                        <span class="wb-scenario-label">송수신</span>
                                        <span class="wb-scenario-value">보냄 @stream.MessagesSent · 받음 @stream.ReceivedCount</span>
                                    </div>
                                </div>
                                <div class="wb-scenario-step-actions">
                                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Close"
                                               OnClick="@(() => CloseLocalStream(stream.StreamId))">
                                        닫기
                                    </MudButton>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <MudGrid Spacing="2">

        @* ════════ 상단: 수신 ════════ *@
        <MudItem xs="12" Class="wb-section-order-1">
            <div class="wb-panel wb-panel--major wb-panel--contain pa-3">
                <div class="d-flex align-center flex-wrap mb-1" style="gap:8px;">
                    <MudIconButton Icon="@(_incomingExpanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                                   Size="Size.Small" OnClick="@(() => _incomingExpanded = !_incomingExpanded)" />
                    <MudIcon Icon="@Icons.Material.Filled.Sensors" Size="Size.Small" Color="Color.Info" />
                    <div>
                        <div class="wb-panel-kicker">수신</div>
                        <div class="wb-panel-heading" title="이 인스턴스에서 관찰된 RPC 트래픽">트래픽</div>
                    </div>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@visibleIncomingRpcCount 개 RPC</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0"
                             Color="@(visibleIncomingActiveCount > 0 ? Color.Info : Color.Default)">
                        @visibleIncomingActiveCount 활성
                    </MudChip>
                    <MudSpacer />
                    @if (_incomingExpanded)
                    {
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Download"
                                   Disabled="@(visibleIncomingCalls.Count == 0)"
                                   OnClick="ExportIncomingSnapshot">
                            내보내기
                        </MudButton>
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.ContentCut"
                                   Disabled="@(visibleIncomingCalls.Count == 0)"
                                   OnClick="TrimIncomingSnapshot">
                            유휴 정리
                        </MudButton>
                        <MudTooltip Text="@(State.IncomingPaused ? "수신 표시 재개 (백그라운드 누적은 계속됨)" : "수신 표시 일시정지")">
                            <MudIconButton Size="Size.Small"
                                           Color="@(State.IncomingPaused ? Color.Warning : Color.Default)"
                                           Icon="@(State.IncomingPaused ? Icons.Material.Filled.PlayArrow : Icons.Material.Filled.Pause)"
                                           OnClick="@(() => State.SetPaused(!State.IncomingPaused))" />
                        </MudTooltip>
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteSweep" Size="Size.Small"
                                       title="수신 집계 비우기" OnClick="@(() => State.ClearIncoming())" />
                    }
                </div>

                @if (_incomingExpanded)
                {
                    <div class="wb-panel-body">
                        <div class="d-flex align-center flex-wrap mb-3 wb-stat-strip" style="gap:6px;">
                            <MudTooltip Text="활성 RPC 종류 수">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">
                                    @visibleIncomingRpcCount 개 RPC
                                </MudChip>
                            </MudTooltip>
                            <MudTooltip Text="진행 중인 호출 수">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0"
                                         Color="@(visibleIncomingActiveCount > 0 ? Color.Info : Color.Default)">
                                    @visibleIncomingActiveCount 활성
                                </MudChip>
                            </MudTooltip>
                            <MudTooltip Text="총 수신 속도 (frames/sec)">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">
                                    @($"{State.TotalRatePerSec:F1}/s")
                                </MudChip>
                            </MudTooltip>
                        </div>

                        @if (visibleIncomingCalls.Count == 0)
                        {
                            <div class="wb-empty">
                                <MudIcon Icon="@Icons.Material.Outlined.Sensors" Class="mb-2" />
                                <div>이 인스턴스의 UDS 서버 수신 호출이<br />Service.Method 단위로 집계됩니다</div>
                            </div>
                        }
                        else
                        {
                            var incomingPanel = BuildIncomingPanelState(visibleIncomingCalls);

                            <div class="wb-detail-pane">
                                <div class="wb-detail-head mb-3">
                                    <div class="wb-detail-head-copy">
                                        <div class="wb-panel-kicker">상세</div>
                                        <div class="d-flex align-center" style="gap:6px;">
                                            <div class="wb-panel-heading" title="수신 스트림/호출">호출</div>
                                            <MudTooltip Text="수신 집계는 Service.Method 기준으로 정리해 두고, 펼쳤을 때만 프레임 상세를 보여줘요. 오래된 유휴 RPC 정리와 전체 스냅샷 저장도 여기서 할 수 있어요.">
                                                <MudIcon Icon="@Icons.Material.Outlined.HelpOutline" Size="Size.Small" Style="cursor:help;color:var(--mud-palette-text-secondary);" />
                                            </MudTooltip>
                                        </div>
                                    </div>
                                    <div class="wb-chip-row wb-chip-row--detail">
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0 wb-chip wb-chip--ellipsis">@incomingPanel.Calls.Count 개 스트림/호출</MudChip>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0 wb-chip wb-chip--wrap">listener-wide</MudChip>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0 wb-chip wb-chip--wrap">@($"{State.TotalRatePerSec:F1}/s")</MudChip>
                                    </div>
                                </div>
                                <div class="wb-call-grid">
                                    <div class="wb-call-list wb-scroll">
                                        @if (incomingPanel.Calls.Count == 0)
                                        {
                                            <div class="wb-empty" style="padding:18px 12px;">관찰된 스트림/호출 없음</div>
                                        }
                                        else
                                        {
                                            @foreach (var call in incomingPanel.Calls)
                                            {
                                                <button type="button"
                                                        class="wb-call-row @(incomingPanel.SelectedCall?.CallId == call.CallId ? "is-selected" : null)"
                                                        @onclick="@(() => SelectIncomingCall(call.CallId))">
                                                    <div class="wb-call-row-top">
                                                        <span class="wb-mono wb-call-row-title">@(call.Service.Split('.').Last()).@call.Method</span>
                                                        <span class="wb-call-row-count">@incomingPanel.FrameCounts[call.CallId] 개 메시지</span>
                                                    </div>
                                                    <div class="wb-call-row-meta">
                                                        <span class="wb-mono">@call.CallId[..8]</span>
                                                        <span>@call.Type</span>
                                                        <span>@call.LastActivityAt.ToLocalTime().ToString("HH:mm:ss")</span>
                                                        <span>@(string.IsNullOrEmpty(call.Result) ? "진행 중" : "종료됨")</span>
                                                    </div>
                                                </button>
                                            }
                                        }
                                    </div>
                                    <div class="wb-frame-detail wb-scroll">
                                                @if (incomingPanel.SelectedCall == null)
                                                {
                                                    <div class="wb-empty" style="padding:18px 12px;">상세를 볼 call을 선택하세요</div>
                                                }
                                                else
                                                {
                                                    var inboundReplyEnabled = Notify.CanWriteInboundResponse(incomingPanel.SelectedCall.CallId);
                                                    <div class="d-flex align-center flex-wrap mb-2" style="gap:8px;">
                                                        <span class="wb-panel-title">메시지</span>
                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@incomingPanel.SelectedFrames.Count</MudChip>
                                                        <MudSpacer />
                                                        @if (incomingPanel.SelectedFrames.Count > 0)
                                                        {
                                                            <MudTooltip Text="@(incomingPanel.SelectedCall.Pretty ? "원문(raw)" : "들여쓰기")">
                                                                <MudIconButton Size="Size.Small" Class="pa-0"
                                                                               Icon="@(incomingPanel.SelectedCall.Pretty ? Icons.Material.Filled.Notes : Icons.Material.Filled.FormatAlignLeft)"
                                                                               OnClick="@(() => incomingPanel.SelectedCall.Pretty = !incomingPanel.SelectedCall.Pretty)" />
                                                            </MudTooltip>
                                                        }
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(incomingPanel.SelectedCall.Result))
                                                    {
                                                        <div class="wb-inline-note mb-2">@incomingPanel.SelectedCall.Result</div>
                                                    }
                                                    @if (incomingPanel.SelectedFrame != null)
                                                    {
                                                        <div class="wb-selection-note mb-2">
                                                            <span>선택 스트림 <span class="wb-mono">@incomingPanel.SelectedCall.CallId[..8]</span></span>
                                                            <span>메시지 @incomingPanel.SelectedFrame.Index / @incomingPanel.SelectedFrames.Count</span>
                                                            <span>@incomingPanel.SelectedFrame.Time.ToLocalTime().ToString("HH:mm:ss")</span>
                                                        </div>
                                                    }
                                                    @if (incomingPanel.SelectedCall.Type == "BidirectionalStreaming" && !inboundReplyEnabled)
                                                    {
                                                        <div class="wb-inline-note mb-3">스트림 종료됨</div>
                                                    }
                                                    @if (incomingPanel.SelectedFrames.Count == 0)
                                                    {
                                                        <div class="wb-empty" style="padding:18px 12px;">표시할 메시지 없음</div>
                                                    }
                                                    else
                                                    {
                                                        <ResizableSplit Class="wb-message-split" StorageKey="sf.split.grpc.inbound" DefaultPrimary="240" MinPrimary="170" MinSecondary="260">
                                                            <Primary>
                                                            <div class="wb-scroll wb-message-list">
                                                                @foreach (var frame in incomingPanel.SelectedFramesDescending)
                                                                {
                                                                    <button type="button"
                                                                            class="wb-call-row wb-message-row @(incomingPanel.SelectedFrame?.Index == frame.Index ? "is-selected" : null)"
                                                                            @onclick="@(() => SelectIncomingFrame(frame.Index))">
                                                                        <div class="wb-message-row-main">
                                                                            <span class="wb-mono">@frame.Time.ToLocalTime().ToString("HH:mm:ss")</span>
                                                                            <span>메시지 @frame.Index</span>
                                                                        </div>
                                                                    </button>
                                                                }
                                                            </div>
                                                            </Primary>
                                                            <Secondary>
                                                            <div class="wb-message-content">
                                                                @if (incomingPanel.SelectedFrame != null)
                                                                {
                                                                    <JsonDataView Json="@incomingPanel.SelectedFrame.Data" />
                                                                }
                                                                else
                                                                {
                                                                    <div class="wb-empty" style="padding:18px 12px;">오른쪽에서 볼 메시지를 선택하세요</div>
                                                                }
                                                            </div>
                                                            </Secondary>
                                                        </ResizableSplit>
                                                    }
                                                }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </MudItem>

        @* ════════ 하단: Triggers (자동 송신 규칙) ════════ *@
        <MudItem xs="12" Class="wb-section-order-3">
            <div class="wb-panel wb-panel--major pa-3">
                <div class="d-flex align-center mb-2" style="gap:8px;">
                    <MudIconButton Icon="@(_triggersExpanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                                   Size="Size.Small" OnClick="@(() => _triggersExpanded = !_triggersExpanded)" />
                    <MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Small" Color="Color.Warning" />
                    <div>
                        <div class="wb-panel-kicker">gRPC</div>
                        <div class="wb-panel-heading" title="메시지 단계마다 자동 조건과 수동 발사를 함께 관리합니다">자동화</div>
                    </div>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@triggerSnapshot.Count</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">시나리오 @configuredScenarioCount</MudChip>
                    @if (enabledTriggerCount > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Class="ma-0">
                            자동 동작 @enabledTriggerCount
                        </MudChip>
                    }
                    <MudSpacer />
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="AddScenarioGroup">
                        시나리오 추가
                    </MudButton>
                </div>
                @if (_triggersExpanded)
                {
                    <div class="wb-inline-note mb-3" title="시나리오 추가를 누르면 첫 단계가 포함된 새 시나리오를 만들고, 수동/자동/전체 실행을 시나리오 단위로 제어합니다.">시나리오 단위</div>
                    var scenarioGroups = BuildScenarioGroups(triggerSnapshot);
                    @if (scenarioGroups.Count > 0)
                    {
                        <div class="wb-panel pa-2 mb-3">
                            <div class="d-flex align-center flex-wrap mb-2" style="gap:8px;">
                                <span class="wb-panel-title">시나리오 단계</span>
                                <MudTooltip Text="수동 전체 실행은 모든 단계를 순서대로 한 번 수행해요. 자동 단계 시작은 이 시나리오의 자동 단계를 켜고, 전체 시작은 수동 실행 뒤 자동 단계를 이어서 유지해요.">
                                    <MudIcon Icon="@Icons.Material.Outlined.HelpOutline" Size="Size.Small" Style="cursor:help;color:var(--mud-palette-text-secondary);" />
                                </MudTooltip>
                                <MudSpacer />
                                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                           Disabled="@(scenarioGroups.Count == 0)"
                                           OnClick="ExportAllScenarios">
                                    전체 내보내기
                                </MudButton>
                                <MudFileUpload T="IBrowserFile" FilesChanged="ImportScenarioJson" Accept=".json">
                                    <ActivatorContent>
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.UploadFile">
                                            전체 불러오기
                                        </MudButton>
                                    </ActivatorContent>
                                </MudFileUpload>
                            </div>
                            <div class="d-flex flex-wrap" style="gap:8px;">
                                @foreach (var group in scenarioGroups)
                                {
                                    <div class="wb-panel pa-3 wb-scenario-group" style="min-width:320px;flex:1 1 480px;">
                                        <div class="wb-scenario-step-top">
                                            <div>
                                                <div class="wb-scenario-step-order">시나리오</div>
                                                <div class="wb-scenario-step-title">@group.Name</div>
                                            </div>
                                            <div class="wb-chip-row">
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@group.OrderedSteps.Count 단계</MudChip>
                                                <MudChip T="string" Size="Size.Small" Color="@(group.OrderedSteps.Any(step => step.Enabled) ? Color.Success : Color.Default)" Variant="Variant.Text" Class="ma-0">@group.OrderedSteps.Count(step => step.Enabled) 동작 중</MudChip>
                                            </div>
                                        </div>
                                        <div class="wb-inline-note mt-2" title="수동 전체 실행은 모든 단계를 순서대로 한 번 보내고, 자동 단계 시작은 이 시나리오의 자동 단계를 백그라운드에서 유지합니다.">범위: @group.Name</div>
                                        <div class="wb-scenario-step-actions mt-2">
                                            <MudButton Variant="Variant.Text" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Add"
                                                       OnClick="@(() => AddScenarioStep(group.Name))">
                                                단계 추가
                                            </MudButton>
                                            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.PlayArrow"
                                                       OnClick="@(() => RunScenario(group.Name))">
                                                수동 전체 실행
                                            </MudButton>
                                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.AutoMode"
                                                       OnClick="@(() => StartScenarioAutomation(group.Name))">
                                                자동 단계 시작
                                            </MudButton>
                                            <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.PlayCircle"
                                                       OnClick="@(() => StartScenarioWorkflow(group.Name))">
                                                전체 시작
                                            </MudButton>
                                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Stop"
                                                       Disabled="@(group.OrderedSteps.All(step => !step.Enabled))"
                                                       OnClick="@(() => StopScenarioAutomation(group.Name))">
                                                자동화 중지
                                            </MudButton>
                                        </div>
                                        <div class="wb-scenario-list mt-2 wb-scroll" style="max-height:320px;overflow:auto;">
                                            @foreach (var step in group.OrderedSteps)
                                            {
                                                <div @key="step.Id" class="wb-scenario-step">
                                                    <div class="wb-scenario-step-top">
                                                        <div>
                                                            <div class="wb-scenario-step-order">단계 @step.StepOrder</div>
                                                            <div class="wb-scenario-step-title">@(string.IsNullOrWhiteSpace(step.Name) ? step.Id : step.Name)</div>
                                                        </div>
                                                        <div class="wb-chip-row">
                                                            <MudChip T="string" Size="Size.Small" Color="@TriggerTypeColor(step.Type)" Variant="Variant.Text" Class="ma-0">
                                                                @TriggerTypeLabel(step.Type)
                                                            </MudChip>
                                                            <MudChip T="string" Size="Size.Small" Color="@(step.Enabled ? Color.Success : Color.Default)" Variant="Variant.Text" Class="ma-0">
                                                                @(step.Enabled ? "자동화 동작 중" : "자동화 대기")
                                                            </MudChip>
                                                        </div>
                                                    </div>
                                                    <div class="wb-scenario-step-meta">
                                                        <div>
                                                            <span class="wb-scenario-label">조건</span>
                                                            <span class="wb-scenario-value wb-preline">@ScenarioWhenLabel(step)</span>
                                                        </div>
                                                        <div>
                                                            <span class="wb-scenario-label">대상</span>
                                                            <span class="wb-scenario-value">@TriggerDestinationLabel(step)</span>
                                                        </div>
                                                    </div>
                                                    <div class="wb-scenario-step-actions">
                                                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                                                   StartIcon="@Icons.Material.Filled.KeyboardArrowUp"
                                                                   Disabled="@(step.StepOrder <= 1)"
                                                                   OnClick="@(() => MoveScenarioStep(step, -1))">
                                                            위로
                                                        </MudButton>
                                                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                                                   StartIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                                                   Disabled="@(step == group.OrderedSteps[^1])"
                                                                   OnClick="@(() => MoveScenarioStep(step, 1))">
                                                            아래로
                                                        </MudButton>
                                                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                                                   StartIcon="@Icons.Material.Filled.Edit"
                                                                   OnClick="@(() => EditTrigger(step))">
                                                            편집
                                                        </MudButton>
                                                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Success"
                                                                   StartIcon="@Icons.Material.Filled.PlayArrow"
                                                                   OnClick="@(() => step.Type == TriggerType.Bulk ? FireBulk(step) : FireManual(step))">
                                                            1회 발사
                                                        </MudButton>
                                                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error"
                                                                   StartIcon="@Icons.Material.Filled.DeleteOutline"
                                                                   OnClick="@(() => DeleteTrigger(step))">
                                                            삭제
                                                        </MudButton>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    else if (triggerSnapshot.Count == 0)
                    {
                        <div class="wb-empty">
                            <MudIcon Icon="@Icons.Material.Outlined.Bolt" Class="mb-2" />
                            <div>등록된 자동화 단계가 없습니다<br />주기, 수신 반응, 묶음 발사 규칙을 여기서 추가합니다</div>
                        </div>
                    }

                }
            </div>
        </MudItem>

        @* ════════ 하단: 송신 이력 ════════ *@
        <MudItem xs="12" Class="wb-section-order-2">
            <div class="wb-panel wb-panel--major wb-panel--contain pa-3">
                <div class="d-flex align-center mb-1" style="gap:8px;">
                    <MudIconButton Icon="@(_outboundExpanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                                   Size="Size.Small" OnClick="@(() => _outboundExpanded = !_outboundExpanded)" />
                    <MudIcon Icon="@Icons.Material.Filled.NorthEast" Size="Size.Small" Color="Color.Primary" />
                    <div>
                        <div class="wb-panel-kicker">이력</div>
                        <div class="wb-panel-heading">송신</div>
                    </div>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@visibleOutboundMessages.Count</MudChip>
                    <MudSpacer />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Download"
                               Disabled="@(visibleOutboundMessages.Count == 0)"
                               OnClick="ExportOutboundSnapshot">
                        내보내기
                    </MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.ContentCut"
                               Disabled="@(visibleOutboundMessages.Count == 0)"
                               OnClick="TrimOutboundSnapshot">
                        500건만 유지
                    </MudButton>
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteSweep" Size="Size.Small"
                                   title="송신 이력 비우기" OnClick="@(() => State.ClearOutbound())" />
                </div>
                @if (_outboundExpanded)
                {
                    var outboundPanel = BuildOutboundPanelState(visibleOutboundMessages);
                    <div class="wb-panel-body">
                        @if (outboundPanel.Outbound.Count == 0)
                        {
                            <div class="wb-empty" style="min-height:120px;">
                                <MudIcon Icon="@Icons.Material.Outlined.NorthEast" Class="mb-2" />
                                <div>송신 이력 없음</div>
                            </div>
                        }
                        else
                        {
                            <div class="wb-detail-pane" style="min-height:420px;">
                                <div class="wb-detail-head mb-3">
                                    <div class="wb-detail-head-copy">
                                        <div class="wb-panel-kicker">상세</div>
                                        <div class="d-flex align-center" style="gap:6px;">
                                            <div class="wb-panel-heading" title="송신 스트림/호출">호출</div>
                                            <MudTooltip Text="송신 집계는 Service.Method 기준으로 정리되고, 현재 열린 탭 세션 기준 메시지만 보여줍니다.">
                                                <MudIcon Icon="@Icons.Material.Outlined.HelpOutline" Size="Size.Small" Style="cursor:help;color:var(--mud-palette-text-secondary);" />
                                            </MudTooltip>
                                        </div>
                                    </div>
                                    <div class="wb-chip-row wb-chip-row--detail">
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0 wb-chip wb-chip--ellipsis">@outboundPanel.Aggregates.Count 개 스트림/호출</MudChip>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0 wb-chip wb-chip--wrap">current-tab-wide</MudChip>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0 wb-chip wb-chip--wrap">@outboundPanel.Outbound.Count 건 송신</MudChip>
                                    </div>
                                </div>
                                <div class="wb-call-grid">
                                    <div class="wb-call-list wb-scroll">
                                        @foreach (var agg in outboundPanel.Aggregates)
                                        {
                                            <button type="button"
                                                    class="wb-call-row @(outboundPanel.SelectedAggregate?.Key == agg.Key ? "is-selected" : null)"
                                                    @onclick="@(() => SelectOutboundAggregate(agg.Key))">
                                                <div class="wb-call-row-top">
                                                    <span class="wb-mono wb-call-row-title">@agg.Label</span>
                                                    <span class="wb-call-row-count">@agg.Count 개 메시지</span>
                                                </div>
                                                <div class="wb-call-row-meta">
                                                    <span class="wb-mono">@ShortSessionId(agg.Entries.FirstOrDefault()?.SessionId)</span>
                                                    <span>@agg.SourcesLabel</span>
                                                    <span>@agg.LastSentAt.ToLocalTime().ToString("HH:mm:ss")</span>
                                                    <span>전송됨</span>
                                                </div>
                                            </button>
                                        }
                                    </div>
                                    <div class="wb-frame-detail wb-scroll">
                                                @if (outboundPanel.SelectedAggregate == null)
                                                {
                                                    <div class="wb-empty" style="padding:18px 12px;">상세를 볼 송신 스트림/호출을 선택하세요</div>
                                                }
                                                else
                                                {
                                                    <div class="d-flex align-center flex-wrap mb-2" style="gap:8px;">
                                                        <span class="wb-panel-title">메시지</span>
                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@outboundPanel.SelectedEntries.Count</MudChip>
                                                    </div>
                                                    @if (outboundPanel.SelectedEntry != null)
                                                    {
                                                        <div class="wb-selection-note mb-2">
                                                            <span>선택 스트림 <span class="wb-mono">@outboundPanel.SelectedAggregate.Label</span></span>
                                                            <span>메시지 @outboundPanel.EntryIndexes[outboundPanel.SelectedEntry.Id] / @outboundPanel.SelectedEntries.Count</span>
                                                            <span>@outboundPanel.SelectedEntry.Time.ToLocalTime().ToString("HH:mm:ss")</span>
                                                        </div>
                                                    }
                                                    <ResizableSplit Class="wb-message-split" StorageKey="sf.split.grpc.outbound" DefaultPrimary="240" MinPrimary="170" MinSecondary="260">
                                                        <Primary>
                                                        <div class="wb-scroll wb-message-list">
                                                            @foreach (var item in outboundPanel.SelectedEntries)
                                                            {
                                                                <button type="button"
                                                                        class="wb-call-row wb-message-row @(outboundPanel.SelectedEntry?.Id == item.Id ? "is-selected" : null)"
                                                                        @onclick="@(() => SelectOutboundEntry(item.Id))">
                                                                    <div class="wb-message-row-main">
                                                                        <span class="wb-mono">@item.Time.ToLocalTime().ToString("HH:mm:ss")</span>
                                                                        <span>메시지 @outboundPanel.EntryIndexes[item.Id]</span>
                                                                    </div>
                                                                </button>
                                                            }
                                                        </div>
                                                        </Primary>
                                                        <Secondary>
                                                        <div class="wb-message-content">
                                                            @if (outboundPanel.SelectedEntry != null)
                                                            {
                                                                <JsonDataView Json="@outboundPanel.SelectedEntry.Json" />
                                                            }
                                                            else
                                                            {
                                                                <div class="wb-empty" style="padding:18px 12px;">오른쪽에서 볼 메시지를 선택하세요</div>
                                                            }
                                                        </div>
                                                        </Secondary>
                                                    </ResizableSplit>
                                                }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </MudItem>

    </MudGrid>

    @if (_editingTrigger != null)
    {
        var editor = _editingTrigger;
        var editorIncomingServiceOptions = BuildIncomingServiceOptions(aggregateSnapshots, _services);
        var editorIncomingMethodLookup = BuildIncomingMethodOptionsLookup(aggregateSnapshots, _services);
        var editorAvailableInboundTargets = BuildAvailableInboundTargets(aggregateSnapshots);
        var compatibleOpenLocalStreams = CompatibleOpenLocalStreamsForTrigger(editor);
        <div class="wb-editor-backdrop"></div>
        <div class="wb-editor-shell">
            <div class="wb-editor-drawer wb-panel pa-4 wb-scroll">
                    <div class="wb-panel-head mb-3">
                        <div>
                            <div class="wb-panel-kicker d-flex align-center" style="gap:6px;">
                                <span>트리거 편집기</span>
                                <MudTooltip Text="대상 서비스·메서드, payload, 수동 발사는 여기서 다뤄요. 스트리밍 RPC는 로컬 스트림 기준에 따라 열린 스트림을 재사용하거나 발사 시 자동으로 열어요.">
                                    <MudIcon Icon="@Icons.Material.Outlined.HelpOutline" Size="Size.Small" Style="cursor:help;color:var(--mud-palette-text-secondary);" />
                                </MudTooltip>
                            </div>
                            <div class="wb-panel-heading">@(string.IsNullOrWhiteSpace(editor.Name) ? editor.Id : editor.Name)</div>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseTriggerEditor" />
                    </div>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="editor.Name" Label="이름" Placeholder="@editor.Id"
                                          Margin="Margin.Dense" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <div class="wb-inline-note" style="margin-top:12px;" title="시나리오 안의 단계입니다. 순서는 카드의 위/아래 버튼으로만 바꿔 주세요.">시나리오 @NormalizeScenarioName(editor.Scenario)</div>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="TriggerType" Value="editor.Type"
                                       ValueChanged="@((TriggerType v) => { editor.Type = v; State.NotifyTriggersChanged(); })"
                                       Label="타입" Margin="Margin.Dense" Variant="Variant.Outlined"
                                       Class="wb-select">
                                @foreach (var tt in Enum.GetValues<TriggerType>())
                                {
                                    <MudSelectItem T="TriggerType" Value="tt">@tt</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudSelect T="string" Value="editor.TargetService"
                                       ValueChanged="@((string v) => OnTriggerTargetServiceChanged(editor, v))"
                                       Label="대상 서비스" Margin="Margin.Dense" Variant="Variant.Outlined"
                                       Class="wb-select wb-select--ellipsis">
                                @foreach (var s in _services)
                                {
                                    <MudSelectItem T="string" Value="@s.ServiceName">@s.ServiceName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudSelect T="string" Value="editor.TargetMethod"
                                       ValueChanged="@((string v) => OnTriggerTargetMethodChanged(editor, v))"
                                       Label="대상 메서드" Margin="Margin.Dense" Variant="Variant.Outlined"
                                       Class="wb-select wb-select--ellipsis"
                                       Disabled="@string.IsNullOrEmpty(editor.TargetService)">
                                @{
                                    var editorSvc = _services.FirstOrDefault(s => s.ServiceName == editor.TargetService);
                                }
                                @foreach (var m in editorSvc?.Methods ?? [])
                                {
                                    <MudSelectItem T="string" Value="@m.MethodName">@m.MethodName  ·  @m.RpcType</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            @if (ResolveTriggerMethod(editor) is { } triggerMethod)
                            {
                                <div class="wb-panel wb-rpc-accent @RpcCss(triggerMethod.RpcType) pa-2">
                                    <MudChip T="string" Size="Size.Small" Color="@RpcTypeColor(triggerMethod.RpcType)"
