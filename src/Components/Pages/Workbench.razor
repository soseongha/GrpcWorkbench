    private void OnTriggerMatchServiceChanged(Trigger t, string value)
    {
        t.MatchService = value == AnyMatchValue ? "" : value;
        var methodLookup = BuildIncomingMethodOptionsLookup(State.SnapshotAggregates(), _services);
        if (!string.IsNullOrEmpty(t.MatchMethod) &&
            !ResolveIncomingMethodOptions(methodLookup, t.MatchService).Contains(t.MatchMethod, StringComparer.Ordinal))
            t.MatchMethod = "";
        State.NotifyTriggersChanged();
    }

    private void OnTriggerMatchMethodChanged(Trigger t, string value)
    {
        t.MatchMethod = value == AnyMatchValue ? "" : value;
        State.NotifyTriggersChanged();
    }

    private void EditTrigger(Trigger trigger)
    {
        ClearTriggerEditing();
        trigger.Editing = true;
        _editingTrigger = trigger;
        _triggersExpanded = true;
        InitializeTriggerPayloadEditor(trigger);
        State.NotifyTriggersChanged();
    }

    private void SaveTriggerEditor()
    {
        if (_editingTrigger == null) return;
        if (!_triggerRawJsonMode && _triggerSchemaFields.Count > 0)
            BuildTriggerJsonFromForm();
        ResetTriggerEditor();
        State.NotifyTriggersChanged();
        Snackbar.Add("Trigger 저장 완료", Severity.Success);
    }

    private void CloseTriggerEditor()
    {
        if (_editingTrigger == null) return;
        ResetTriggerEditor();
        State.NotifyTriggersChanged();
    }

    private void DeleteTrigger(Trigger trigger)
    {
        trigger.Editing = false;
        if (_editingTrigger?.Id == trigger.Id)
            ResetTriggerEditor();
        State.RemoveTrigger(trigger.Id);
        Snackbar.Add("Trigger 삭제 완료", Severity.Info);
    }

    private void MoveScenarioStep(Trigger trigger, int delta)
    {
        if (string.IsNullOrWhiteSpace(trigger.Scenario) || delta == 0) return;

        var steps = BuildScenarioStepList(SnapshotTriggersList(), trigger.Scenario.Trim());

        var index = steps.FindIndex(t => t.Id == trigger.Id);
        var newIndex = index + delta;
        if (index < 0 || newIndex < 0 || newIndex >= steps.Count) return;

        (steps[index], steps[newIndex]) = (steps[newIndex], steps[index]);
        for (var i = 0; i < steps.Count; i++)
            steps[i].StepOrder = i + 1;

        State.NotifyTriggersChanged();
    }

    private async Task FireManual(Trigger t)
    {
        await TriggerExec.FireManualAsync(t);
    }

    private async Task FireBulk(Trigger t)
    {
        await TriggerExec.FireBulkAsync(t);
    }

    private async Task RunScenario(string scenario)
    {
        var steps = BuildScenarioStepList(SnapshotTriggersList(), scenario);

        if (steps.Count == 0)
        {
            Snackbar.Add($"실행할 step이 없습니다: {scenario}", Severity.Warning);
            return;
        }

        foreach (var step in steps)
        {
            if (step.Type == TriggerType.Bulk)
                await TriggerExec.FireBulkAsync(step);
            else
                await TriggerExec.FireManualAsync(step);
        }

        Snackbar.Add($"Scenario 실행 완료: {scenario} ({steps.Count} step)", Severity.Success);
    }

    private void StartScenarioAutomation(string scenario)
    {
        var steps = BuildScenarioStepList(SnapshotTriggersList(), scenario);
        if (steps.Count == 0)
            return;

        foreach (var step in steps)
            step.Enabled = true;

        State.NotifyTriggersChanged();
        Snackbar.Add($"자동 단계 시작: {scenario}", Severity.Success);
    }

    private void StopScenarioAutomation(string scenario)
    {
        var steps = BuildScenarioStepList(SnapshotTriggersList(), scenario);
        if (steps.Count == 0)
            return;

        foreach (var step in steps)
            step.Enabled = false;

        State.NotifyTriggersChanged();
        Snackbar.Add($"자동화 중지: {scenario}", Severity.Info);
    }

    private async Task StartScenarioWorkflow(string scenario)
    {
        await RunScenario(scenario);
        StartScenarioAutomation(scenario);
    }

