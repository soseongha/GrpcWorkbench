    private string CreateScenarioName()
    {
        var existing = BuildScenarioGroups(State.SnapshotTriggers())
            .Select(group => group.Name)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        var index = 1;
        while (existing.Contains($"시나리오 {index}"))
            index++;

        return $"시나리오 {index}";
    }

