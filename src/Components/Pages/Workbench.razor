    private void AddScenarioStep(string scenario)
    {
        var triggers = SnapshotTriggersList();
        ClearTriggerEditing(triggers);

        var steps = BuildScenarioStepList(triggers, scenario);

        var last = steps.LastOrDefault();
        var targetService = ResolvePreferredTriggerService(last?.TargetService ?? State.ActiveStreamServiceName ?? _selectedService?.ServiceName);
        var targetMethod = ResolvePreferredTriggerMethod(targetService, last?.TargetMethod ?? State.ActiveStreamMethodName ?? _selectedMethod?.MethodName);

        var trigger = new Trigger
        {
            Name = $"{scenario}-step-{(last?.StepOrder ?? 0) + 1}",
            Scenario = NormalizeScenarioName(scenario),
            StepOrder = (last?.StepOrder ?? 0) + 1,
            Type = last?.Type ?? TriggerType.Periodic,
            BulkCount = last?.BulkCount ?? 10,
            BulkParallel = last?.BulkParallel ?? false,
            IntervalMs = last?.IntervalMs ?? 1000,
            MatchService = last?.MatchService ?? "",
            MatchMethod = last?.MatchMethod ?? "",
            MatchJsonPath = last?.MatchJsonPath ?? "",
            MatchOperator = last?.MatchOperator ?? IncomingMatchOperator.Equals,
            MatchValue = last?.MatchValue ?? "",
            TargetService = targetService,
            TargetMethod = targetMethod,
            LocalStreamMode = last?.LocalStreamMode ?? TriggerLocalStreamMode.Auto,
            InboundTargetCallId = last?.InboundTargetCallId ?? string.Empty,
            PayloadTemplate = last?.PayloadTemplate ?? "{}",
            Editing = true
        };
        State.AddTrigger(trigger);
        _triggersExpanded = true;
        _editingTrigger = trigger;
        InitializeTriggerPayloadEditor(trigger, overwritePayloadWhenEmpty: true);
    }

    private void OnTriggerTargetServiceChanged(Trigger t, string serviceName)
    {
        t.TargetService = serviceName;
        t.TargetMethod = ResolvePreferredTriggerMethod(serviceName, null);
        InitializeTriggerPayloadEditor(t, overwritePayloadWhenEmpty: true);
        State.NotifyTriggersChanged();
    }

    private void OnTriggerTargetMethodChanged(Trigger t, string method)
    {
        t.TargetMethod = method;
        t.LocalStreamMode = TriggerLocalStreamMode.Auto;
        InitializeTriggerPayloadEditor(t, overwritePayloadWhenEmpty: true);
        State.NotifyTriggersChanged();
