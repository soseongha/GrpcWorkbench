    private OutboundPanelState BuildOutboundPanelState(IReadOnlyList<OutboundMessageEntry> outbound)
    {
        var outboundList = outbound.ToList();
        var aggregates = BuildOutboundAggregates(outboundList);
        var selectedAggregate = ResolveSelectedOutboundAggregate(aggregates);
        var selectedEntries = selectedAggregate?.Entries
            .OrderByDescending(entry => entry.Time)
            .ToList() ?? [];
        var entryIndexes = selectedEntries
            .Select((entry, index) => new { entry.Id, DisplayIndex = index + 1 })
            .ToDictionary(item => item.Id, item => item.DisplayIndex, StringComparer.Ordinal);
        var selectedEntry = ResolveSelectedOutboundEntry(selectedEntries);

        return new OutboundPanelState(outboundList, aggregates, selectedAggregate, selectedEntries, entryIndexes, selectedEntry);
    }

    private List<OutboundAggregateVm> BuildOutboundAggregates(IReadOnlyList<OutboundMessageEntry> outbound)
        => outbound
            .GroupBy(item => $"{item.Service}.{item.Method}", StringComparer.Ordinal)
            .Select(group => new OutboundAggregateVm(
                group.Key,
                group.First().Service,
                group.First().Method,
                group.Count(),
                group.Max(item => item.Time),
                group.Select(item => item.Source).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(source => source).ToList(),
                group.OrderByDescending(item => item.Time).ToList()))
            .OrderByDescending(group => group.LastSentAt)
            .ThenBy(group => group.Key)
            .ToList();

