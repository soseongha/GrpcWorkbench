    {
        if (t.Type == TriggerType.OnIncoming)
        {
            var rpc = $"{(string.IsNullOrEmpty(t.MatchService) ? "*" : t.MatchService)}.{(string.IsNullOrEmpty(t.MatchMethod) ? "*" : t.MatchMethod)}";
            if (string.IsNullOrWhiteSpace(t.MatchJsonPath) || string.IsNullOrWhiteSpace(t.MatchValue))
                return rpc;
            return $"{rpc}\n{t.MatchJsonPath} {IncomingMatchOperatorLabel(t.MatchOperator)} {t.MatchValue}";
        }

        if (t.Type == TriggerType.Periodic)
            return $"매 {t.IntervalMs}ms";

        return $"{t.BulkCount}건 {(t.BulkParallel ? "병렬" : "순차")}";
    }

    private static string RpcExecutionLabel(string? rpcType) => rpcType switch
    {
        "Unary" => "단일 요청/응답",
        "ServerStreaming" => "서버 스트리밍 수신",
        "ClientStreaming" => "클라이언트 스트리밍",
        "BidirectionalStreaming" => "양방향 스트리밍",
        _ => "호출 방식 미확인"
    };

    private static string ScenarioTargetLabel(Trigger t)
        => string.IsNullOrWhiteSpace(t.InboundTargetCallId)
            ? string.IsNullOrEmpty(t.TargetService)
                ? "(미설정)"
                : t.TargetService.Split('.').Last() + "." + t.TargetMethod
            : $"열린 스트림 · {t.InboundTargetCallId[..Math.Min(8, t.InboundTargetCallId.Length)]}";

    private async Task ExportIncomingSnapshot()
    {
        var visibleCalls = VisibleIncomingCalls()
            .OrderByDescending(c => c.LastActivityAt)
            .ThenByDescending(c => c.StartedAt)
            .ToList();

        if (visibleCalls.Count == 0)
        {
            Snackbar.Add("내보낼 Incoming 데이터가 없어요.", Severity.Warning);
            return;
        }

        var aggregates = visibleCalls
            .GroupBy(call => new { call.Service, call.Method, call.Type })
            .OrderByDescending(group => group.Max(call => call.LastActivityAt))
            .ToList();
        var frameSnapshots = visibleCalls.ToDictionary(call => call.CallId, call => State.SnapshotFrames(call).ToList(), StringComparer.Ordinal);

        var payload = new IncomingExportFile
        {
            Version = 1,
            ExportedAt = DateTimeOffset.Now,
            Aggregates = aggregates.Select(group => new IncomingExportAggregate
            {
                Service = group.Key.Service,
                Method = group.Key.Method,
                Type = group.Key.Type,
                TotalCalls = group.Count(),
                TotalFrames = group.Sum(call => frameSnapshots[call.CallId].Count),
                ActiveCalls = group.Count(call => string.IsNullOrEmpty(call.Result)),
                LastSeenAt = group.Max(call => call.LastActivityAt),
                RecentCalls = group
                    .OrderByDescending(c => c.StartedAt)
                    .Select(c => new IncomingExportCall
                    {
                        CallId = c.CallId,
                        StartedAt = c.StartedAt,
                        LastActivityAt = c.LastActivityAt,
                        EndedAt = c.EndedAt,
                        Result = c.Result,
                        Frames = frameSnapshots[c.CallId]
                    })
                    .ToList()
            }).ToList()
        };

        var json = JsonSerializer.Serialize(payload, new JsonSerializerOptions { WriteIndented = true });
        await JS.InvokeVoidAsync("workbench.downloadText", $"incoming-{DateTime.Now:yyyyMMdd-HHmmss}.json", json, "application/json");
        Snackbar.Add($"Incoming 스냅샷 저장 완료: {payload.Aggregates.Count} rpc", Severity.Success);
    }

    private void TrimIncomingSnapshot()
    {
        var removed = State.TrimIncomingAggregates(32);
        Snackbar.Add(removed > 0
            ? $"Idle Incoming RPC {removed}건 정리 완료"
            : "정리할 idle Incoming RPC가 없어요.",
            removed > 0 ? Severity.Success : Severity.Info);
    }

    private async Task ExportOutboundSnapshot()
    {
        var outbound = VisibleOutboundMessages();
        if (outbound.Count == 0)
        {
            Snackbar.Add("내보낼 Outbound 이력이 없어요.", Severity.Warning);
            return;
        }

        var payload = new OutboundExportFile
        {
            Version = 1,
            ExportedAt = DateTimeOffset.Now,
            Messages = outbound
        };

        var json = JsonSerializer.Serialize(payload, new JsonSerializerOptions { WriteIndented = true });
        await JS.InvokeVoidAsync("workbench.downloadText", $"outbound-{DateTime.Now:yyyyMMdd-HHmmss}.json", json, "application/json");
        Snackbar.Add($"Outbound 이력 저장 완료: {outbound.Count}건", Severity.Success);
    }

    private void TrimOutboundSnapshot()
    {
        var removed = State.TrimOutbound(500);
        Snackbar.Add(removed > 0
            ? $"Outbound 오래된 이력 {removed}건 정리 완료"
            : "정리할 Outbound 이력이 없어요.",
            removed > 0 ? Severity.Success : Severity.Info);
    }

    private async Task ExportAllScenarios()
    {
        var triggers = SnapshotTriggersList()
            .Where(t => !string.IsNullOrWhiteSpace(t.Scenario))
            .OrderBy(t => t.Scenario, StringComparer.OrdinalIgnoreCase)
            .ThenBy(t => t.StepOrder)
            .ThenBy(t => t.Name)
            .ToList();

        await ExportScenarioSet("grpc-scenarios-all", triggers);
    }

    private async Task ExportScenarioSet(string fileStem, List<Trigger> triggers)
    {
        if (triggers.Count == 0)
        {
            Snackbar.Add("내보낼 시나리오가 없어요.", Severity.Warning);
            return;
        }

        var payload = new ScenarioExportFile
        {
            Version = 1,
            ExportedAt = DateTimeOffset.Now,
            Triggers = triggers.Select(ToScenarioExportItem).ToList()
        };

        var json = JsonSerializer.Serialize(payload, new JsonSerializerOptions { WriteIndented = true });
        await JS.InvokeVoidAsync("workbench.downloadText", $"{fileStem}.json", json, "application/json");
        Snackbar.Add($"gRPC 시나리오 저장 완료: {triggers.Count} step", Severity.Success);
    }

    private async Task ImportScenarioJson(IBrowserFile file)
    {
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            var payload = JsonSerializer.Deserialize<ScenarioExportFile>(json);
            if (payload?.Triggers == null || payload.Triggers.Count == 0)
            {
                Snackbar.Add("불러올 gRPC 시나리오 단계가 없어요.", Severity.Warning);
                return;
            }

            foreach (var existing in State.SnapshotTriggers()) existing.Editing = false;

            foreach (var item in payload.Triggers)
            {
                State.AddTrigger(new Trigger
                {
                    Name = item.Name,
                    Scenario = NormalizeScenarioName(item.Scenario),
                    StepOrder = Math.Max(1, item.StepOrder),
                    Type = item.Type,
                    Enabled = false,
                    TargetService = item.TargetService,
                    TargetMethod = item.TargetMethod,
                    LocalStreamMode = item.LocalStreamMode ?? (item.UseOpenStreamTarget ? TriggerLocalStreamMode.RequireCompatibleOpen : TriggerLocalStreamMode.Auto),
                    InboundTargetCallId = item.InboundTargetCallId ?? string.Empty,
                    PayloadTemplate = string.IsNullOrWhiteSpace(item.PayloadTemplate) ? "{}" : item.PayloadTemplate,
                    IntervalMs = Math.Max(10, item.IntervalMs),
                    MaxFires = item.MaxFires,
                    BulkCount = Math.Max(1, item.BulkCount),
                    BulkParallel = item.BulkParallel,
                    MatchService = item.MatchService ?? string.Empty,
                    MatchMethod = item.MatchMethod ?? string.Empty,
                    MatchJsonPath = item.MatchJsonPath ?? string.Empty,
                    MatchOperator = item.MatchOperator,
                    MatchValue = item.MatchValue ?? string.Empty,
                    Editing = false
                });
            }

            _triggersExpanded = true;
            Snackbar.Add($"gRPC 시나리오 불러오기 완료: {payload.Triggers.Count} step 추가", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"gRPC 시나리오 불러오기 실패: {ex.Message}", Severity.Error);
        }
    }

    private static ScenarioExportItem ToScenarioExportItem(Trigger t) => new()
    {
        Name = t.Name,
        Scenario = NormalizeScenarioName(t.Scenario),
        StepOrder = t.StepOrder,
        Type = t.Type,
        Enabled = t.Enabled,
        TargetService = t.TargetService,
        TargetMethod = t.TargetMethod,
        LocalStreamMode = t.LocalStreamMode,
        UseOpenStreamTarget = t.LocalStreamMode == TriggerLocalStreamMode.RequireCompatibleOpen,
        InboundTargetCallId = t.InboundTargetCallId,
        PayloadTemplate = t.PayloadTemplate,
        IntervalMs = t.IntervalMs,
        MaxFires = t.MaxFires,
        BulkCount = t.BulkCount,
        BulkParallel = t.BulkParallel,
        MatchService = t.MatchService,
        MatchMethod = t.MatchMethod,
        MatchJsonPath = t.MatchJsonPath,
        MatchOperator = t.MatchOperator,
        MatchValue = t.MatchValue
    };

    private static string SanitizeFileName(string value)
    {
        var invalid = Path.GetInvalidFileNameChars();
        var cleaned = new string(value.Select(ch => invalid.Contains(ch) ? '-' : ch).ToArray()).Trim();
        return string.IsNullOrWhiteSpace(cleaned) ? "scenario" : cleaned;
    }

