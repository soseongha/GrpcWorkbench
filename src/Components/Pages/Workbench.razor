    private IncomingPanelState BuildIncomingPanelState(IReadOnlyList<IncomingCallVm> visibleIncomingCalls)
    {
        var calls = visibleIncomingCalls
            .OrderByDescending(c => c.LastActivityAt)
            .ThenByDescending(c => c.StartedAt)
            .ToList();
        var frameCounts = calls.ToDictionary(call => call.CallId, call => State.SnapshotFrames(call).Count, StringComparer.Ordinal);
        var selectedCall = ResolveSelectedIncomingCall(calls);
        var selectedFrames = selectedCall == null
            ? []
            : State.SnapshotFrames(selectedCall);
        var selectedFrame = selectedCall == null
            ? null
            : ResolveSelectedIncomingFrame(selectedFrames);

        return new IncomingPanelState(
            calls,
            frameCounts,
            selectedCall,
            selectedFrames,
            selectedFrames.OrderByDescending(frame => frame.Index).ToList(),
            selectedFrame);
    }

