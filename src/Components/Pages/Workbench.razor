    private void ApplyDefaultSocketPath(bool force = false)
    {
        if (string.IsNullOrWhiteSpace(_mySocketPath) || _mySocketPath == "(설정 없음)")
            return;

        var usesLegacyWorkbenchSocket = string.Equals(
            _socketPath,
            "/var/run/asap/grpc.sock",
            StringComparison.Ordinal);

        if (force
            || string.IsNullOrWhiteSpace(_socketPath)
            || usesLegacyWorkbenchSocket
            || string.Equals(_socketPath, PeerSocketPath, StringComparison.Ordinal)
            || string.Equals(_socketPath, "로딩 중...", StringComparison.Ordinal))
        {
            _socketPath = _mySocketPath;
        }
    }

