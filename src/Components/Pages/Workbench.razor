        State.SetSelected(null, null);
        Ui.SetConnection(false, null);
        Ui.SetWorkspace(FormatDdsSessionTabLabel(session), FormatDdsSessionTabNote(session));
        await InvokeAsync(StateHasChanged);
    }

    private async Task CloseDdsSession(string sessionId)
    {
        await DdsSessions.DeleteAsync(sessionId);
        RefreshDdsSessionTabs();
        if (_activeDdsSession?.SessionId == sessionId)
        {
            _activeDdsSession = null;
            await ActivatePreferredFallbackTab();
            return;
        }
        await InvokeAsync(StateHasChanged);
    }

