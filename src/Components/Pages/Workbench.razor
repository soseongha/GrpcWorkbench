                                <MudSelect T="string" Value="@TriggerSelectedLocalStreamValue(editor)"
                                           ValueChanged="@((string v) => OnTriggerOpenLocalStreamSelected(editor, v))"
                                           Label="열린 로컬 스트림 선택" Margin="Margin.Dense" Variant="Variant.Outlined"
                                           Class="wb-select wb-select--ellipsis"
                                           Disabled="@(compatibleOpenLocalStreams.Count == 0)">
                                    <MudSelectItem T="string" Value="@NoLocalStreamValue">선택 안 함</MudSelectItem>
                                    @foreach (var stream in compatibleOpenLocalStreams)
                                    {
                                        <MudSelectItem T="string" Value="@stream.StreamId">@FormatOpenLocalStreamLabel(stream)</MudSelectItem>
                                    }
                                </MudSelect>
