        => _session != null && _selectedMethod?.RpcType is "ClientStreaming" or "BidirectionalStreaming";

    private string SelectedStreamMethodNote()
    {
        if (_selectedMethod == null)
            return "서비스와 메서드를 고르면 이 세션에서 로컬 스트림을 미리 열 수 있어요.";

        return _selectedMethod.RpcType switch
        {
            "ClientStreaming" or "BidirectionalStreaming" => "스트림을 열어 두면 이 세션의 트리거, 시나리오, 수동 1회 발사에서 골라 다시 쓸 수 있어요.",
            _ => "이 메서드는 스트리밍 RPC가 아니라 미리 열린 로컬 스트림 대상으로는 쓸 수 없어요."
        };
