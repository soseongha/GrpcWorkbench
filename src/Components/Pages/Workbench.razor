                                       Class="wb-select wb-select--ellipsis"
                                       Disabled="@(!TriggerUsesStreamingRpc(editor) || !string.IsNullOrWhiteSpace(editor.InboundTargetCallId))">
                                <MudSelectItem T="TriggerLocalStreamMode" Value="@TriggerLocalStreamMode.Auto">호환되면 열린 로컬 스트림 재사용, 아니면 자동 개폐</MudSelectItem>
                                <MudSelectItem T="TriggerLocalStreamMode" Value="@TriggerLocalStreamMode.RequireCompatibleOpen">현재 열린 호환 로컬 스트림만 사용</MudSelectItem>
                                <MudSelectItem T="TriggerLocalStreamMode" Value="@TriggerLocalStreamMode.AlwaysOpenNew">발사마다 새 로컬 스트림 열기</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <div class="d-flex align-center" style="min-height:56px;gap:8px;">
                                <span class="wb-inline-note">로컬 스트림 정책</span>
                                <MudTooltip Text="@TriggerLocalStreamPolicyNote(editor)">
                                    <MudIcon Icon="@Icons.Material.Outlined.HelpOutline" Size="Size.Small" Style="cursor:help;color:var(--mud-palette-text-secondary);" />
                                </MudTooltip>
                            </div>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="string" Value="@TriggerInboundTargetValue(editor)"
                                       ValueChanged="@((string v) => OnTriggerInboundTargetChanged(editor, v))"
                                       Label="열린 inbound 스트림 대상" Margin="Margin.Dense" Variant="Variant.Outlined"
                                       Class="wb-select wb-select--ellipsis"
                                       Disabled="@(TriggerUsesStreamingRpc(editor) && editor.LocalStreamMode == TriggerLocalStreamMode.RequireCompatibleOpen)">
                                <MudSelectItem T="string" Value="@NoInboundTargetValue">사용 안 함</MudSelectItem>
                                @foreach (var target in editorAvailableInboundTargets)
                                {
                                    <MudSelectItem T="string" Value="@target.CallId">@FormatInboundTargetLabel(target)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            @if (TriggerUsesStreamingRpc(editor))
                            {
                                <div class="d-flex align-center" style="margin-top:4px;min-height:56px;gap:8px;">
                                    <span class="wb-inline-note">열린 로컬 스트림 재사용 방식</span>
                                    <MudTooltip Text="트리거는 아래에서 열린 로컬 스트림을 골라 재사용하거나, 설정된 로컬 스트림 기준에 따라 발사 시 자동으로 열어요.">
                                        <MudIcon Icon="@Icons.Material.Outlined.HelpOutline" Size="Size.Small" Style="cursor:help;color:var(--mud-palette-text-secondary);" />
                                    </MudTooltip>
                                </div>
