    private async Task OnActiveSessionChanged(string? sessionId)
    {
        if (string.IsNullOrWhiteSpace(sessionId) || string.Equals(sessionId, _activeSessionId, StringComparison.Ordinal))
            return;

        await ActivateSessionTab(sessionId);
    }

    private void ResetTriggerEditor()
    {
        if (_editingTrigger != null)
            _editingTrigger.Editing = false;

        _editingTrigger = null;
        _triggerSchemaFields = [];
        _triggerRawJsonMode = true;
    }

    private async Task ActivateSessionTab(string sessionId)
    {
        var session = SessionService.GetSession(sessionId);
        RefreshSessionTabs();
        if (session == null)
        {
            if (_sessionTabs.Count == 0)
            {
                _activeSessionId = null;
                _activeTabKind = WorkbenchTabKind.None;
                ResetTriggerEditor();
                State.SetSession(null);
                State.SetSelected(null, null);
                Ui.SetConnection(false, null);
                await ActivatePreferredFallbackTab();
            }
            return;
        }

        if (_activeSessionId != session.SessionId)
            ResetTriggerEditor();

        _activeTabKind = WorkbenchTabKind.GrpcSession;
        _activeSessionId = session.SessionId;
        _activeDdsSession = null;
        State.SetSession(session);
        State.SetServices(session.Services);
        _loadedProtoFileName = session.ProtoFileName;
        State.SetSelected(null, null);
        _socketPath = session.UnixSocketPath ?? _socketPath;
        Ui.SetConnection(true, session.UnixSocketPath);
        Ui.SetWorkspace(FormatSessionTabLabel(session), "gRPC 세션");
        RefreshSelectedLocalStream();
        await SaveToLocalStorage();
    }

    private async Task CloseSessionTab(string sessionId)
    {
        var session = SessionService.GetSession(sessionId);
        if (session == null)
        {
            RefreshSessionTabs();
            await InvokeAsync(StateHasChanged);
            return;
        }

        await CloseLocalStreamsForSession(session.SessionId);
        ChannelProvider.ReleaseChannel(session);
        SessionService.DeleteSession(session.SessionId);
        Log($"세션 연결 해제: {session.SessionId[..8]}", LogLevel.Warn);
        RefreshSessionTabs();

        if (_session?.SessionId == sessionId)
        {
            ResetTriggerEditor();
            if (_sessionTabs.Count == 0)
            {
                _activeSessionId = null;
                Ui.SetConnection(false, null);
                State.SetSession(null);
                State.SetSelected(null, null);
                _activeTabKind = WorkbenchTabKind.None;
                await ActivatePreferredFallbackTab();
            }
            else
            {
                await ActivateSessionTab(_sessionTabs[0].SessionId);
            }
        }
        else
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ConnectSession()
    {
        if (string.IsNullOrWhiteSpace(_socketPath))
        {
            Snackbar.Add("소켓 경로를 입력하세요.", Severity.Warning);
            return;
        }

        _connecting = true;
        try
        {
            var session = SessionService.CreateSession(_socketPath, _newGrpcSessionName);
            RefreshSessionTabs();
            await ActivateSessionTab(session.SessionId);
            Log($"세션 연결: {session.SessionId[..8]} / {_socketPath}", LogLevel.Success);
            _newGrpcSessionName = string.Empty;
            await SaveToLocalStorage();
            await UploadDefaultProto();
        }
        catch (Exception ex)
        {
            Log($"세션 연결 실패: {ex.Message}", LogLevel.Error);
            Snackbar.Add($"연결 실패: {ex.Message}", Severity.Error);
        }
        finally
        {
            _connecting = false;
        }
    }

    private async Task UploadDefaultProto()
    {
        try
        {
            var protoBytes = await ReadDefaultProtoBytesAsync();
            var services = await ProtoLoader.LoadProtoServicesAsync(protoBytes);
            State.SetServices(services);
            _loadedProtoFileName = "grpc/DDSSim.proto";
            Notify.RegisterServices(services);
            await SessionService.UpdateSessionProtoAsync(_session!.SessionId, protoBytes, "grpc/DDSSim.proto");
            _session.Services = services;
            _ = Task.Run(() => ProtoCompiler.CompileProtoToAssemblyAsync(protoBytes));
            Log($"grpc/DDSSim.proto 로드: {services.Count}개 서비스 (컴파일 warm-up)", LogLevel.Success);
        }
        catch (Exception ex)
        {
            Log($"grpc/DDSSim.proto 로드 실패: {ex.Message}", LogLevel.Error);
        }
    }

    // ── Proto 파일 업로드 ─────────────────────────────────────────────────────
    private async Task OnProtoFileSelected(IBrowserFile file)
    {
        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
            var bytes = ms.ToArray();
            var services = await ProtoLoader.LoadProtoServicesAsync(bytes);
            State.SetServices(services);
            _loadedProtoFileName = file.Name;
            Notify.RegisterServices(services);
            if (_session != null)
            {
                await SessionService.UpdateSessionProtoAsync(_session.SessionId, bytes, file.Name);
                _session.Services = services;
            }
            State.SetSelected(null, null);
            _ = Task.Run(() => ProtoCompiler.CompileProtoToAssemblyAsync(bytes));
            Log($"{file.Name} 로드: {services.Count}개 서비스", LogLevel.Success);
            Snackbar.Add($"{file.Name} 로드 완료", Severity.Success);
        }
        catch (Exception ex)
        {
            Log($"파일 로드 실패: {ex.Message}", LogLevel.Error);
            Snackbar.Add($"파일 로드 실패: {ex.Message}", Severity.Error);
        }
    }

    // ── Bidi / Client Streaming ───────────────────────────────────────────────
    private async Task StartStream()
    {
        if (_session == null || _selectedMethod == null) return;
        var serviceName = _selectedService?.ServiceName;
        var methodName = _selectedMethod.MethodName;
        var rpcType = _selectedMethod.RpcType;
        var syntheticCallId = Guid.NewGuid().ToString("N")[..12];
        if (!string.IsNullOrWhiteSpace(serviceName))
        {
            _selectedIncomingRpcKey = $"{serviceName}.{methodName}";
            _selectedIncomingCallId = syntheticCallId;
        }
        try
        {
            var streamId = await StreamingService.OpenStreamAsync(BuildPayload(), _session,
                json =>
                {
                    if (!string.IsNullOrWhiteSpace(serviceName))
                        State.AddStreamRecv(syntheticCallId, serviceName, methodName, rpcType, json, _session?.SessionId);
                    return Task.CompletedTask;
                });
            _localStreamSyntheticCallIds[streamId] = syntheticCallId;
            State.SetStream(streamId, _session.SessionId, serviceName, methodName, rpcType);
        }
        catch (Exception ex)
        {
            Log($"스트림 시작 실패: {ex.Message}", LogLevel.Error);
        }
    }

    private async Task SendStreamMessage()
    {
        if (!_streamOpen || _streamId == null) return;
        try
        {
            await StreamingService.WriteMessageAsync(_streamId, _requestJson);
            State.IncrementSent();
            if (_selectedService != null && _selectedMethod != null)
                State.AddOutbound(_selectedService.ServiceName, _selectedMethod.MethodName, _requestJson, "stream", _session?.SessionId);
        }
        catch (Exception ex)
        {
            RefreshSelectedLocalStream();
            Log($"전송 실패: {ex.Message}", LogLevel.Error);
        }
    }

    private GrpcRequestPayload BuildPayload() => BuildPayload(_selectedService!.ServiceName, _selectedMethod!.MethodName, _requestJson);

    private GrpcRequestPayload BuildPayload(string serviceName, string methodName, string requestJson) => new()
    {
        SessionId = _session!.SessionId,
        ServiceName = serviceName,
        MethodName = methodName,
        RequestJson = requestJson,
        TimeoutSeconds = _timeoutSeconds
    };

    // ── 스키마 폼 ──────────────────────────────────────────────────────────────
    private void OnMethodSelected(MethodMetadata? method)
    {
        State.SetSelected(_selectedService?.ServiceName, method?.MethodName);
        _schemaFields = ParseSchemaFields(method?.InputSchema);
        _rawJsonMode = _schemaFields.Count == 0;
        if (_schemaFields.Count > 0)
            BuildJsonFromForm();
        else
            _requestJson = "{}";
        _ = SaveToLocalStorage();
    }

    private MethodMetadata? ResolveTriggerMethod(Trigger t)
        => _services.FirstOrDefault(s => s.ServiceName == t.TargetService)?.Methods.FirstOrDefault(m => m.MethodName == t.TargetMethod);

    private void InitializeTriggerPayloadEditor(Trigger t, bool overwritePayloadWhenEmpty = false)
    {
        var method = ResolveTriggerMethod(t);
        _triggerSchemaFields = ParseSchemaFields(method?.InputSchema);
        _triggerRawJsonMode = _triggerSchemaFields.Count == 0;

        if (_triggerSchemaFields.Count == 0)
            return;

        var populated = TryPopulateSchemaFieldsFromJson(_triggerSchemaFields, t.PayloadTemplate);
        if (!populated && (overwritePayloadWhenEmpty || string.IsNullOrWhiteSpace(t.PayloadTemplate) || t.PayloadTemplate == "{}"))
            BuildTriggerJsonFromForm();
        else if (populated)
            _triggerRawJsonMode = false;
    }

    private void OnTriggerRawModeChanged(bool raw)
    {
        _triggerRawJsonMode = raw;
        if (_editingTrigger == null || _triggerSchemaFields.Count == 0)
            return;

        if (raw)
            BuildTriggerJsonFromForm();
        else
            TryPopulateSchemaFieldsFromJson(_triggerSchemaFields, _editingTrigger.PayloadTemplate);

        StateHasChanged();
    }

    private void BuildTriggerJsonFromForm()
    {
        if (_editingTrigger == null) return;
        _editingTrigger.PayloadTemplate = JsonSerializer.Serialize(
            BuildJsonObject(_triggerSchemaFields),
            new JsonSerializerOptions { WriteIndented = true });
        State.NotifyTriggersChanged();
    }

    private List<SchemaField> ParseSchemaFields(string? schema)
    {
        if (string.IsNullOrEmpty(schema)) return [];
        try
        {
            using var doc = JsonDocument.Parse(schema);
            return ParsePropertiesElement(doc.RootElement);
        }
        catch { return []; }
    }

    private static List<SchemaField> ParsePropertiesElement(JsonElement element)
    {
        if (!element.TryGetProperty("properties", out var props)) return [];
        var fields = new List<SchemaField>();
        foreach (var prop in props.EnumerateObject())
            fields.Add(ParseFieldElement(prop.Name, prop.Value));
        return fields;
    }

    private static SchemaField ParseFieldElement(string name, JsonElement schema)
    {
        var f = new SchemaField { Name = name };

        if (schema.TryGetProperty("enum", out var enumProp))
        {
            f.Type = "enum";
            f.EnumValues = enumProp.EnumerateArray().Select(e => e.GetString() ?? "").ToArray();
            f.Value = f.EnumValues.FirstOrDefault() ?? "";
        }
        else if (schema.TryGetProperty("type", out var typeProp))
        {
            var t = typeProp.GetString() ?? "string";
            f.Type = t;

            if (t == "object")
            {
                f.Children = ParsePropertiesElement(schema);
                f.Value = "{}";
            }
            else if (t == "array")
            {
                if (schema.TryGetProperty("items", out var itemsEl))
                    f.ItemTemplate = ParseFieldElement("", itemsEl);
                // ArrayItems는 비어있음 — 사용자가 UI에서 항목 추가
            }
            else
            {
                f.Value = t switch
                {
                    "integer" or "number" => "0",
                    "boolean" => "",
                    _ => ""
                };
            }
        }
        return f;
    }

    private void BuildJsonFromForm()
    {
        _requestJson = JsonSerializer.Serialize(
            BuildJsonObject(_schemaFields),
            new JsonSerializerOptions { WriteIndented = true });
        _ = SaveToLocalStorage();
    }

    private static Dictionary<string, object?> BuildJsonObject(List<SchemaField> fields)
    {
        var obj = new Dictionary<string, object?>();
        foreach (var f in fields)
            obj[f.Name] = BuildFieldValue(f);
        return obj;
    }

    private static bool TryPopulateSchemaFieldsFromJson(List<SchemaField> fields, string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return false;

        try
        {
            using var doc = JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind != JsonValueKind.Object)
                return false;

            ApplyObjectToFields(fields, doc.RootElement);
            return true;
        }
        catch
        {
            return false;
        }
    }

    private static void ApplyObjectToFields(List<SchemaField> fields, JsonElement element)
    {
        foreach (var field in fields)
        {
            if (!element.TryGetProperty(field.Name, out var value))
                continue;
            ApplyJsonToField(field, value);
        }
    }

    private static void ApplyJsonToField(SchemaField field, JsonElement value)
    {
        switch (field.Type)
        {
            case "boolean":
                field.BoolValue = value.ValueKind == JsonValueKind.True || (value.ValueKind == JsonValueKind.False ? false : field.BoolValue);
                break;
            case "integer":
            case "number":
            case "string":
            case "enum":
                field.Value = value.ValueKind == JsonValueKind.String ? value.GetString() ?? string.Empty : value.ToString();
                break;
            case "object":
                if (field.Children.Count > 0 && value.ValueKind == JsonValueKind.Object)
                    ApplyObjectToFields(field.Children, value);
                else
                    field.Value = value.GetRawText();
                break;
            case "array":
                if (field.ItemTemplate != null && value.ValueKind == JsonValueKind.Array)
                {
                    field.ArrayItems.Clear();
                    var index = 0;
                    foreach (var item in value.EnumerateArray())
                    {
                        var clone = field.ItemTemplate.DeepClone(index.ToString());
                        ApplyJsonToField(clone, item);
                        field.ArrayItems.Add(clone);
                        index++;
                    }
                }
                else
                {
                    field.Value = value.GetRawText();
                }
                break;
            default:
                field.Value = value.ToString();
                break;
        }
    }

    private static object? BuildFieldValue(SchemaField f) => f.Type switch
    {
        "boolean" => f.BoolValue,
        "integer" => long.TryParse(f.Value, out var l) ? l : 0L,
        "number"  => double.TryParse(f.Value, System.Globalization.NumberStyles.Any,
                         System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : 0.0,
        "object" when f.Children.Count > 0 => BuildJsonObject(f.Children),
        "object"  => TryParseRaw(f.Value),
        "array" when f.ItemTemplate != null => f.ArrayItems.Select(BuildFieldValue).ToArray(),
        "array"   => TryParseRaw(f.Value),
        _         => (object?)f.Value
    };

    private static object? TryParseRaw(string value)
    {
        try
        {
            using var doc = JsonDocument.Parse(value);
            return doc.RootElement.Clone();
        }
        catch { return value; }
    }

    // 렌더되는 프레임만 지연 포맷 (스로틀+접힘 기본이라 비용 제한적)
    private static string Pretty(string json)
    {
        try
        {
            using var doc = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(doc.RootElement,
                new JsonSerializerOptions { WriteIndented = true });
        }
        catch { return json; }
    }

    private static string Fmt(string data, bool pretty) => pretty ? Pretty(data) : data;

    private static string Summary(string data)
    {
        var s = data.Replace('\n', ' ').Replace('\r', ' ').Trim();
        return s.Length > 90 ? s[..90] + "…" : s;
    }

