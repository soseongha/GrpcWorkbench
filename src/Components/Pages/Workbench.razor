    private async Task CloseNatsSession(string sessionId)
    {
        var wasActive = _activeNatsSession?.SessionId == sessionId;
        var deleteTask = NatsSessions.DeleteAsync(sessionId);
        RefreshNatsSessionTabs();
        if (wasActive)
        {
            _activeNatsSession = null;
            await ActivatePreferredFallbackTab();
        }
        else
        {
            await InvokeAsync(StateHasChanged);
        }

        try
        {
            await deleteTask;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"NATS 세션 정리 중 오류가 발생했습니다: {ex.Message}", Severity.Warning);
        }
    }

    private string FormatSessionTabLabel(GrpcSession session)
    {
        var shortId = session.SessionId[..4];
        if (!string.IsNullOrWhiteSpace(session.DisplayName))
            return AppendTabIdentity(session.DisplayName.Trim(), shortId);

        var path = session.UnixSocketPath?.Trim();
        if (string.IsNullOrWhiteSpace(path))
            return $"세션 {shortId}";

        var normalized = path.Replace('\\', '/').TrimEnd('/');
        var last = normalized.Split('/').LastOrDefault();
        return string.IsNullOrWhiteSpace(last)
            ? $"세션 {shortId}"
            : AppendTabIdentity(last, shortId);
    }

    private string FormatDdsSessionTabLabel(DdsSession session)
    {
        var baseLabel = string.IsNullOrWhiteSpace(session.Name)
            ? $"DDS d{session.Transport.DomainId}"
            : session.Name.Trim();

        return AppendTabIdentity(baseLabel, session.SessionId[..4]);
    }

    private static string FormatDdsSessionTabNote(DdsSession session)
        => $"DDS · domain {session.Transport.DomainId}";

    private string FormatNatsSessionTabLabel(NatsSession session)
    {
        var baseLabel = string.IsNullOrWhiteSpace(session.Name)
            ? "NATS"
            : session.Name.Trim();

        return AppendTabIdentity(baseLabel, session.SessionId[..4]);
    }

    private static string FormatNatsSessionTabNote(NatsSession session)
        => $"NATS · {session.Url}";

    private static string AppendTabIdentity(string label, string shortId)
        => label.Contains(shortId, StringComparison.OrdinalIgnoreCase)
            ? label
            : $"{label} · {shortId}";

    private string CurrentProtoLabel()
    {
        if (_session?.ProtoFileName is { Length: > 0 } fileName)
            return $"{fileName} · {_services.Count}개 서비스";

        if (!string.IsNullOrWhiteSpace(_loadedProtoFileName) && _services.Count > 0)
            return $"{_loadedProtoFileName} · {_services.Count}개 서비스";

        if (_services.Count > 0)
            return $"기본 DDSSim.proto · {_services.Count}개 서비스";

        return "로드된 proto 없음";
    }

    private static string ShortStreamId(string streamId)
        => streamId.Length <= 8 ? streamId : streamId[..8];

    private static string ShortSessionId(string? sessionId)
        => string.IsNullOrWhiteSpace(sessionId)
            ? "--------"
            : sessionId.Length <= 8 ? sessionId : sessionId[..8];

    private static string FormatOpenedAt(DateTime openedAt)
        => openedAt.ToLocalTime().ToString("HH:mm:ss");

    private string ResolvePreferredTriggerService(string? preferredService)
    {
        if (!string.IsNullOrWhiteSpace(preferredService) && _services.Any(s => s.ServiceName == preferredService))
            return preferredService;

        return _services.FirstOrDefault()?.ServiceName ?? string.Empty;
    }

    private string ResolvePreferredTriggerMethod(string serviceName, string? preferredMethod)
    {
        var service = _services.FirstOrDefault(s => s.ServiceName == serviceName);
        if (service == null)
            return string.Empty;

        if (!string.IsNullOrWhiteSpace(preferredMethod) && service.Methods.Any(m => m.MethodName == preferredMethod))
            return preferredMethod;

        return service.Methods.FirstOrDefault()?.MethodName ?? string.Empty;
    }

    private IReadOnlyList<OpenLocalStreamInfo> OpenLocalStreamsForCurrentSession()
    {
        if (_session == null)
            return [];

        return StreamingService.SnapshotOpenStreams()
            .Where(stream => string.Equals(stream.SessionId, _session.SessionId, StringComparison.Ordinal))
            .ToList();
    }

    private void RefreshSelectedLocalStream()
    {
        if (_session == null)
        {
            State.SetStream(null);
            return;
        }

        var openStreams = OpenLocalStreamsForCurrentSession();
        var selected = openStreams.FirstOrDefault(stream => string.Equals(stream.StreamId, State.StreamId, StringComparison.Ordinal))
            ?? openStreams.FirstOrDefault();

        if (selected == null)
        {
            State.SetStream(null);
            return;
        }

        State.SetStream(selected.StreamId, selected.SessionId, selected.ServiceName, selected.MethodName, selected.RpcType);
    }

    private void SelectLocalStream(string streamId)
    {
        var selected = OpenLocalStreamsForCurrentSession()
            .FirstOrDefault(stream => string.Equals(stream.StreamId, streamId, StringComparison.Ordinal));
        if (selected == null)
            return;

        State.SetStream(selected.StreamId, selected.SessionId, selected.ServiceName, selected.MethodName, selected.RpcType);
    }

    private async Task CloseLocalStream(string streamId)
    {
        if (!StreamingService.IsStreamOpen(streamId))
        {
            _localStreamSyntheticCallIds.Remove(streamId);
            RefreshSelectedLocalStream();
            return;
        }

        var result = await StreamingService.CloseStreamAsync(streamId);
        if (_localStreamSyntheticCallIds.Remove(streamId, out var syntheticCallId))
            State.CompleteSyntheticStreamCall(syntheticCallId, result.IsSuccess ? "종료됨" : $"오류: {result.Error}");

        RefreshSelectedLocalStream();

        if (!result.IsSuccess)
            Log($"스트림 오류: {result.Error}", LogLevel.Error);
    }

    private async Task CloseLocalStreamsForSession(string sessionId)
    {
        var streamIds = StreamingService.SnapshotOpenStreams()
            .Where(stream => string.Equals(stream.SessionId, sessionId, StringComparison.Ordinal))
            .Select(stream => stream.StreamId)
            .ToList();

        foreach (var streamId in streamIds)
            await CloseLocalStream(streamId);
    }

