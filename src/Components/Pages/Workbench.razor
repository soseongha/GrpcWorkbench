        => string.IsNullOrWhiteSpace(scenario) ? DefaultScenarioName : scenario.Trim();

    private List<string> IncomingServiceOptions() => BuildIncomingServiceOptions(State.SnapshotAggregates(), _services);

    private static List<string> BuildIncomingServiceOptions(IReadOnlyList<RpcAggregate> aggregateSnapshots, IReadOnlyList<ServiceMetadata> services)
        => aggregateSnapshots
            .Select(aggregate => aggregate.Service)
            .Concat(services.Select(service => service.ServiceName))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(serviceName => serviceName, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private List<string> IncomingMethodOptions(string? serviceName)
        => ResolveIncomingMethodOptions(BuildIncomingMethodOptionsLookup(State.SnapshotAggregates(), _services), serviceName);

    private static Dictionary<string, List<string>> BuildIncomingMethodOptionsLookup(IReadOnlyList<RpcAggregate> aggregateSnapshots, IReadOnlyList<ServiceMetadata> services)
    {
        var buckets = new Dictionary<string, HashSet<string>>(StringComparer.OrdinalIgnoreCase)
        {
            [string.Empty] = new(StringComparer.OrdinalIgnoreCase)
        };

        static void AddMethod(Dictionary<string, HashSet<string>> target, string serviceName, string methodName)
        {
            if (string.IsNullOrWhiteSpace(methodName))
                return;

            if (!target.TryGetValue(serviceName, out var scoped))
            {
                scoped = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                target[serviceName] = scoped;
            }

            scoped.Add(methodName);
            target[string.Empty].Add(methodName);
        }

        foreach (var aggregate in aggregateSnapshots)
            AddMethod(buckets, aggregate.Service, aggregate.Method);

        foreach (var service in services)
        {
            foreach (var method in service.Methods)
                AddMethod(buckets, service.ServiceName, method.MethodName);
        }

        return buckets.ToDictionary(
            bucket => bucket.Key,
            bucket => bucket.Value.OrderBy(method => method, StringComparer.OrdinalIgnoreCase).ToList(),
            StringComparer.OrdinalIgnoreCase);
    }

    private static List<string> ResolveIncomingMethodOptions(IReadOnlyDictionary<string, List<string>> lookup, string? serviceName)
    {
        var key = string.IsNullOrWhiteSpace(serviceName) ? string.Empty : serviceName;
        return lookup.TryGetValue(key, out var methods)
            ? methods
            : lookup.TryGetValue(string.Empty, out var allMethods)
                ? allMethods
                : [];
    }

