                                {
                                    <div class="wb-inline-note" style="margin-top:4px;" title="지금은 호환되는 열린 로컬 스트림이 없어서 이 드롭다운이 비활성 상태입니다.">스트림 없음</div>
                                }
                            }
                        </MudItem>

                        @switch (editor.Type)
                        {
                            case TriggerType.Periodic:
                                <MudItem xs="6" sm="3">
                                    <MudNumericField @bind-Value="editor.IntervalMs" Label="간격 (ms)" Min="10" Max="3600000"
                                                     Margin="Margin.Dense" Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <MudNumericField T="int?" @bind-Value="editor.MaxFires" Label="최대 실행 횟수 (비우면 무한)"
                                                     Margin="Margin.Dense" Variant="Variant.Outlined" />
                                </MudItem>
                                break;
                            case TriggerType.Bulk:
                                <MudItem xs="6" sm="3">
                                    <MudNumericField @bind-Value="editor.BulkCount" Label="개수" Min="1" Max="10000"
                                                     Margin="Margin.Dense" Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="6" sm="3" Class="d-flex align-center">
                                    <MudCheckBox @bind-Value="editor.BulkParallel" Label="병렬 발사" Color="Color.Primary" />
                                </MudItem>
                                break;
                            case TriggerType.OnIncoming:
                                <MudItem xs="6" sm="4">
                                    <MudSelect T="string" Value="@MatchServiceValue(editor)"
                                               ValueChanged="@((string v) => OnTriggerMatchServiceChanged(editor, v))"
                                                                                         Label="수신 서비스 조건" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                                                         Class="wb-select wb-select--ellipsis">
                                        <MudSelectItem T="string" Value="@AnyMatchValue">전체 수신 서비스</MudSelectItem>
                                        @foreach (var serviceName in editorIncomingServiceOptions)
                                        {
                                            <MudSelectItem T="string" Value="@serviceName">@serviceName</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="6" sm="4">
                                    <MudSelect T="string" Value="@MatchMethodValue(editor)"
                                               ValueChanged="@((string v) => OnTriggerMatchMethodChanged(editor, v))"
                                                                                         Label="수신 메서드 조건" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                                                         Class="wb-select wb-select--ellipsis">
                                        <MudSelectItem T="string" Value="@AnyMatchValue">전체 메서드</MudSelectItem>
                                        @foreach (var methodName in ResolveIncomingMethodOptions(editorIncomingMethodLookup, editor.MatchService))
                                        {
                                            <MudSelectItem T="string" Value="@methodName">@methodName</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudTextField @bind-Value="editor.MatchJsonPath" Label="JSON Path 조건"
                                                  Placeholder="예: trackNumber 또는 header.messageId"
                                                  HelperText="비우면 필드값 조건 없음"
                                                  Margin="Margin.Dense" Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <MudSelect T="IncomingMatchOperator" Value="editor.MatchOperator"
                                               ValueChanged="@((IncomingMatchOperator v) => { editor.MatchOperator = v; State.NotifyTriggersChanged(); })"
                                               Label="비교 방식" Margin="Margin.Dense" Variant="Variant.Outlined"
                                               Class="wb-select">
                                        @foreach (var op in Enum.GetValues<IncomingMatchOperator>())
                                        {
                                            <MudSelectItem T="IncomingMatchOperator" Value="op">@IncomingMatchOperatorLabel(op)</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="9">
                                    <MudTextField @bind-Value="editor.MatchValue" Label="기대 값"
                                                  Placeholder="예: 1201 또는 hostile"
                                                  HelperText="JSON path 값과 비교합니다"
                                                  Margin="Margin.Dense" Variant="Variant.Outlined" />
                                </MudItem>
                                break;
                        }

                        <MudItem xs="12">
                            <div class="d-flex flex-wrap align-center" style="gap:8px;">
                                <div class="d-flex align-center" style="gap:6px;min-width:0;">
                                    <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary);margin:0;">
                                        Payload 편집
                                    </MudText>
                                    <MudTooltip Text="Payload는 계층 입력 또는 JSON 편집으로 구성합니다. 변수: {{counter}}, {{now}}, OnIncoming은 {{incoming.&lt;dotted.path&gt;}}">
                                        <MudIcon Icon="@Icons.Material.Outlined.HelpOutline" Size="Size.Small" Style="cursor:help;color:var(--mud-palette-text-secondary);" />
                                    </MudTooltip>
                                </div>
                                <MudSpacer />
                                @if (_triggerSchemaFields.Count > 0)
                                {
                                    <MudToggleGroup T="bool" Value="_triggerRawJsonMode" ValueChanged="OnTriggerRawModeChanged"
                                                    Color="Color.Primary" Size="Size.Small" CheckMark="false"
                                                    SelectionMode="SelectionMode.SingleSelection">
                                        <MudToggleItem Value="false" Text="계층" />
                                        <MudToggleItem Value="true" Text="JSON" />
                                    </MudToggleGroup>
                                }
                            </div>
                            @if (!_triggerRawJsonMode && _triggerSchemaFields.Count > 0)
                            {
                                <div class="wb-scroll mt-2" style="max-height:44vh;overflow-y:auto;">
                                    @foreach (var field in _triggerSchemaFields)
                                    {
                                        <div class="mb-2">
                                            <SchemaFormField Field="field" OnChanged="BuildTriggerJsonFromForm" />
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <MudTextField @bind-Value="editor.PayloadTemplate" Label="Trigger Payload"
                                              Variant="Variant.Outlined" Lines="12" FullWidth="true"
                                              Class="mt-2 wb-mono" Style="font-size:.8rem;" />
                            }
                        </MudItem>
                        <MudItem xs="12" Class="d-flex" Style="gap:8px;">
                            @if (editor.Type == TriggerType.Bulk)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.PlayCircle"
                                           OnClick="@(() => FireBulk(editor))">
                                    지금 묶음 발사
                                </MudButton>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.PlayArrow"
                                           OnClick="@(() => FireManual(editor))">
                                    지금 1회 발사
                                </MudButton>
                            }
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       OnClick="SaveTriggerEditor">
                                저장
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                       OnClick="CloseTriggerEditor">
                                닫기
                            </MudButton>
                            <MudSpacer />
                            <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Delete"
                                       OnClick="@(() => DeleteTrigger(editor))">
                                삭제
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </div>
                </div>
                }
            }
            @* end gRPC tab workspace *@
</div>

@code {
    private enum WorkbenchTabKind
    {
        None,
        Add,
        GrpcSession,
        DdsSession,
        NatsSession
    }

    private enum WorkbenchNewTabKind
    {
        GrpcSession,
        DdsSession,
        NatsSession
    }

    // ── 회로 로컬 상태 (폼/일회성 UI만; 누적 상태는 WorkbenchStateService) ──
    private const string PeerSocketPath = "/var/run/dds-ambassador-peer/grpc.sock";
    private string _mySocketPath = "로딩 중...";
    private string _socketPath = string.Empty;
    private string _newGrpcSessionName = string.Empty;
    private int _timeoutSeconds = 30;
    private bool _connecting;

    private string _requestJson = "{}";
    private string? _requestInboundCallId;

    private List<SchemaField> _schemaFields = [];
    private bool _rawJsonMode = false;
    private List<SchemaField> _triggerSchemaFields = [];
    private bool _triggerRawJsonMode = true;
    private bool _incomingExpanded = true;
    private bool _outboundExpanded = true;
    private bool _logsExpanded = false;
    private bool _triggersExpanded = true;
    private string? _selectedIncomingRpcKey;
    private string? _selectedIncomingCallId;
    private int? _selectedIncomingFrameIndex;
    private string? _selectedOutboundKey;
    private string? _selectedOutboundId;
    private string? _activeSessionId;
    private string? _loadedProtoFileName;
    private List<GrpcSession> _sessionTabs = [];
    private List<DdsSession> _ddsSessionTabs = [];
    private DdsSession? _activeDdsSession;
    private List<NatsSession> _natsSessionTabs = [];
    private NatsSession? _activeNatsSession;
    private WorkbenchTabKind _activeTabKind;
    private WorkbenchNewTabKind _newTabKind = WorkbenchNewTabKind.GrpcSession;
    private Trigger? _editingTrigger;
    private readonly Dictionary<string, string> _localStreamSyntheticCallIds = [];

    // ── 1-탭 정책 + 변경 감지 펌프 ──────────────────────────────────────────
    private Guid _clientId;
    private bool _evicted;
    private bool _disposed;
    private volatile bool _dirty;
    private PeriodicTimer? _uiTimer;
    private readonly CancellationTokenSource _cts = new();

    // ── State 래퍼 (마크업을 그대로 두기 위한 alias) ────────────────────────
    private GrpcSession? _session => State.Session;
    private List<ServiceMetadata> _services => State.Services;
    private bool _streamOpen => State.IsStreamOpen;
    private string? _streamId => State.StreamId;
    private int _sentCount => State.SentCount;

    private ServiceMetadata? _selectedService
    {
        get => State.Services.FirstOrDefault(s => s.ServiceName == State.SelectedServiceName);
        set => State.SetSelected(value?.ServiceName, null);
    }
    private MethodMetadata? _selectedMethod
        => _selectedService?.Methods.FirstOrDefault(m => m.MethodName == State.SelectedMethodName);

    // ── 헬퍼 ──────────────────────────────────────────────────────────────────
    private bool IsBidi => _selectedMethod?.RpcType == "BidirectionalStreaming";
    private bool IsClientStream => _selectedMethod?.RpcType == "ClientStreaming";

    private Color RpcTypeColor(string? type) => type switch
    {
        "Unary" => Color.Success,
        "ServerStreaming" => Color.Info,
        "ClientStreaming" => Color.Warning,
        "BidirectionalStreaming" => Color.Secondary,
        _ => Color.Default
    };

    private static string RpcCss(string? type) => type switch
    {
        "Unary" => "wb-rpc-unary",
        "ServerStreaming" => "wb-rpc-server",
        "ClientStreaming" => "wb-rpc-client",
        "BidirectionalStreaming" => "wb-rpc-bidi",
        _ => string.Empty
    };

    private void Log(string text, LogLevel level = LogLevel.Info) =>
        State.AddLog(text, level);

    private void ToggleLogsExpanded() =>
        _logsExpanded = !_logsExpanded;

    private void ClearLogs() =>
        State.ClearLogs();

    private void OnRawModeChanged(bool raw)
    {
        _rawJsonMode = raw;
        if (raw) BuildJsonFromForm();
        StateHasChanged();
    }

    // ── 생명주기 ──────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        _mySocketPath = Environment.GetEnvironmentVariable("DEFAULT_TARGET_UDS_SOCKET_PATH")
            ?? Configuration["ASAP:DefaultTargetUdsSocketPath"]
            ?? Environment.GetEnvironmentVariable("UDS_SOCKET_PATH")
            ?? Configuration["ASAP:UdsSocketPath"]
            ?? "(설정 없음)";
        ApplyDefaultSocketPath();
        RefreshSessionTabs();
        RefreshDdsSessionTabs();
        RefreshNatsSessionTabs();
        if (_sessionTabs.Count > 0)
            await ActivateSessionTab(_sessionTabs[0].SessionId);
        else if (_ddsSessionTabs.Count > 0)
            await ActivateDdsSession(_ddsSessionTabs[0].SessionId);
        else if (_natsSessionTabs.Count > 0)
            await ActivateNatsSession(_natsSessionTabs[0].SessionId);
        else
            ActivateAddTab();

        // 1-탭 정책: 이 회로가 활성 클라이언트가 됨. 이전 클라이언트(있으면) Evicted.
        _clientId = State.ClaimActive();
        State.Changed += OnStateChanged;
        State.Evicted += OnEvicted;

        // 미들웨어 알림은 State가 직접 구독함. 여기선 _dirty만 보고 최대 125Hz로 render.
        _uiTimer = new PeriodicTimer(TimeSpan.FromMilliseconds(100));
        _ = Task.Run(async () =>
        {
            try
            {
                while (await _uiTimer.WaitForNextTickAsync(_cts.Token))
                {
                    if (_dirty)
                    {
                        _dirty = false;
                        await InvokeAsync(StateHasChanged);
                    }
                }
            }
            catch (OperationCanceledException) { }
        });

        // 기본 proto는 이전 회로/시작 시 이미 로드됐을 수 있으므로 비어있을 때만.
        if (State.Services.Count == 0) await TryLoadDefaultProtoServices();
    }

    private void OnStateChanged() => _dirty = true;

    private void OnEvicted()
    {
        if (_disposed) return;
        if (State.IsActive(_clientId)) return; // 새 활성이 나면 이 핸들러는 무시
        _evicted = true;
        _ = InvokeAsync(StateHasChanged);
    }

    private Task ReclaimActive()
    {
        _clientId = State.ClaimActive();
        _evicted = false;
        return InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await RestoreFromLocalStorage();
    }

    private async Task RestoreFromLocalStorage()
    {
        try
        {
            var sp = await JS.InvokeAsync<string?>("localStorage.getItem", "wb_socketPath");
            if (!string.IsNullOrEmpty(sp))
                _socketPath = sp;

            ApplyDefaultSocketPath();

            var to = await JS.InvokeAsync<string?>("localStorage.getItem", "wb_timeout");
            if (int.TryParse(to, out var t)) _timeoutSeconds = t;

            var rj = await JS.InvokeAsync<string?>("localStorage.getItem", "wb_requestJson");
            if (!string.IsNullOrEmpty(rj)) _requestJson = rj;

            var svcName = await JS.InvokeAsync<string?>("localStorage.getItem", "wb_service");
            var mtdName = await JS.InvokeAsync<string?>("localStorage.getItem", "wb_method");
            if (!string.IsNullOrEmpty(svcName))
            {
                var svc = _services.FirstOrDefault(s => s.ServiceName == svcName);
                if (svc != null)
                {
                    _selectedService = svc;
                    if (!string.IsNullOrEmpty(mtdName))
                    {
                        var method = svc.Methods.FirstOrDefault(m => m.MethodName == mtdName);
                        if (method != null) OnMethodSelected(method);
                    }
                }
            }

            StateHasChanged();
        }
        catch { /* localStorage 접근 실패 시 무시 */ }
    }

    private async Task SaveToLocalStorage()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "wb_socketPath", _socketPath);
            await JS.InvokeVoidAsync("localStorage.setItem", "wb_timeout", _timeoutSeconds.ToString());
            await JS.InvokeVoidAsync("localStorage.setItem", "wb_requestJson", _requestJson);
            await JS.InvokeVoidAsync("localStorage.setItem", "wb_service", _selectedService?.ServiceName ?? "");
            await JS.InvokeVoidAsync("localStorage.setItem", "wb_method", _selectedMethod?.MethodName ?? "");
        }
        catch { }
    }

    private async Task TryLoadDefaultProtoServices()
    {
        try
        {
            var protoBytes = await ReadDefaultProtoBytesAsync();
            var services = await ProtoLoader.LoadProtoServicesAsync(protoBytes);
            State.SetServices(services);
            _loadedProtoFileName = "grpc/DDSSim.proto";
            Notify.RegisterServices(services);
            _ = Task.Run(() => ProtoCompiler.CompileProtoToAssemblyAsync(protoBytes));
            Log($"grpc/DDSSim.proto 파싱 완료: {services.Count}개 서비스", LogLevel.Success);
        }
        catch (Exception ex)
        {
            Log($"grpc/DDSSim.proto 파싱 실패: {ex.Message}", LogLevel.Error);
        }
    }

    private async Task<byte[]> ReadDefaultProtoBytesAsync()
    {
        var path = Path.Combine(WebHostEnv.ContentRootPath, "schema", "proto", "grpc", "DDSSim.proto");
        return await File.ReadAllBytesAsync(path);
    }

    public void Dispose()
    {
        _disposed = true;
        _cts.Cancel();
        _cts.Dispose();
        _uiTimer?.Dispose();
        State.Changed -= OnStateChanged;
        State.Evicted -= OnEvicted;
        State.Release(_clientId);
    }

