                                    <div class="wb-mono wb-type-signature" style="font-size:.72rem;line-height:1.6;">
                                        <span style="color:var(--mud-palette-text-secondary);">입력 </span>@triggerMethod.InputType<br />
                                        <span style="color:var(--mud-palette-text-secondary);">응답 </span>@triggerMethod.OutputType
