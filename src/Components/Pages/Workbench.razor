    private static string AgoLabel(DateTime at)
    {
        var d = DateTime.UtcNow - at;
        if (d.TotalSeconds < 1) return "now";
        if (d.TotalSeconds < 60) return $"{(int)d.TotalSeconds}s";
        if (d.TotalMinutes < 60) return $"{(int)d.TotalMinutes}m";
        if (d.TotalHours < 24) return $"{(int)d.TotalHours}h";
        return $"{(int)d.TotalDays}d";
    }

    private static string TriggerDestinationLabel(Trigger t)
    {
        if (!string.IsNullOrWhiteSpace(t.InboundTargetCallId))
            return $"열린 inbound 스트림 · {t.InboundTargetCallId[..Math.Min(8, t.InboundTargetCallId.Length)]}";

        if (string.IsNullOrEmpty(t.TargetService) || string.IsNullOrEmpty(t.TargetMethod))
            return "(미설정)";

        var target = t.TargetService.Split('.').Last() + "." + t.TargetMethod;
        return t.LocalStreamMode switch
        {
            TriggerLocalStreamMode.RequireCompatibleOpen => target + " · 열린 호환 로컬 스트림만",
            TriggerLocalStreamMode.AlwaysOpenNew => target + " · 매번 새 로컬 스트림",
            _ => target + " · 호환 시 재사용"
        };
    }

    private string TriggerInboundTargetValue(Trigger t)
        => string.IsNullOrWhiteSpace(t.InboundTargetCallId) ? NoInboundTargetValue : t.InboundTargetCallId;

    private List<OpenLocalStreamInfo> CompatibleOpenLocalStreamsForTrigger(Trigger t)
    {
        if (_session == null || !TriggerUsesStreamingRpc(t))
            return [];

        var rpcType = TriggerRpcType(t);
        return OpenLocalStreamsForCurrentSession()
            .Where(stream => string.Equals(stream.ServiceName, t.TargetService, StringComparison.Ordinal)
                && string.Equals(stream.MethodName, t.TargetMethod, StringComparison.Ordinal)
                && string.Equals(stream.RpcType, rpcType, StringComparison.Ordinal))
            .ToList();
    }

    private string TriggerSelectedLocalStreamValue(Trigger t)
        => CompatibleOpenLocalStreamsForTrigger(t).Any(stream => string.Equals(stream.StreamId, State.StreamId, StringComparison.Ordinal))
            ? State.StreamId ?? NoLocalStreamValue
            : NoLocalStreamValue;

    private void OnTriggerOpenLocalStreamSelected(Trigger t, string streamId)
    {
        if (streamId == NoLocalStreamValue)
        {
            RefreshSelectedLocalStream();
            return;
        }

        var selected = CompatibleOpenLocalStreamsForTrigger(t)
            .FirstOrDefault(stream => string.Equals(stream.StreamId, streamId, StringComparison.Ordinal));
        if (selected == null)
            return;

        State.SetStream(selected.StreamId, selected.SessionId, selected.ServiceName, selected.MethodName, selected.RpcType);
        if (t.LocalStreamMode == TriggerLocalStreamMode.AlwaysOpenNew)
            t.LocalStreamMode = TriggerLocalStreamMode.Auto;
        State.NotifyTriggersChanged();
    }

    private static string FormatOpenLocalStreamLabel(OpenLocalStreamInfo stream)
        => $"{stream.ServiceName.Split('.').Last()}.{stream.MethodName} · {FormatOpenedAt(stream.OpenedAt)} · {ShortStreamId(stream.StreamId)}";

    private void OnTriggerLocalStreamModeChanged(Trigger t, TriggerLocalStreamMode value)
    {
        t.LocalStreamMode = value;
        if (value == TriggerLocalStreamMode.RequireCompatibleOpen)
            t.InboundTargetCallId = string.Empty;
        State.NotifyTriggersChanged();
    }

    private void OnTriggerInboundTargetChanged(Trigger t, string value)
    {
        t.InboundTargetCallId = value == NoInboundTargetValue ? string.Empty : value;
        State.NotifyTriggersChanged();
    }

    private string? TriggerRpcType(Trigger t)
        => _services.FirstOrDefault(s => s.ServiceName == t.TargetService)?.Methods.FirstOrDefault(m => m.MethodName == t.TargetMethod)?.RpcType;

    private bool TriggerUsesStreamingRpc(Trigger t)
        => TriggerRpcType(t) is "ClientStreaming" or "BidirectionalStreaming";

    private bool TriggerMatchesCurrentOpenLocalStream(Trigger t)
        => _session != null
           && _streamOpen
           && string.Equals(State.ActiveStreamSessionId, _session.SessionId, StringComparison.Ordinal)
           && string.Equals(State.ActiveStreamServiceName, t.TargetService, StringComparison.Ordinal)
           && string.Equals(State.ActiveStreamMethodName, t.TargetMethod, StringComparison.Ordinal)
           && string.Equals(State.ActiveStreamRpcType, TriggerRpcType(t), StringComparison.Ordinal);

    private string TriggerLocalStreamPolicyNote(Trigger t)
    {
        if (!TriggerUsesStreamingRpc(t))
            return "Unary / ServerStreaming 대상에는 로컬 스트림 정책을 쓰지 않아요.";
        if (!string.IsNullOrWhiteSpace(t.InboundTargetCallId))
            return "inbound 스트림 대상을 지정하면 로컬 스트림 정책보다 inbound 응답 스트림 전송을 먼저 써요.";

        return t.LocalStreamMode switch
        {
            TriggerLocalStreamMode.RequireCompatibleOpen => TriggerMatchesCurrentOpenLocalStream(t)
                ? "현재 열린 로컬 스트림이 이 트리거 대상과 호환돼서 그 스트림에 바로 써요."
                : "같은 세션, 서비스, 메서드, RPC 타입이 모두 일치하는 열린 로컬 스트림이 필요해요.",
            TriggerLocalStreamMode.AlwaysOpenNew => "발사할 때마다 새 로컬 스트림을 열고 payload 전송 뒤 닫아요.",
            _ => TriggerMatchesCurrentOpenLocalStream(t)
                ? "현재 열린 호환 로컬 스트림이 있어서 그대로 재사용해요. 없으면 자동으로 새 스트림을 열고 닫아요."
                : "호환되는 열린 로컬 스트림이 없으면 발사 시 자동으로 새 스트림을 열고 닫아요."
        };
    }

    private const string NoInboundTargetValue = "__NO_INBOUND_TARGET__";
    private const string NoLocalStreamValue = "__NO_LOCAL_STREAM__";
}
