@using System.Text.Json
@using System.Text
@using System.Reflection
@using Microsoft.AspNetCore.Components.Forms
@using ASAP.Grpc
@using ASAP.Models.Nats
@using ASAP.Models.Session
@using ASAP.Models.Ui
@using ASAP.Nats
@using ASAP.Services
@using Google.Protobuf
@using LogLevel = ASAP.Models.Ui.LogLevel
@inject INatsSessionService NatsSessions
@inject NatsTriggerService Triggers
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IProtoLoader ProtoLoader
@inject IDynamicProtoCompiler ProtoCompiler
@inject IJsonMessageConverter JsonMessageConverter
@inject IWebHostEnvironment WebHostEnv
@inject WorkbenchStateService State
@implements IDisposable

@if (Session != null)
{
    <div class="@(Embedded ? "wb-subpanel mb-3 pa-3" : "wb-panel wb-panel--major wb-panel--contain pa-3 mb-4")">
        <div class="d-flex align-center mb-2" style="gap:8px;">
            <MudIcon Icon="@Icons.Material.Filled.PlaylistPlay" Size="Size.Small" Color="Color.Secondary" />
            <div>
                <div class="wb-panel-kicker">NATS</div>
                <div class="wb-panel-heading" title="DDSSim.proto 메시지로 수동 발행과 자동 발행을 구성합니다">시나리오</div>
            </div>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@Session.ScenarioSteps.Count 단계</MudChip>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">시나리오 @BuildScenarioGroups().Count</MudChip>
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddScenarioGroup">시나리오 추가</MudButton>
        </div>

        <div class="d-flex align-center mb-2" style="gap:8px;">
            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Download"
                       OnClick="ExportScenarioJson"
                       Disabled="@(Session.ScenarioSteps.Count == 0)">전체 내보내기</MudButton>
            <MudFileUpload T="IBrowserFile" FilesChanged="ImportScenarioJson" Accept=".json">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.UploadFile">전체 불러오기</MudButton>
                </ActivatorContent>
            </MudFileUpload>
        </div>

        @if (Session.ScenarioSteps.Count == 0)
        {
            <div class="wb-empty"><div>등록된 NATS 시나리오 단계가 없습니다<br />시나리오 추가 후 단계와 자동화를 구성하세요</div></div>
        }
        else
        {
            var scenarioGroups = BuildScenarioGroups();
            <div class="d-flex flex-wrap" style="gap:8px;">
                @foreach (var group in scenarioGroups)
                {
                    <div class="wb-panel pa-3 wb-scenario-group" style="min-width:320px;flex:1 1 520px;">
                        <div class="wb-scenario-step-top">
                            <div>
                                <div class="wb-scenario-step-order">시나리오</div>
                                <div class="wb-scenario-step-title">@group.Name</div>
                            </div>
                            <div class="wb-chip-row">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@group.OrderedSteps.Count 단계</MudChip>
                                <MudChip T="string" Size="Size.Small" Color="@(IsScenarioAutomationRunning(group.Name) ? Color.Success : Color.Default)" Variant="Variant.Text" Class="ma-0">@(IsScenarioAutomationRunning(group.Name) ? "자동화 동작 중" : "자동화 대기")</MudChip>
                            </div>
                        </div>
                        <div class="wb-scenario-step-actions mt-2">
                            <MudButton Variant="Variant.Text" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="@(() => AddScenarioStep(group.Name))">단계</MudButton>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.PlayArrow"
                                       OnClick="@(() => RunScenario(group.Name))"
                                       title="수동 단계를 순서대로 실행합니다"
                                       Disabled="@(ManualScenarioStepCountFor(group.Name) == 0 || _runningScenario)">수동</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.AutoMode"
                                       OnClick="@(() => StartAutomation(group.Name))"
                                       title="주기, 다발, 수신 반응 단계를 등록합니다"
                                       Disabled="@(AutomaticScenarioStepCountFor(group.Name) == 0 || _runningScenario || IsScenarioAutomationRunning(group.Name))">자동</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.PlayCircle"
                                       OnClick="@(() => StartScenarioWorkflow(group.Name))"
                                       title="수동 단계를 실행한 뒤 자동 단계를 시작합니다"
                                       Disabled="@((ManualScenarioStepCountFor(group.Name) == 0 && AutomaticScenarioStepCountFor(group.Name) == 0) || _runningScenario || IsScenarioAutomationRunning(group.Name))">전체</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Stop"
                                       OnClick="@(() => StopAutomation(group.Name))"
                                       Disabled="@(!IsScenarioAutomationRunning(group.Name))">중지</MudButton>
                        </div>
                        <div class="wb-scenario-list mt-2 wb-scroll" style="max-height:320px;overflow:auto;">
                            @foreach (var step in group.OrderedSteps)
                            {
                                <div class="wb-scenario-step mb-2">
                                    <div class="wb-scenario-step-top">
                                        <div>
                                            <div class="wb-scenario-step-order">@ScenarioStepModeLabel(step)</div>
                                            <div class="wb-scenario-step-title">@ScenarioStepDisplayName(step)</div>
                                        </div>
                                        <MudChip T="string" Size="Size.Small" Color="@(ScenarioStepStatusColor(step))" Variant="Variant.Text" Class="ma-0">@ScenarioStepStatusLabel(step)</MudChip>
                                    </div>
                                    <div class="wb-scenario-step-meta">
                                        <div>
                                            <span class="wb-scenario-label">대상</span>
                                            <span class="wb-scenario-value wb-mono">@step.Subject</span>
                                        </div>
                                        <div>
                                            <span class="wb-scenario-label">조건</span>
                                            <span class="wb-scenario-value wb-preline">@ScenarioStepWhenLabel(step)</span>
                                        </div>
                                    </div>
                                    <div class="wb-scenario-step-actions mt-2">
                                        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.KeyboardArrowUp" OnClick="@(() => MoveScenarioStep(step, -1))">위</MudButton>
                                        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.KeyboardArrowDown" OnClick="@(() => MoveScenarioStep(step, 1))">아래</MudButton>
                                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => EditScenarioStep(step))">편집</MudButton>
                                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Success" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="@(() => FireScenarioStep(step))">1회</MudButton>
                                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" OnClick="@(() => RemoveScenarioStep(step))">삭제</MudButton>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        @if (_editingStep != null)
        {
            var editor = _editingStep;
            <div class="wb-editor-backdrop"></div>
            <div class="wb-editor-shell">
                <div class="wb-editor-drawer wb-panel pa-4 wb-scroll">
                    <div class="wb-panel-head mb-3">
                        <div>
                            <div class="wb-panel-kicker d-flex align-center" style="gap:6px;">
                                <span>NATS 단계 편집기</span>
                                <MudTooltip Text="메시지 타입, subject, 실행 방식, payload, 자동 조건을 DDS 단계 편집기와 같은 방식으로 편집합니다.">
                                    <MudIcon Icon="@Icons.Material.Outlined.HelpOutline" Size="Size.Small" Style="cursor:help;color:var(--mud-palette-text-secondary);" />
                                </MudTooltip>
                            </div>
                            <div class="wb-panel-heading">@ScenarioStepDisplayName(editor)</div>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseScenarioStepEditor" />
                    </div>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="editor.Name" Label="이름"
                                          Placeholder="@ScenarioStepDisplayName(editor)"
                                          Margin="Margin.Dense" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            @if (_bridgeMessages.Count > 0)
                            {
                                <MudSelect T="string"
                                           Label="메시지 타입"
                                           Value="@(_selectedScenarioBridgeMessageType ?? string.Empty)"
                                           ValueChanged="OnEditingBridgeMessageTypeChanged"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Class="wb-select wb-select--comfortable wb-select--ellipsis">
                                    @foreach (var option in _bridgeMessages)
                                    {
                                        <MudSelectItem T="string" Value="@option.TypeName">@option.TypeName</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            else
                            {
                                <MudTextField @bind-Value="editor.Subject" Label="발행 subject" Placeholder="dds.sidecar.to-dds.AirThreatInformation"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                            }
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField Value="editor.Subject" Label="발행 subject" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="@editor.UseBridgeMessage" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="editor.Scenario" Label="시나리오" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="NatsStepMode" Value="editor.Mode" ValueChanged="@((NatsStepMode mode) => OnScenarioStepModeChanged(editor, mode))" Label="실행 방식"
                                       Variant="Variant.Outlined" Margin="Margin.Dense">
                                <MudSelectItem Value="NatsStepMode.Manual">수동 / 순차 실행</MudSelectItem>
                                <MudSelectItem Value="NatsStepMode.Periodic">주기 발행</MudSelectItem>
                                <MudSelectItem Value="NatsStepMode.Bulk">다발 발행</MudSelectItem>
                                <MudSelectItem Value="NatsStepMode.OnIncoming">수신 반응 발행</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <div class="wb-mode-note" title="@ScenarioStepModeGuidance(editor.Mode)">
                                @ScenarioStepModeGuidance(editor.Mode)
                            </div>
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudNumericField @bind-Value="editor.RepeatCount" Label="이 단계 발행 횟수"
                                             Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudNumericField @bind-Value="editor.DelayAfterMs" Label="다음 단계 전 대기(ms)"
                                             Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>

                        @if (editor.Mode == NatsStepMode.Periodic)
                        {
                            <MudItem xs="12" sm="6">
                                <MudNumericField @bind-Value="editor.IntervalMs" Label="주기(ms)"
                                                 Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField @bind-Value="editor.MaxFires" Label="최대 발행 수(선택)"
                                                 Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                        }
                        else if (editor.Mode == NatsStepMode.Bulk)
                        {
                            <MudItem xs="12" sm="6">
                                <MudNumericField @bind-Value="editor.BulkCount" Label="다발 개수"
                                                 Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" sm="6" Class="d-flex align-center">
                                <MudCheckBox @bind-Value="editor.BulkParallel" Label="병렬 발행" Color="Color.Warning" />
                            </MudItem>
                        }
                        else if (editor.Mode == NatsStepMode.OnIncoming)
                        {
                            <MudItem xs="12" sm="4">
                                <MudTextField @bind-Value="editor.MatchSubject" Label="매칭 source subject"
                                              Placeholder="> 또는 telemetry.*" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudNumericField @bind-Value="editor.MinFireIntervalMs" Label="최소 발행 간격(ms)"
                                                 Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudNumericField @bind-Value="editor.MaxFiresPerMinute" Label="분당 최대 발행 수"
                                                 Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudCheckBox @bind-Value="editor.BlockSelfSubjectLoop" Label="동일 source/target subject 재발행 차단" Color="Color.Warning" />
                            </MudItem>
                        }

                        <MudItem xs="12">
                            <div class="d-flex flex-wrap align-center" style="gap:8px;">
                                <div class="d-flex align-center" style="gap:6px;min-width:0;">
                                    <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary);margin:0;">Payload</MudText>
                                    <MudTooltip Text="NATS 단계 payload는 DDSSim.proto 필드 입력이나 JSON 원문으로 편집합니다.">
                                        <MudIcon Icon="@Icons.Material.Outlined.HelpOutline" Size="Size.Small" Style="cursor:help;color:var(--mud-palette-text-secondary);" />
                                    </MudTooltip>
                                </div>
                                <MudSpacer />
                                @if (_editingSchemaFields.Count > 0)
                                {
                                    <MudToggleGroup T="bool" Value="_scenarioRawJsonMode" ValueChanged="SetScenarioRawJsonMode"
                                                    Color="Color.Primary" Size="Size.Small" CheckMark="false"
                                                    SelectionMode="SelectionMode.SingleSelection">
                                        <MudToggleItem Value="false" Text="필드" />
                                        <MudToggleItem Value="true" Text="JSON" />
                                    </MudToggleGroup>
                                }
                            </div>
                            @if (!_scenarioRawJsonMode && _editingSchemaFields.Count > 0)
                            {
                                <div class="wb-scroll mt-2" style="max-height:44vh;overflow-y:auto;">
                                    @foreach (var field in _editingSchemaFields)
                                    {
                                        <div class="mb-2">
                                            <SchemaFormField Field="field" OnChanged="OnScenarioSchemaChanged" />
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <MudTextField @bind-Value="editor.PayloadText" Lines="12" Variant="Variant.Outlined"
                                              Margin="Margin.Dense" Label="메시지 Payload JSON" FullWidth="true"
                                              Class="mt-2 wb-mono" Style="font-size:.8rem;" />
                            }
                            @if (!string.IsNullOrWhiteSpace(_bridgeLoadError))
                            {
                                <div class="wb-inline-note mt-2" style="color:var(--mud-palette-warning);">@_bridgeLoadError</div>
                            }
                        </MudItem>

                        <MudItem xs="12" Class="d-flex" Style="gap:8px;">
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.PlayArrow"
                                       OnClick="@(() => FireScenarioStep(editor))">지금 1회 발행</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       OnClick="SaveScenarioStepEditor">저장</MudButton>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                       OnClick="CloseScenarioStepEditor">닫기</MudButton>
                            <MudSpacer />
                            <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Delete"
                                       OnClick="@(() => DeleteEditingScenarioStep())">삭제</MudButton>
                        </MudItem>
                    </MudGrid>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public NatsSession? Session { get; set; }
    [Parameter] public bool Embedded { get; set; }

    private bool _runningScenario;
    private NatsScenarioStep? _editingStep;
    private readonly List<BridgeMessageOption> _bridgeMessages = [];
    private readonly List<SchemaField> _editingSchemaFields = [];
    private Assembly? _bridgeSchemaAssembly;
    private string? _bridgeLoadError;
    private string? _selectedScenarioBridgeMessageType;
    private bool _scenarioRawJsonMode;

    protected override async Task OnInitializedAsync()
    {
        Triggers.Changed += OnTriggersChanged;
        await LoadBridgeMessagesAsync();
    }

    private void AddScenarioGroup()
    {
        AddScenarioStep(CreateScenarioName());
    }

    private void AddScenarioStep(string? scenario = null)
    {
        if (Session == null)
            return;

        var selectedBridge = _bridgeMessages.FirstOrDefault();
        var step = new NatsScenarioStep
        {
            Scenario = string.IsNullOrWhiteSpace(scenario) ? CreateScenarioName() : scenario.Trim(),
            UseBridgeMessage = selectedBridge != null,
            BridgeMessageType = selectedBridge?.TypeName,
            Subject = selectedBridge != null ? BuildBridgeSubject(selectedBridge.TypeName) : "dds.sidecar.to-dds.AirThreatInformation",
            PayloadText = "{}",
            AutoEnabled = false,
        };

        Session.ScenarioSteps.Add(step);
        EditScenarioStep(step);
    }

    private void EditScenarioStep(NatsScenarioStep step)
    {
        _editingStep = step;
        SyncEditingStepSchema(step);
    }

    private async Task SaveScenarioStepEditor()
    {
        if (_editingStep == null)
            return;

        SyncScenarioStepAutomation(_editingStep);
        await PrepareEditingStepAsync(_editingStep);

        _editingStep = null;
    }

    private void CloseScenarioStepEditor()
    {
        _editingStep = null;
    }

    private void OnScenarioStepModeChanged(NatsScenarioStep step, NatsStepMode mode)
    {
        step.Mode = mode;
        SyncScenarioStepAutomation(step);
    }

    private static void SyncScenarioStepAutomation(NatsScenarioStep step)
    {
        step.AutoEnabled = step.Mode != NatsStepMode.Manual;

        if (step.Mode == NatsStepMode.Periodic && step.IntervalMs <= 0)
            step.IntervalMs = 1000;

        if (step.Mode == NatsStepMode.Bulk && step.BulkCount <= 0)
            step.BulkCount = 1;
    }

    private void DeleteEditingScenarioStep()
    {
        if (_editingStep == null)
            return;

        RemoveScenarioStep(_editingStep);
    }

    private void RemoveScenarioStep(NatsScenarioStep step)
    {
        if (Session == null)
            return;

        var removed = Session.ScenarioSteps.FirstOrDefault(existing => existing.Id == step.Id);
        if (removed == null)
            return;

        Session.ScenarioSteps.Remove(removed);
        if (_editingStep?.Id == removed.Id)
            _editingStep = null;
    }

    private void MoveScenarioStep(NatsScenarioStep step, int direction)
    {
        if (Session == null)
            return;

        var scenarioName = NormalizeScenarioName(step.Scenario);
        var scenarioSteps = Session.ScenarioSteps
            .Where(existing => string.Equals(NormalizeScenarioName(existing.Scenario), scenarioName, StringComparison.OrdinalIgnoreCase))
            .ToList();
        var index = scenarioSteps.FindIndex(existing => existing.Id == step.Id);
        var nextIndex = index + direction;
        if (index < 0 || nextIndex < 0 || nextIndex >= scenarioSteps.Count)
            return;

        var target = scenarioSteps[nextIndex];
        var sourceIndex = Session.ScenarioSteps.FindIndex(existing => existing.Id == step.Id);
        var targetIndex = Session.ScenarioSteps.FindIndex(existing => existing.Id == target.Id);
        if (sourceIndex < 0 || targetIndex < 0)
            return;

        Session.ScenarioSteps[sourceIndex] = target;
        Session.ScenarioSteps[targetIndex] = step;
    }

    private async Task FireScenarioStep(NatsScenarioStep step)
    {
        try
        {
            await ExecuteStepAsync(step);
        }
        catch (Exception ex)
        {
            State.AddLog($"NATS 단계 발행 실패: {ex.Message}", LogLevel.Error);
            Snackbar.Add($"단계 발행 실패: {ex.Message}", Severity.Error);
        }
    }

    private async Task RunScenario(string scenario)
    {
        if (Session == null || ManualScenarioStepCountFor(scenario) == 0 || _runningScenario)
            return;

        _runningScenario = true;
        try
        {
            var manualSteps = Session.ScenarioSteps
                .Where(step => string.Equals(NormalizeScenarioName(step.Scenario), NormalizeScenarioName(scenario), StringComparison.OrdinalIgnoreCase) && step.Mode == NatsStepMode.Manual)
                .ToList();

            foreach (var step in manualSteps)
                await ExecuteStepAsync(step);

        }
        catch (Exception ex)
        {
            State.AddLog($"NATS 시나리오 실행 실패: {ex.Message}", LogLevel.Error);
            Snackbar.Add($"NATS 시나리오 실행 실패: {ex.Message}", Severity.Error);
        }
        finally
        {
            _runningScenario = false;
        }
    }

    private async Task StartScenarioWorkflow(string scenario)
    {
        if (Session == null)
            return;

        if (ManualScenarioStepCountFor(scenario) > 0)
            await RunScenario(scenario);

        if (AutomaticScenarioStepCountFor(scenario) > 0)
            StartAutomation(scenario);
    }

    private void StartAutomation(string scenario)
    {
        if (Session == null || IsScenarioAutomationRunning(scenario))
            return;

        var steps = Session.ScenarioSteps
            .Where(step => string.Equals(NormalizeScenarioName(step.Scenario), NormalizeScenarioName(scenario), StringComparison.OrdinalIgnoreCase)
                && step.Mode != NatsStepMode.Manual)
            .ToList();

        foreach (var step in steps)
        {
            Triggers.Add(new NatsTrigger
            {
                SessionId = Session.SessionId,
                Name = string.IsNullOrWhiteSpace(step.Name) ? step.Subject : step.Name,
                Type = step.Mode switch
                {
                    NatsStepMode.Periodic => NatsTriggerType.Periodic,
                    NatsStepMode.Bulk => NatsTriggerType.Bulk,
                    NatsStepMode.OnIncoming => NatsTriggerType.OnIncoming,
                    _ => NatsTriggerType.Periodic,
                },
                Enabled = true,
                UseBridgeMessage = step.UseBridgeMessage,
                BridgeMessageType = step.BridgeMessageType,
                Subject = step.Subject,
                PayloadText = step.PayloadText,
                IntervalMs = step.IntervalMs,
                MaxFires = step.MaxFires,
                BulkCount = step.BulkCount,
                BulkParallel = step.BulkParallel,
                MatchSubject = step.MatchSubject,
                BlockSelfSubjectLoop = step.BlockSelfSubjectLoop,
                MinFireIntervalMs = step.MinFireIntervalMs,
                MaxFiresPerMinute = step.MaxFiresPerMinute,
                Scenario = scenario,
                SourceStepId = step.Id,
            });
        }

        State.AddLog($"NATS 자동화 시작: {scenario}", LogLevel.Info);
    }

    private void StopAutomation(string scenario)
    {
        if (Session == null)
            return;

        var triggerIds = Triggers.Snapshot(Session.SessionId)
            .Where(trigger => string.Equals(NormalizeScenarioName(trigger.Scenario), NormalizeScenarioName(scenario), StringComparison.OrdinalIgnoreCase))
            .Select(trigger => trigger.Id)
            .ToList();

        foreach (var triggerId in triggerIds)
            Triggers.Remove(triggerId);

        State.AddLog($"NATS 자동화 중지: {scenario}", LogLevel.Info);
    }

    private async Task ExecuteStepAsync(NatsScenarioStep step)
    {
        if (Session == null)
            return;

        await PrepareEditingStepAsync(step);

        var repeatCount = Math.Max(1, step.RepeatCount);
        for (var repeatIndex = 0; repeatIndex < repeatCount; repeatIndex++)
        {
            if (step.UseBridgeMessage)
            {
                var messageType = ResolveBridgeMessageType(step.BridgeMessageType);
                if (messageType == null)
                    throw new InvalidOperationException($"NATS bridge 메시지 타입을 찾을 수 없습니다: {step.BridgeMessageType}");

                var message = await JsonMessageConverter.JsonToMessageAsync(step.PayloadText, messageType);
                await NatsSessions.PublishBinaryAsync(Session.SessionId, step.Subject, message.ToByteArray(), step.PayloadText);
            }
            else
            {
                await NatsSessions.PublishTextAsync(Session.SessionId, step.Subject, step.PayloadText);
            }

            if (step.DelayAfterMs > 0 && repeatIndex < repeatCount - 1)
                await Task.Delay(step.DelayAfterMs);
        }
    }

    private async Task ExportScenarioJson()
    {
        if (Session == null || Session.ScenarioSteps.Count == 0)
            return;

        var json = JsonSerializer.Serialize(new ScenarioExportPayload { Steps = Session.ScenarioSteps.ToList() }, new JsonSerializerOptions { WriteIndented = true });
        await JS.InvokeVoidAsync("workbench.downloadText", $"nats-scenarios-{SanitizeFileName(Session.Name)}.json", json, "application/json");
        State.AddLog($"NATS 시나리오 내보내기: {Session.ScenarioSteps.Count} step", LogLevel.Info);
    }

    private async Task ImportScenarioJson(IBrowserFile? file)
    {
        if (Session == null || file == null)
            return;

        await using var stream = file.OpenReadStream(1024 * 1024);
        var payload = await JsonSerializer.DeserializeAsync<ScenarioExportPayload>(stream);
        if (payload?.Steps == null)
            return;

        Session.ScenarioSteps = payload.Steps
            .Select(step => new NatsScenarioStep
            {
                Id = string.IsNullOrWhiteSpace(step.Id) ? Guid.NewGuid().ToString() : step.Id,
                Name = step.Name,
                Scenario = step.Scenario,
                UseBridgeMessage = step.UseBridgeMessage,
                BridgeMessageType = step.BridgeMessageType,
                Subject = step.Subject,
                PayloadText = step.PayloadText,
                RepeatCount = step.RepeatCount,
                DelayAfterMs = step.DelayAfterMs,
                Mode = step.Mode,
                AutoEnabled = step.Mode != NatsStepMode.Manual || step.AutoEnabled,
                IntervalMs = step.IntervalMs,
                MaxFires = step.MaxFires,
                BulkCount = step.BulkCount,
                BulkParallel = step.BulkParallel,
                MatchSubject = step.MatchSubject,
                BlockSelfSubjectLoop = step.BlockSelfSubjectLoop,
                MinFireIntervalMs = step.MinFireIntervalMs,
                MaxFiresPerMinute = step.MaxFiresPerMinute,
            })
            .ToList();

        _editingStep = null;
        State.AddLog($"NATS 시나리오 불러오기: {Session.ScenarioSteps.Count} step", LogLevel.Info);
    }

    private int ManualScenarioStepCountFor(string scenario)
        => Session?.ScenarioSteps.Count(step => string.Equals(NormalizeScenarioName(step.Scenario), NormalizeScenarioName(scenario), StringComparison.OrdinalIgnoreCase) && step.Mode == NatsStepMode.Manual) ?? 0;

    private int AutomaticScenarioStepCountFor(string scenario)
        => Session?.ScenarioSteps.Count(step => string.Equals(NormalizeScenarioName(step.Scenario), NormalizeScenarioName(scenario), StringComparison.OrdinalIgnoreCase) && step.Mode != NatsStepMode.Manual) ?? 0;

    private bool IsScenarioAutomationRunning(string scenario)
        => Session != null && Triggers.Snapshot(Session.SessionId)
            .Any(trigger => string.Equals(NormalizeScenarioName(trigger.Scenario), NormalizeScenarioName(scenario), StringComparison.OrdinalIgnoreCase));

    private static string ScenarioStepDisplayName(NatsScenarioStep step)
        => string.IsNullOrWhiteSpace(step.Name)
            ? (step.UseBridgeMessage && !string.IsNullOrWhiteSpace(step.BridgeMessageType) ? step.BridgeMessageType : step.Subject)
            : step.Name;

    private string ScenarioStepStatusLabel(NatsScenarioStep step)
    {
        if (step.Mode == NatsStepMode.Manual)
            return "수동";
        return IsScenarioAutomationRunning(step.Scenario) ? "자동화 동작 중" : "자동 대기";
    }

    private Color ScenarioStepStatusColor(NatsScenarioStep step)
    {
        if (step.Mode == NatsStepMode.Manual)
            return Color.Info;
        return Color.Success;
    }

    private static string ScenarioStepModeLabel(NatsScenarioStep step) => step.Mode switch
    {
        NatsStepMode.Manual => "수동",
        NatsStepMode.Periodic => "주기",
        NatsStepMode.Bulk => "다발",
        NatsStepMode.OnIncoming => "수신-응답",
        _ => "단계",
    };

    private static string ScenarioStepWhenLabel(NatsScenarioStep step)
    {
        return step.Mode switch
        {
            NatsStepMode.Manual => $"repeat {Math.Max(1, step.RepeatCount)} · delay {step.DelayAfterMs}ms",
            NatsStepMode.Periodic => $"every {step.IntervalMs}ms",
            NatsStepMode.Bulk => $"bulk {step.BulkCount} · {(step.BulkParallel ? "parallel" : "seq")}",
            NatsStepMode.OnIncoming => $"on {(string.IsNullOrWhiteSpace(step.MatchSubject) ? "*" : step.MatchSubject)}",
            _ => string.Empty,
        };
    }

    private static string ScenarioStepModeGuidance(NatsStepMode mode) => mode switch
    {
        NatsStepMode.Manual => "이 단계는 수동 단계 전체 실행과 전체 시작 앞부분에 포함됩니다. 자동 단계 시작만으로는 움직이지 않습니다.",
        NatsStepMode.Periodic => "이 단계는 자동 단계 시작 또는 전체 시작 뒤에 주기적으로 발행됩니다. 수동 단계 전체 실행에는 들어가지 않습니다.",
        NatsStepMode.Bulk => "이 단계는 자동 단계 시작 또는 전체 시작 뒤에 다발 발행 규칙으로 움직입니다. 수동 단계 전체 실행에는 들어가지 않습니다.",
        NatsStepMode.OnIncoming => "이 단계는 자동화 시작 뒤 매칭 subject 수신을 기다렸다가 반응 발행합니다. 수동 단계 전체 실행에는 들어가지 않습니다.",
        _ => string.Empty,
    };

    private static string ScenarioStepPayloadPreview(NatsScenarioStep step)
    {
        if (string.IsNullOrWhiteSpace(step.PayloadText))
            return "(empty)";
        var trimmed = step.PayloadText.Trim();
        return trimmed.Length <= 120 ? trimmed : $"{trimmed[..120]}...";
    }

    private async Task LoadBridgeMessagesAsync()
    {
        try
        {
            var path = Path.Combine(WebHostEnv.ContentRootPath, "schema", "proto", "grpc", "DDSSim.proto");
            var protoBytes = await File.ReadAllBytesAsync(path);
            var services = await ProtoLoader.LoadProtoServicesAsync(protoBytes);

            _bridgeSchemaAssembly = await ProtoCompiler.CompileProtoToAssemblyAsync(protoBytes);

            var next = services
                .SelectMany(service => service.Methods)
                .Where(method => !string.IsNullOrWhiteSpace(method.InputType)
                    && !string.Equals(method.InputType, "google.protobuf.Empty", StringComparison.Ordinal))
                .GroupBy(method => method.InputType, StringComparer.Ordinal)
                .Select(group => new BridgeMessageOption
                {
                    TypeName = StripPackagePrefix(group.Key),
                    InputSchema = group.Select(method => method.InputSchema).FirstOrDefault(schema => !string.IsNullOrWhiteSpace(schema))
                })
                .OrderBy(option => option.TypeName, StringComparer.Ordinal)
                .ToList();

            _bridgeMessages.Clear();
            _bridgeMessages.AddRange(next);
            _bridgeLoadError = null;
        }
        catch (Exception ex)
        {
            _bridgeSchemaAssembly = null;
            _bridgeLoadError = $"grpc/DDSSim.proto 로드 실패: {ex.Message}";
        }
    }

    private Task OnEditingBridgeModeChanged(bool enabled)
    {
        if (_editingStep == null)
            return Task.CompletedTask;

        _editingStep.UseBridgeMessage = enabled && _bridgeMessages.Count > 0;
        if (_editingStep.UseBridgeMessage)
        {
            _selectedScenarioBridgeMessageType ??= _editingStep.BridgeMessageType ?? _bridgeMessages.FirstOrDefault()?.TypeName;
            ApplySelectedScenarioBridgeMessage();
        }
        else
        {
            _editingSchemaFields.Clear();
            _scenarioRawJsonMode = true;
            _editingStep.BridgeMessageType = null;
        }

        return Task.CompletedTask;
    }

    private Task OnEditingBridgeMessageTypeChanged(string typeName)
    {
        _selectedScenarioBridgeMessageType = typeName;
        ApplySelectedScenarioBridgeMessage();
        return Task.CompletedTask;
    }

    private void SetScenarioRawJsonMode(bool raw)
    {
        _scenarioRawJsonMode = raw;
        if (_editingStep == null || _editingSchemaFields.Count == 0)
            return;

        if (raw)
            BuildScenarioJsonFromForm();
        else
            TryPopulateSchemaFieldsFromJson(_editingSchemaFields, _editingStep.PayloadText);
    }

    private Task OnScenarioSchemaChanged()
    {
        if (_editingStep != null)
            BuildScenarioJsonFromForm();

        return Task.CompletedTask;
    }

    private void SyncEditingStepSchema(NatsScenarioStep step)
    {
        _editingSchemaFields.Clear();
        _scenarioRawJsonMode = false;

        if (!step.UseBridgeMessage || _bridgeMessages.Count == 0)
        {
            _selectedScenarioBridgeMessageType = null;
            return;
        }

        _selectedScenarioBridgeMessageType = !string.IsNullOrWhiteSpace(step.BridgeMessageType)
            ? step.BridgeMessageType
            : _bridgeMessages.FirstOrDefault()?.TypeName;
        ApplySelectedScenarioBridgeMessage(step.PayloadText);
    }

    private void ApplySelectedScenarioBridgeMessage(string? existingJson = null)
    {
        if (_editingStep == null)
            return;

        var option = _bridgeMessages.FirstOrDefault(message => string.Equals(message.TypeName, _selectedScenarioBridgeMessageType, StringComparison.Ordinal));
        if (option == null)
            return;

        _editingStep.UseBridgeMessage = true;
        _editingStep.BridgeMessageType = option.TypeName;
        _editingStep.Subject = BuildBridgeSubject(option.TypeName);
        _editingSchemaFields.Clear();
        _editingSchemaFields.AddRange(ParseSchemaFields(option.InputSchema));

        var payloadJson = string.IsNullOrWhiteSpace(existingJson) ? _editingStep.PayloadText : existingJson;
        _scenarioRawJsonMode = _editingSchemaFields.Count == 0 || !TryPopulateSchemaFieldsFromJson(_editingSchemaFields, payloadJson);

        if (!_scenarioRawJsonMode)
            BuildScenarioJsonFromForm();
        else if (string.IsNullOrWhiteSpace(_editingStep.PayloadText))
            _editingStep.PayloadText = "{}";
    }

    private async Task PrepareEditingStepAsync(NatsScenarioStep step)
    {
        if (!step.UseBridgeMessage)
            return;

        step.BridgeMessageType = string.IsNullOrWhiteSpace(step.BridgeMessageType)
            ? _selectedScenarioBridgeMessageType
            : step.BridgeMessageType;
        if (string.IsNullOrWhiteSpace(step.BridgeMessageType))
            throw new InvalidOperationException("bridge message 타입을 먼저 선택하세요.");

        step.Subject = BuildBridgeSubject(step.BridgeMessageType);
        if (ReferenceEquals(step, _editingStep) && !_scenarioRawJsonMode && _editingSchemaFields.Count > 0)
            BuildScenarioJsonFromForm();

        if (_bridgeSchemaAssembly == null)
        {
            await EnsureBridgeSchemaAssemblyAsync();
        }
    }

    private async Task EnsureBridgeSchemaAssemblyAsync()
    {
        if (_bridgeSchemaAssembly != null)
            return;

        var path = Path.Combine(WebHostEnv.ContentRootPath, "schema", "proto", "grpc", "DDSSim.proto");
        var protoBytes = await File.ReadAllBytesAsync(path);
        _bridgeSchemaAssembly = await ProtoCompiler.CompileProtoToAssemblyAsync(protoBytes);
    }

    private Type? ResolveBridgeMessageType(string? typeName)
        => _bridgeSchemaAssembly?
            .GetTypes()
            .FirstOrDefault(type => typeof(IMessage).IsAssignableFrom(type)
                && string.Equals(type.Name, typeName, StringComparison.Ordinal));

    private void BuildScenarioJsonFromForm()
    {
        if (_editingStep == null)
            return;

        _editingStep.PayloadText = JsonSerializer.Serialize(
            BuildJsonObject(_editingSchemaFields),
            new JsonSerializerOptions { WriteIndented = true });
    }

    private static string BuildBridgeSubject(string typeName) => $"dds.sidecar.to-dds.{typeName}";

    private static string StripPackagePrefix(string fullName)
    {
        if (string.IsNullOrEmpty(fullName))
            return fullName;

        var lastDot = fullName.LastIndexOf('.');
        return lastDot >= 0 ? fullName[(lastDot + 1)..] : fullName;
    }

    private static List<SchemaField> ParseSchemaFields(string? schema)
    {
        if (string.IsNullOrEmpty(schema))
            return [];

        try
        {
            using var doc = JsonDocument.Parse(schema);
            return ParsePropertiesElement(doc.RootElement);
        }
        catch
        {
            return [];
        }
    }

    private static List<SchemaField> ParsePropertiesElement(JsonElement element)
    {
        if (!element.TryGetProperty("properties", out var props))
            return [];

        var fields = new List<SchemaField>();
        foreach (var prop in props.EnumerateObject())
            fields.Add(ParseFieldElement(prop.Name, prop.Value));

        return fields;
    }

    private static SchemaField ParseFieldElement(string name, JsonElement schema)
    {
        var field = new SchemaField { Name = name };

        if (schema.TryGetProperty("enum", out var enumProp))
        {
            field.Type = "enum";
            field.EnumValues = enumProp.EnumerateArray().Select(value => value.GetString() ?? string.Empty).ToArray();
            field.Value = field.EnumValues.FirstOrDefault() ?? string.Empty;
            return field;
        }

        if (!schema.TryGetProperty("type", out var typeProp))
            return field;

        field.Type = typeProp.GetString() ?? "string";
        switch (field.Type)
        {
            case "object":
                field.Children = ParsePropertiesElement(schema);
                field.Value = "{}";
                break;
            case "array":
                if (schema.TryGetProperty("items", out var itemsEl))
                    field.ItemTemplate = ParseFieldElement("0", itemsEl);
                field.Value = "[]";
                break;
            case "integer":
            case "number":
                field.Value = "0";
                break;
            default:
                field.Value = string.Empty;
                break;
        }

        return field;
    }

    private static Dictionary<string, object?> BuildJsonObject(List<SchemaField> fields)
    {
        var obj = new Dictionary<string, object?>();
        foreach (var field in fields)
            obj[field.Name] = BuildFieldValue(field);
        return obj;
    }

    private static bool TryPopulateSchemaFieldsFromJson(List<SchemaField> fields, string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
            return false;

        try
        {
            using var doc = JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind != JsonValueKind.Object)
                return false;

            ApplyObjectToFields(fields, doc.RootElement);
            return true;
        }
        catch
        {
            return false;
        }
    }

    private static void ApplyObjectToFields(List<SchemaField> fields, JsonElement element)
    {
        foreach (var field in fields)
        {
            if (!element.TryGetProperty(field.Name, out var value))
                continue;

            ApplyJsonToField(field, value);
        }
    }

    private static void ApplyJsonToField(SchemaField field, JsonElement value)
    {
        switch (field.Type)
        {
            case "boolean":
                field.BoolValue = value.ValueKind == JsonValueKind.True || (value.ValueKind == JsonValueKind.False ? false : field.BoolValue);
                break;
            case "integer":
            case "number":
            case "string":
            case "enum":
                field.Value = value.ValueKind == JsonValueKind.String ? value.GetString() ?? string.Empty : value.ToString();
                break;
            case "object":
                if (field.Children.Count > 0 && value.ValueKind == JsonValueKind.Object)
                    ApplyObjectToFields(field.Children, value);
                else
                    field.Value = value.GetRawText();
                break;
            case "array":
                if (field.ItemTemplate != null && value.ValueKind == JsonValueKind.Array)
                {
                    field.ArrayItems.Clear();
                    var index = 0;
                    foreach (var item in value.EnumerateArray())
                    {
                        var clone = field.ItemTemplate.DeepClone(index.ToString());
                        ApplyJsonToField(clone, item);
                        field.ArrayItems.Add(clone);
                        index++;
                    }
                }
                else
                {
                    field.Value = value.GetRawText();
                }
                break;
            default:
                field.Value = value.ToString();
                break;
        }
    }

    private static object? BuildFieldValue(SchemaField field) => field.Type switch
    {
        "boolean" => field.BoolValue,
        "integer" => long.TryParse(field.Value, out var longValue) ? longValue : 0L,
        "number" => double.TryParse(field.Value, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var doubleValue) ? doubleValue : 0.0,
        "object" when field.Children.Count > 0 => BuildJsonObject(field.Children),
        "object" => TryParseRaw(field.Value),
        "array" when field.ItemTemplate != null => field.ArrayItems.Select(BuildFieldValue).ToArray(),
        "array" => TryParseRaw(field.Value),
        _ => (object?)field.Value
    };

    private static object? TryParseRaw(string value)
    {
        try
        {
            using var doc = JsonDocument.Parse(value);
            return doc.RootElement.Clone();
        }
        catch
        {
            return value;
        }
    }

    private string CreateScenarioName()
    {
        var existing = BuildScenarioGroups().Select(group => group.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
        for (var index = 1; index < 1000; index++)
        {
            var candidate = $"Scenario {index}";
            if (!existing.Contains(candidate))
                return candidate;
        }

        return $"Scenario {Guid.NewGuid():N}";
    }

    private List<NatsScenarioGroupVm> BuildScenarioGroups()
    {
        if (Session == null || Session.ScenarioSteps.Count == 0)
            return [];

        return Session.ScenarioSteps
            .GroupBy(step => NormalizeScenarioName(step.Scenario))
            .Select(group => new NatsScenarioGroupVm(group.First().Scenario, group.ToList()))
            .OrderBy(group => group.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static string NormalizeScenarioName(string? value)
        => string.IsNullOrWhiteSpace(value) ? "default" : value.Trim();

    private static string SanitizeFileName(string name)
    {
        var invalid = Path.GetInvalidFileNameChars();
        return new string(name.Select(ch => invalid.Contains(ch) ? '-' : ch).ToArray());
    }

    private async void OnTriggersChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Triggers.Changed -= OnTriggersChanged;
    }

    private sealed class ScenarioExportPayload
    {
        public List<NatsScenarioStep> Steps { get; set; } = [];
    }

    private sealed class BridgeMessageOption
    {
        public string TypeName { get; set; } = string.Empty;
        public string? InputSchema { get; set; }
    }

    private sealed record NatsScenarioGroupVm(string Name, List<NatsScenarioStep> OrderedSteps);
}
