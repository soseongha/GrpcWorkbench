@using System.Xml.Linq
@using ASAP.Models.Dds
@using ASAP.Services
@using LogLevel = ASAP.Models.Ui.LogLevel
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Hosting
@inject IDdsSessionService DdsSessions
@inject ISnackbar Snackbar
@inject IWebHostEnvironment WebHostEnv
@inject WorkbenchStateService State

<div class="wb-panel wb-panel--contain pa-3">
    <div class="wb-panel-kicker">DDS</div>
    <div class="wb-panel-heading" title="도메인만 정하면 기본 샘플로 바로 시작합니다">세션</div>

    <div class="wb-inline-note mt-2" title="XML 업로드는 선택 사항입니다. 비워 두면 저장소 기본 DDSSim 샘플과 topic/QoS 설정으로 바로 세션을 엽니다.">샘플 사용 가능</div>

    <div class="wb-home-form mt-3">
        <MudTextField @bind-Value="_name" Label="세션 이름" Placeholder="예: DDSSim domain 0"
                      Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudNumericField @bind-Value="_domainId" Label="Domain ID" Min="0" Max="232"
                         Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudTextField @bind-Value="_multicast" Label="멀티캐스트 주소 (선택)" Placeholder="239.255.0.1"
                      Variant="Variant.Outlined" Margin="Margin.Dense" />
    </div>

    <div class="wb-home-form mt-3">
        <div>
            <MudFileUpload T="IBrowserFile" FilesChanged="OnTypesFileSelected" Accept=".xml">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined" FullWidth="true"
                               StartIcon="@Icons.Material.Filled.UploadFile">
                        타입 정의 XML 업로드 (선택)
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
            <div class="wb-inline-note mt-1">@(_typesFileName ?? "선택 안 됨")</div>
        </div>
        <div>
            <MudFileUpload T="IBrowserFile" FilesChanged="OnConfigFileSelected" Accept=".xml">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined" FullWidth="true"
                               StartIcon="@Icons.Material.Filled.UploadFile">
                        토픽/QoS 설정 XML 업로드 (선택)
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
            <div class="wb-inline-note mt-1">@(_configFileName ?? "선택 안 됨 · 기본 topic/QoS 샘플 사용")</div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="wb-inline-note mt-2" style="color:var(--mud-palette-error);">@_error</div>
    }

    <div class="d-flex mt-3" style="gap:8px;">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="Submit" Disabled="_creating"
                   StartIcon="@Icons.Material.Filled.AddLink">
            @if (_creating)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <text>생성 중…</text>
            }
            else
            {
                <text>DDS 세션 생성</text>
            }
        </MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="OnCancelled">취소</MudButton>
    </div>
</div>

@code {
    [Parameter] public EventCallback<DdsSession> OnCreated { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    private string _name = "";
    private int _domainId = 0;
    private string _multicast = "";

    private byte[]? _typesBytes;
    private string? _typesFileName;
    private byte[]? _configBytes;
    private string? _configFileName;

    private bool _creating;
    private string? _error;

    private async Task OnTypesFileSelected(IBrowserFile? file)
    {
        if (file == null) return;
        using var ms = new MemoryStream();
        await file.OpenReadStream(maxAllowedSize: 16 * 1024 * 1024).CopyToAsync(ms);
        _typesBytes = ms.ToArray();
        _typesFileName = file.Name;
    }

    private async Task OnConfigFileSelected(IBrowserFile? file)
    {
        if (file == null) return;
        using var ms = new MemoryStream();
        await file.OpenReadStream(maxAllowedSize: 4 * 1024 * 1024).CopyToAsync(ms);
        _configBytes = ms.ToArray();
        _configFileName = file.Name;
    }

    private async Task Submit()
    {
        _error = null;

        _creating = true;
        try
        {
            var (typesXml, typesFileName) = await ResolveTypesXmlAsync();
            var (configXml, configFileName) = await ResolveConfigXmlAsync();
            var sessionName = string.IsNullOrWhiteSpace(_name)
                ? $"DDSSim domain {_domainId}"
                : _name.Trim();

            var transport = new DdsTransportSettings
            {
                DomainId = _domainId,
                MulticastAddress = string.IsNullOrWhiteSpace(_multicast) ? null : _multicast.Trim(),
            };
            var session = await Task.Run(() => DdsSessions.Create(new DdsSessionCreateRequest
            {
                Name = sessionName,
                Transport = transport,
                TypesXmlContent = typesXml,
                TypesXmlFileName = typesFileName,
                ConfigXmlContent = configXml,
                ConfigXmlFileName = configFileName,
            }));
            State.AddLog($"DDS 세션 생성: {session.Name}", LogLevel.Success);
            await OnCreated.InvokeAsync(session);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            State.AddLog($"DDS 세션 생성 실패: {ex.Message}", LogLevel.Error);
        }
        finally
        {
            _creating = false;
        }
    }

        private async Task<(string Xml, string FileName)> ResolveTypesXmlAsync()
        {
                if (_typesBytes is { Length: > 0 })
                        return (System.Text.Encoding.UTF8.GetString(_typesBytes), _typesFileName ?? "DDSSim.xml");

            var filePath = ResolvePreferredSamplePath("DDSSim.xml");
            if (File.Exists(filePath))
            {
                var xml = await File.ReadAllTextAsync(filePath);
            return (xml, Path.GetFileName(filePath));
            }

                const string fallback = @"<?xml version=""1.0"" encoding=""UTF-8""?>
<dds>
    <types>
        <module name=""STRUCT"">
            <struct name=""Position8"">
                <member name=""X"" type=""float64""/>
                <member name=""Y"" type=""float64""/>
            </struct>
        </module>
    </types>
</dds>";
                return (fallback, "DDSSim.default.xml");
        }

        private async Task<(string Xml, string FileName)> ResolveConfigXmlAsync()
        {
                if (_configBytes is { Length: > 0 })
                        return (System.Text.Encoding.UTF8.GetString(_configBytes), _configFileName ?? "dds-config.xml");

            var sampleConfig = await TryBuildSampleConfigXmlAsync();
            if (sampleConfig is not null)
            return sampleConfig.Value;

            var filePath = ResolvePreferredSamplePath("dds-config.xml");
                if (File.Exists(filePath))
                {
                        var xml = await File.ReadAllTextAsync(filePath);
                return (xml, Path.GetFileName(filePath));
                }

                const string fallback = @"<?xml version=""1.0"" encoding=""UTF-8""?>
<dds-ambassador-config>
    <dds>
        <qos_library name=""AmbassadorProfiles"">
            <qos_profile name=""DefaultProfile"" is_default_qos=""true""/>
        </qos_library>
    </dds>
    <topics>
        <topic>
            <topic_name>PositionTopic</topic_name>
            <type_name>STRUCT::Position8</type_name>
            <direction>Both</direction>
            <qos_profile>DefaultProfile</qos_profile>
        </topic>
    </topics>
</dds-ambassador-config>";
                return (fallback, "dds-config.default.xml");
        }

    private string ResolvePreferredSamplePath(string fileName)
    {
        var localSamplePath = Path.Combine(WebHostEnv.ContentRootPath, "samples", "dds", fileName);

        return localSamplePath;
    }

    private async Task<(string Xml, string FileName)?> TryBuildSampleConfigXmlAsync()
    {
        var sampleRoot = Path.Combine(WebHostEnv.ContentRootPath, "schema", "dds", "definitions");
        var qosPath = Path.Combine(sampleRoot, "qos_profiles.xml");
        var topicsPath = Path.Combine(sampleRoot, "topics.xml");

        if (!File.Exists(qosPath) || !File.Exists(topicsPath))
            return null;

        var qosXml = await File.ReadAllTextAsync(qosPath);
        var topicsXml = await File.ReadAllTextAsync(topicsPath);

        var qosElement = XElement.Parse(qosXml);
        var topicsElement = XElement.Parse(topicsXml);
        var normalizedTopics = new XElement("topics",
            topicsElement.Elements("topic")
                .Select(topic =>
                {
                    var topicName = topic.Attribute("name")?.Value?.Trim();
                    var qosProfile = topic.Attribute("qos_profile")?.Value?.Trim();
                    var direction = topic.Attribute("direction")?.Value?.Trim();

                    if (string.IsNullOrWhiteSpace(topicName))
                        return null;

                    return new XElement("topic",
                        new XElement("topic_name", topicName),
                        new XElement("type_name", $"MSG::{topicName}"),
                        new XElement("direction", string.IsNullOrWhiteSpace(direction) ? "Both" : direction),
                        new XElement("qos_profile", string.IsNullOrWhiteSpace(qosProfile) ? "ReliableRealtime" : qosProfile));
                })
                .Where(topic => topic is not null)!);

        var doc = new XDocument(
            new XDeclaration("1.0", "UTF-8", null),
            new XElement("dds-ambassador-config",
                new XElement("dds", qosElement),
                normalizedTopics));

        return (doc.ToString(), "dds-config.xml");
    }
}
