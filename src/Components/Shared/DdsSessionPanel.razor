            return "{}";
        }
    }

    private async Task RunScenario(string scenario)
        => await RunManualScenario(scenario, showCompletionSnackbar: true);

    private async Task<bool> RunManualScenario(string scenario, bool showCompletionSnackbar)
    {
        if (Session == null || ManualScenarioStepCountFor(scenario) == 0 || _runningScenario)
            return false;

        _runningScenario = true;
        _scenarioCts = new CancellationTokenSource();
        var ct = _scenarioCts.Token;
        var scenarioName = NormalizeScenarioName(scenario);
        var manualSteps = Session.ScenarioSteps
            .Where(step => string.Equals(NormalizeScenarioName(step.Scenario), scenarioName, StringComparison.OrdinalIgnoreCase)
                && step.Mode == DdsStepMode.Manual)
            .ToList();

        State.AddLog($"DDS 수동 실행 시작: {scenarioName} · {manualSteps.Count} step", LogLevel.Info);

        try
        {
            for (var i = 0; i < manualSteps.Count; i++)
            {
                ct.ThrowIfCancellationRequested();
                var step = manualSteps[i];

                for (var repeat = 1; repeat <= Math.Max(1, step.RepeatCount); repeat++)
                {
                    ct.ThrowIfCancellationRequested();
                    var result = await Task.Run(() => DdsState.Publish(
                        Session.SessionId,
                        step.TopicName,
                        step.TypeName,
                        step.QosProfileName,
                        step.JsonPayload), ct);

                    if (!result.Success)
                    {
                        AppendLog("system", "ERROR", $"{scenarioName} step {i + 1}/{manualSteps.Count} 실패: {result.Error}");
                    }
                }

                var delayMs = Math.Max(0, step.DelayAfterMs);
                if (delayMs > 0)
                    await Task.Delay(delayMs, ct);
            }

            State.AddLog($"DDS 수동 실행 완료: {scenarioName}", LogLevel.Info);
            return true;
        }
        catch (OperationCanceledException)
        {
            Snackbar.Add("DDS 수동 실행 중단", Severity.Warning);
            AppendLog("system", "WARN", "사용자 요청으로 수동 실행 중단");
            return false;
        }
        finally
        {
            _runningScenario = false;
            _scenarioCts?.Dispose();
            _scenarioCts = null;
        }
    }

    private void StopScenario()
    {
        _scenarioCts?.Cancel();
    }

    private async Task ExportScenarioJson()
    {
        if (Session == null || Session.ScenarioSteps.Count == 0)
        {
            Snackbar.Add("내보낼 DDS 시나리오가 없어요.", Severity.Warning);
            return;
        }

        var payload = new DdsScenarioExportFile
        {
            Version = 1,
            ExportedAt = DateTimeOffset.Now,
            Steps = Session.ScenarioSteps.ToList(),
        };

        var json = JsonSerializer.Serialize(payload, new JsonSerializerOptions { WriteIndented = true });
        await JS.InvokeVoidAsync("workbench.downloadText", $"dds-scenarios-{SanitizeFileName(Session.Name)}.json", json, "application/json");
        State.AddLog($"DDS 시나리오 저장: {Session.ScenarioSteps.Count} step", LogLevel.Info);
    }

    private async Task ImportScenarioJson(IBrowserFile? file)
    {
        if (Session == null || file == null) return;

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            var payload = JsonSerializer.Deserialize<DdsScenarioExportFile>(json);

            if (payload?.Steps == null || payload.Steps.Count == 0)
            {
                Snackbar.Add("불러올 DDS 시나리오 단계가 없어요.", Severity.Warning);
                return;
            }

            Session.ScenarioSteps = payload.Steps
                .Where(step => !string.IsNullOrWhiteSpace(step.TopicName) && !string.IsNullOrWhiteSpace(step.TypeName))
                .Select(step => new DdsScenarioStep
                {
                    Id = string.IsNullOrWhiteSpace(step.Id) ? Guid.NewGuid().ToString() : step.Id,
                    Name = step.Name,
                    Scenario = NormalizeScenarioName(step.Scenario),
                    TopicName = step.TopicName,
                    TypeName = step.TypeName,
                    QosProfileName = step.QosProfileName,
                    JsonPayload = string.IsNullOrWhiteSpace(step.JsonPayload) ? "{}" : step.JsonPayload,
                    RepeatCount = Math.Max(1, step.RepeatCount),
                    DelayAfterMs = Math.Max(0, step.DelayAfterMs),
                    Mode = step.Mode,
                    AutoEnabled = step.Mode != DdsStepMode.Manual,
                    IntervalMs = Math.Max(1, step.IntervalMs),
                    MaxFires = step.MaxFires,
                    BulkCount = Math.Max(1, step.BulkCount),
                    BulkParallel = step.BulkParallel,
                    MatchTopicName = step.MatchTopicName,
                    BlockSelfTopicLoop = step.BlockSelfTopicLoop,
                    MinFireIntervalMs = Math.Max(0, step.MinFireIntervalMs),
                    MaxFiresPerMinute = Math.Max(0, step.MaxFiresPerMinute),
                })
                .ToList();

            _scenarioStepSchemaFields.Clear();
            foreach (var step in Session.ScenarioSteps)
                EnsureScenarioStepSchema(step);

            _editingScenarioStep = null;
            _activeAutomationScenarios.Clear();
            _automationRunning = false;

            State.AddLog($"DDS 시나리오 불러오기: {Session.ScenarioSteps.Count} step", LogLevel.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"DDS 시나리오 불러오기 실패: {ex.Message}", Severity.Error);
            AppendLog("system", "ERROR", $"DDS 시나리오 불러오기 실패: {ex.Message}");
        }
    }

    private string ComputeAutomationSignature()
    {
        if (Session == null)
            return string.Empty;

        return string.Join('|', Session.ScenarioSteps.Select(step => string.Join(';',
            step.Id,
            NormalizeScenarioName(step.Scenario),
            step.TopicName,
            step.TypeName,
            step.QosProfileName,
            step.JsonPayload,
            step.Mode,
            string.Join(',', _activeAutomationScenarios.OrderBy(name => name, StringComparer.OrdinalIgnoreCase)),
            step.IntervalMs,
            step.MaxFires,
            step.BulkCount,
            step.BulkParallel,
            step.MatchTopicName,
            step.BlockSelfTopicLoop,
            step.MinFireIntervalMs,
            step.MaxFiresPerMinute)));
    }

    private void SyncScenarioAutomationTriggers()
    {
        if (Session == null)
            return;

        if (!_automationRunning)
        {
            Triggers.ReplaceSessionTriggers(Session.SessionId, []);
            return;
        }

        var triggers = Session.ScenarioSteps
            .Where(step => step.Mode != DdsStepMode.Manual
                && _activeAutomationScenarios.Contains(NormalizeScenarioName(step.Scenario)))
            .Select(step => new DdsTrigger
            {
                Id = step.Id,
                Name = string.IsNullOrWhiteSpace(step.Name) ? step.TopicName : step.Name,
                SessionId = Session.SessionId,
                Type = step.Mode switch
                {
                    DdsStepMode.Periodic => DdsTriggerType.Periodic,
                    DdsStepMode.Bulk => DdsTriggerType.Bulk,
                    DdsStepMode.OnIncoming => DdsTriggerType.OnIncoming,
                    _ => DdsTriggerType.Periodic,
                },
                Enabled = _automationRunning,
                TopicName = step.TopicName,
                TypeName = step.TypeName,
                QosProfileName = step.QosProfileName,
                JsonPayload = step.JsonPayload,
                IntervalMs = Math.Max(1, step.IntervalMs),
                MaxFires = step.MaxFires,
                BulkCount = Math.Max(1, step.BulkCount),
                BulkParallel = step.BulkParallel,
                MatchTopicName = step.MatchTopicName,
                BlockSelfTopicLoop = step.BlockSelfTopicLoop,
                MinFireIntervalMs = Math.Max(0, step.MinFireIntervalMs),
                MaxFiresPerMinute = Math.Max(0, step.MaxFiresPerMinute),
            })
            .ToList();

        Triggers.ReplaceSessionTriggers(Session.SessionId, triggers);
    }

