        }
    }

    private void StartAutomation(string? scenario = null)
    {
        if (Session == null)
            return;

        var scenarioName = NormalizeScenarioName(scenario);
        var stepCount = AutomaticScenarioStepCountFor(scenarioName);
        if (stepCount == 0)
            return;

        _activeAutomationScenarios.Add(scenarioName);
        _automationRunning = _activeAutomationScenarios.Count > 0;
        SyncScenarioAutomationTriggers();
        State.AddLog($"DDS 자동화 시작: {scenarioName} · {stepCount} step", LogLevel.Info);
    }

    private void StopAutomation(string? scenario = null)
    {
        if (Session == null)
            return;

        if (string.IsNullOrWhiteSpace(scenario))
            _activeAutomationScenarios.Clear();
        else
            _activeAutomationScenarios.Remove(NormalizeScenarioName(scenario));

        _automationRunning = _activeAutomationScenarios.Count > 0;
        SyncScenarioAutomationTriggers();
        State.AddLog(string.IsNullOrWhiteSpace(scenario)
            ? "자동화 중지"
            : $"자동화 중지: {NormalizeScenarioName(scenario)}", LogLevel.Info);
    }

    private async Task StartScenarioWorkflow(string scenario)
    {
        if (Session == null || ScenarioStepCountFor(scenario) == 0 || _runningScenario || IsScenarioAutomationRunning(scenario))
            return;

        if (ManualScenarioStepCountFor(scenario) > 0)
        {
            var completed = await RunManualScenario(scenario, showCompletionSnackbar: AutomaticScenarioStepCountFor(scenario) == 0);
            if (!completed || Session == null || AutomaticScenarioStepCountFor(scenario) == 0)
                return;
        }

        StartAutomation(scenario);
    }

