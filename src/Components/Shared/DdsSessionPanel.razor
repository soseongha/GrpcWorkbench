            return;

        var fields = BuildSchemaFieldsForType(step.TypeName);
        if (fields.Count == 0)
            return;

        _scenarioStepSchemaFields[step.Id] = fields;
        TryPopulateFieldsFromJson(fields, step.JsonPayload);
        BuildScenarioStepJsonFromFields(step);
