    private void StartSelectedSubscriptions()
    {
        if (Session == null) return;

        var topicsToStart = ReceivableTopics
            .Where(topic => _selectedSubscriptionTopics.Contains(topic.TopicName))
            .Where(topic => ActiveSubscriptions.All(active => active.TopicName != topic.TopicName))
            .ToList();

        if (topicsToStart.Count == 0)
        {
            State.AddLog("DDS 수신 시작할 토픽 없음", LogLevel.Info);
            return;
        }

        try
        {
            DdsSubscriptionInfo? firstStarted = null;
            foreach (var topic in topicsToStart)
            {
                var info = DdsState.StartSubscription(
                    Session.SessionId, topic.TopicName, topic.TypeName, topic.QosProfileName);
                firstStarted ??= info;
            }

            if (topicsToStart.Count == 1 && firstStarted != null)
                _selectedSubscriptionId = firstStarted.SubscriptionId;

            State.AddLog($"DDS 수신 시작: {topicsToStart.Count}개 토픽", LogLevel.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"수신 시작 실패: {ex.Message}", Severity.Error);
            AppendLog("system", "ERROR", $"DDS 수신 시작 실패: {ex.Message}");
        }
    }

    private void StopSelectedSubscriptions()
    {
        var targets = ActiveSubscriptions
            .Where(subscription => _selectedSubscriptionTopics.Contains(subscription.TopicName))
            .Select(subscription => subscription.SubscriptionId)
            .ToList();

        if (targets.Count == 0)
        {
            State.AddLog("DDS 중지할 수신 토픽 없음", LogLevel.Info);
            return;
        }

        foreach (var subscriptionId in targets)
            DdsState.StopSubscription(subscriptionId);

        if (_selectedSubscriptionId is not null && targets.Contains(_selectedSubscriptionId))
            _selectedSubscriptionId = null;

        _selectedSampleSeq = 0;
        State.AddLog($"DDS 수신 중지: {targets.Count}개 토픽", LogLevel.Info);
    }

