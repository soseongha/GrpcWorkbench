}

@code {
    [Parameter] public DdsSession? Session { get; set; }

    private readonly HashSet<string> _selectedSubscriptionTopics = [];
    private readonly Dictionary<string, List<SchemaField>> _scenarioStepSchemaFields = [];
    private bool _showReceiveTopicPicker;
    private string? _selectedSubscriptionId;
    private long _selectedSampleSeq = 0;
    private string? _selectedOutboundTopicName;
    private string? _selectedOutboundKey;

    private string _scenarioDraftTopicName = "";
    private DdsTopicConfig? _scenarioDraftTopic;
    private string _scenarioDraftJson = "{}";
    private bool _scenarioDraftRawJsonMode;
    private List<SchemaField> _scenarioDraftSchemaFields = [];
    private string? _scenarioDraftMatchTopicName;
    private DdsScenarioStep? _editingScenarioStep;
    private bool _editingScenarioStepRawJsonMode;

    private bool _runningScenario;
    private bool _automationRunning;
    private readonly HashSet<string> _activeAutomationScenarios = new(StringComparer.OrdinalIgnoreCase);
    private CancellationTokenSource? _scenarioCts;
    private string _automationSignature = string.Empty;
    private int _renderQueued;
    private long _lastRenderTicks;
    private const int MaxLogEntries = 500;
    private string? _cachedDdsSessionId;
    private long _cachedDdsSubscriptionVersion = -1;
    private long _cachedDdsOutboundVersion = -1;
    private string? _cachedSamplesSubscriptionId;
    private long _cachedSamplesVersion = -1;
    private List<DdsSubscriptionInfo> _cachedActiveSubscriptions = [];
    private List<DdsOutboundEntry> _cachedRecentOutbound = [];
    private List<DdsSampleEntry> _cachedSamples = [];

    private IReadOnlyList<DdsTopicConfig> ReceivableTopics
        => Session == null
            ? []
            : Session.Topics.Where(t => t.Direction != DdsTopicDirection.Publish).ToList();

    private IReadOnlyList<DdsSubscriptionInfo> ActiveSubscriptions
    {
        get
        {
            EnsureDdsCache();
            return _cachedActiveSubscriptions;
        }
    }

    private DdsSubscriptionInfo? SelectedSubscription
        => Session == null || string.IsNullOrWhiteSpace(_selectedSubscriptionId)
            ? null
            : ActiveSubscriptions.FirstOrDefault(s => s.SubscriptionId == _selectedSubscriptionId);

    private int SelectedReceivableTopicCount
        => ReceivableTopics.Count(topic => _selectedSubscriptionTopics.Contains(topic.TopicName));

    private IReadOnlyList<string> SelectedReceivableTopicNames
        => ReceivableTopics
            .Where(topic => _selectedSubscriptionTopics.Contains(topic.TopicName))
            .Select(topic => topic.TopicName)
            .ToList();

    private int SelectedActiveSubscriptionCount
        => ActiveSubscriptions.Count(subscription => _selectedSubscriptionTopics.Contains(subscription.TopicName));

    private int SelectedStartableSubscriptionCount
        => ReceivableTopics.Count(topic => _selectedSubscriptionTopics.Contains(topic.TopicName)
            && ActiveSubscriptions.All(active => active.TopicName != topic.TopicName));

    private DdsTopicConfig? DefaultPublishTopic
        => Session?.Topics.FirstOrDefault(topic => topic.Direction != DdsTopicDirection.Subscribe);

    private int ManualScenarioStepCount
        => Session?.ScenarioSteps.Count(step => step.Mode == DdsStepMode.Manual) ?? 0;

    private int AutomaticScenarioStepCount
        => Session?.ScenarioSteps.Count(step => step.Mode != DdsStepMode.Manual) ?? 0;

    private int ScenarioStepCount
        => Session?.ScenarioSteps.Count ?? 0;

    private bool CanPublishScenarioDraft
        => _scenarioDraftTopic != null && _scenarioDraftTopic.Direction != DdsTopicDirection.Subscribe;

    private IReadOnlyList<DdsOutboundEntry> RecentOutbound
    {
        get
        {
            EnsureDdsCache();
            return _cachedRecentOutbound;
        }
    }

    protected override void OnInitialized()
    {
        DdsState.StateChanged += OnDdsStateChanged;
        DdsState.SampleReceived += OnSampleReceived;
    }

    private void EnsureDdsCache()
    {
        if (Session == null)
        {
            ResetDdsCache();
            return;
        }

        if (!string.Equals(_cachedDdsSessionId, Session.SessionId, StringComparison.Ordinal))
        {
            ResetDdsCache();
            _cachedDdsSessionId = Session.SessionId;
        }

        var subscriptionVersion = DdsState.SubscriptionVersion;
        if (_cachedDdsSubscriptionVersion != subscriptionVersion)
        {
            _cachedActiveSubscriptions = DdsState.SnapshotSubscriptions(Session.SessionId).ToList();
            _cachedDdsSubscriptionVersion = subscriptionVersion;
        }

        var outboundVersion = DdsState.OutboundVersion(Session.SessionId);
        if (_cachedDdsOutboundVersion != outboundVersion)
        {
            _cachedRecentOutbound = DdsState.SnapshotOutbound(Session.SessionId).ToList();
            _cachedDdsOutboundVersion = outboundVersion;
        }
    }

    private void ResetDdsCache()
    {
        _cachedDdsSessionId = null;
        _cachedDdsSubscriptionVersion = -1;
        _cachedDdsOutboundVersion = -1;
        _cachedSamplesSubscriptionId = null;
        _cachedSamplesVersion = -1;
        _cachedActiveSubscriptions = [];
        _cachedRecentOutbound = [];
        _cachedSamples = [];
    }

    private List<DdsSampleEntry> GetCachedSamples(string subscriptionId)
    {
        var version = DdsState.SampleVersion(subscriptionId);
        if (!string.Equals(_cachedSamplesSubscriptionId, subscriptionId, StringComparison.Ordinal)
            || _cachedSamplesVersion != version)
        {
            _cachedSamplesSubscriptionId = subscriptionId;
            _cachedSamplesVersion = version;
            _cachedSamples = DdsState.SnapshotSamples(subscriptionId).ToList();
        }

        return _cachedSamples;
    }

    protected override void OnParametersSet()
    {
        if (Session == null) return;

        RehydrateAutomationScenariosFromTriggers();
        EnsureDdsCache();

        foreach (var activeSubscription in ActiveSubscriptions)
        {
            _selectedSubscriptionTopics.Add(activeSubscription.TopicName);
        }

        if (_selectedSubscriptionId is not null && SelectedSubscription == null)
            _selectedSubscriptionId = null;

        if (_scenarioDraftTopic == null && Session.Topics.Count > 0)
        {
            var publishable = Session.Topics.FirstOrDefault(t => t.Direction != DdsTopicDirection.Subscribe) ?? Session.Topics[0];
            _scenarioDraftTopicName = publishable.TopicName;
            _scenarioDraftTopic = publishable;
        }
        BuildScenarioDraftSchemaForTopic();

        foreach (var step in Session.ScenarioSteps)
            EnsureScenarioStepSchema(step);

    }


    protected override void OnAfterRender(bool firstRender)
    {
        if (Session == null)
            return;

        var nextSignature = ComputeAutomationSignature();
        if (nextSignature == _automationSignature)
            return;

        _automationSignature = nextSignature;
        SyncScenarioAutomationTriggers();
    }

    private void BuildScenarioDraftSchemaForTopic()
    {
        if (Session == null || _scenarioDraftTopic == null)
        {
            _scenarioDraftSchemaFields = [];
            _scenarioDraftJson = "{}";
            return;
        }

        _scenarioDraftSchemaFields = BuildSchemaFieldsForType(_scenarioDraftTopic.TypeName);
        _scenarioDraftRawJsonMode = false;
        BuildScenarioDraftJsonFromForm();
    }

    private List<SchemaField> BuildSchemaFieldsForType(string typeName)
    {
        if (Session == null)
            return [];

        if (!Session.Types.TryGetValue(typeName, out var typeDef) || typeDef.Kind != DdsTypeKind.Struct)
        {
            return [];
        }

        var next = new List<SchemaField>();
        foreach (var member in typeDef.Members)
        {
            next.Add(BuildSchemaField(member));
        }

        return next;
    }

    private SchemaField BuildSchemaField(DdsTypeMember member)
    {
        if (member.IsArray || member.IsSequence)
        {
            return new SchemaField
            {
                Name = member.Name,
                Type = "array",
                Value = "[]",
                ItemTemplate = BuildArrayItemTemplate(member),
            };
        }

        if (Session != null && Session.Types.TryGetValue(member.TypeName, out var nestedType))
        {
            if (nestedType.Kind == DdsTypeKind.Enum)
            {
                return new SchemaField
                {
                    Name = member.Name,
                    Type = "enum",
                    EnumValues = nestedType.EnumValues.Keys.ToArray(),
                    Value = nestedType.EnumValues.Keys.FirstOrDefault() ?? string.Empty,
                };
            }

            if (nestedType.Kind == DdsTypeKind.Struct)
            {
                return new SchemaField
                {
                    Name = member.Name,
                    Type = "object",
                    Value = "{}",
                    Children = nestedType.Members.Select(BuildSchemaField).ToList(),
                };
            }
        }

        return new SchemaField
        {
            Name = member.Name,
            Type = MapPrimitiveType(member.TypeName),
            Value = DefaultValueForPrimitive(member.TypeName),
            BoolValue = false,
        };
    }

    private SchemaField BuildArrayItemTemplate(DdsTypeMember member)
    {
        if (Session != null && Session.Types.TryGetValue(member.TypeName, out var nestedType))
        {
            if (nestedType.Kind == DdsTypeKind.Struct)
            {
                return new SchemaField
                {
                    Name = "0",
                    Type = "object",
                    Value = "{}",
                    Children = nestedType.Members.Select(BuildSchemaField).ToList(),
                };
            }

            if (nestedType.Kind == DdsTypeKind.Enum)
            {
                return new SchemaField
                {
                    Name = "0",
                    Type = "enum",
                    EnumValues = nestedType.EnumValues.Keys.ToArray(),
                    Value = nestedType.EnumValues.Keys.FirstOrDefault() ?? string.Empty,
                };
            }
        }

        return new SchemaField
        {
            Name = "0",
            Type = MapPrimitiveType(member.TypeName),
            Value = DefaultValueForPrimitive(member.TypeName),
        };
    }

    private static string MapPrimitiveType(string typeName)
    {
        var normalized = typeName.ToLowerInvariant();
        return normalized switch
        {
            "boolean" or "bool" => "boolean",
            "int8" or "int16" or "int32" or "int64" or "uint8" or "uint16" or "uint32" or "uint64" or "long" or "ulong" or "short" or "ushort" => "integer",
            "float" or "float32" or "float64" or "double" => "number",
            _ => "string",
        };
    }

    private static string DefaultValueForPrimitive(string typeName)
    {
        var primitive = MapPrimitiveType(typeName);
        return primitive switch
        {
            "integer" or "number" => "0",
            _ => string.Empty,
        };
    }

    private void OnScenarioDraftRawModeChanged(bool raw)
    {
        _scenarioDraftRawJsonMode = raw;
        if (_scenarioDraftSchemaFields.Count == 0)
            return;

        if (raw)
            BuildScenarioDraftJsonFromForm();
        else
            TryPopulatePublishFieldsFromJson(_scenarioDraftJson);
    }

    private void BuildScenarioDraftJsonFromForm()
    {
        _scenarioDraftJson = JsonSerializer.Serialize(
            BuildJsonObject(_scenarioDraftSchemaFields),
            new JsonSerializerOptions { WriteIndented = true });
    }

    private static Dictionary<string, object?> BuildJsonObject(List<SchemaField> fields)
    {
        var obj = new Dictionary<string, object?>();
        foreach (var field in fields)
            obj[field.Name] = BuildFieldValue(field);
        return obj;
    }

    private static object? BuildFieldValue(SchemaField field) => field.Type switch
    {
        "boolean" => field.BoolValue,
        "integer" => long.TryParse(field.Value, out var longValue) ? longValue : 0L,
        "number" => double.TryParse(field.Value, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var doubleValue) ? doubleValue : 0.0,
        "object" when field.Children.Count > 0 => BuildJsonObject(field.Children),
        "object" => TryParseRaw(field.Value),
        "array" when field.ItemTemplate != null => field.ArrayItems.Select(BuildFieldValue).ToArray(),
        "array" => TryParseRaw(field.Value),
        _ => (object?)field.Value
    };

    private static object? TryParseRaw(string value)
    {
        try
        {
            using var doc = JsonDocument.Parse(value);
            return doc.RootElement.Clone();
        }
        catch
        {
            return value;
        }
    }

    private void TryPopulatePublishFieldsFromJson(string? json)
    {
        if (_scenarioDraftSchemaFields.Count == 0 || string.IsNullOrWhiteSpace(json)) return;

        try
        {
            using var doc = JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind != JsonValueKind.Object)
                return;

            ApplyObjectToFields(_scenarioDraftSchemaFields, doc.RootElement);
        }
        catch
        {
        }
    }

    private static void ApplyObjectToFields(List<SchemaField> fields, JsonElement element)
    {
        foreach (var field in fields)
        {
            if (!element.TryGetProperty(field.Name, out var value))
                continue;
            ApplyJsonToField(field, value);
        }
    }

    private static void ApplyJsonToField(SchemaField field, JsonElement value)
    {
        switch (field.Type)
        {
            case "boolean":
                field.BoolValue = value.ValueKind == JsonValueKind.True || (value.ValueKind == JsonValueKind.False ? false : field.BoolValue);
                break;
            case "integer":
            case "number":
            case "string":
            case "enum":
                field.Value = value.ValueKind == JsonValueKind.String ? value.GetString() ?? string.Empty : value.ToString();
                break;
            case "object":
                if (field.Children.Count > 0 && value.ValueKind == JsonValueKind.Object)
                    ApplyObjectToFields(field.Children, value);
                else
                    field.Value = value.GetRawText();
                break;
            case "array":
                if (field.ItemTemplate != null && value.ValueKind == JsonValueKind.Array)
                {
                    field.ArrayItems.Clear();
                    var index = 0;
                    foreach (var item in value.EnumerateArray())
                    {
                        var clone = field.ItemTemplate.DeepClone(index.ToString());
                        ApplyJsonToField(clone, item);
                        field.ArrayItems.Add(clone);
                        index++;
                    }
                }
                else
                {
                    field.Value = value.GetRawText();
                }
                break;
            default:
                field.Value = value.ToString();
                break;
        }
    }

