    private static string ScenarioStepModeGuidance(DdsStepMode mode)
        => mode switch
        {
            DdsStepMode.Manual => "이 단계는 `수동 단계 전체 실행`과 `전체 시작` 앞부분에 포함돼요. `자동 단계 시작`만으로는 움직이지 않아요.",
            DdsStepMode.Periodic => "이 단계는 `자동 단계 시작` 또는 `전체 시작` 뒤에 주기적으로 계속 발행돼요. 수동 단계 전체 실행에는 들어가지 않아요.",
            DdsStepMode.Bulk => "이 단계는 `자동 단계 시작` 또는 `전체 시작` 뒤에 다발 발행 규칙으로 움직여요. 수동 단계 전체 실행에는 들어가지 않아요.",
            DdsStepMode.OnIncoming => "이 단계는 `자동 단계 시작` 또는 `전체 시작` 뒤에 수신 이벤트를 기다렸다가 반응 발행해요. 수동 단계 전체 실행에는 들어가지 않아요.",
            _ => string.Empty
        };

    private static string ScenarioStepDestinationLabel(DdsScenarioStep step)
        => $"{step.TopicName} · {step.TypeName} · QoS {step.QosProfileName}";

    private const string DefaultScenarioName = "기본 시나리오";

    private int ScenarioStepCountFor(string scenario)
        => Session?.ScenarioSteps.Count(step => string.Equals(NormalizeScenarioName(step.Scenario), NormalizeScenarioName(scenario), StringComparison.OrdinalIgnoreCase)) ?? 0;

    private int ManualScenarioStepCountFor(string scenario)
        => Session?.ScenarioSteps.Count(step => string.Equals(NormalizeScenarioName(step.Scenario), NormalizeScenarioName(scenario), StringComparison.OrdinalIgnoreCase) && step.Mode == DdsStepMode.Manual) ?? 0;

    private int AutomaticScenarioStepCountFor(string scenario)
        => Session?.ScenarioSteps.Count(step => string.Equals(NormalizeScenarioName(step.Scenario), NormalizeScenarioName(scenario), StringComparison.OrdinalIgnoreCase) && step.Mode != DdsStepMode.Manual) ?? 0;

    private bool IsScenarioAutomationRunning(string? scenario)
        => _activeAutomationScenarios.Contains(NormalizeScenarioName(scenario));

    private void RehydrateAutomationScenariosFromTriggers()
    {
        if (Session == null || _activeAutomationScenarios.Count > 0)
            return;

        var activeScenarios = Triggers.Snapshot(Session.SessionId)
            .Where(trigger => trigger.Enabled)
            .Join(
                Session.ScenarioSteps,
                trigger => trigger.Id,
                step => step.Id,
                (_, step) => NormalizeScenarioName(step.Scenario))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (activeScenarios.Count == 0)
            return;

        foreach (var scenario in activeScenarios)
            _activeAutomationScenarios.Add(scenario);
        _automationRunning = true;
    }

    private string CreateScenarioName()
    {
        var existing = BuildScenarioGroups().Select(group => group.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var index = 1;
        while (existing.Contains($"시나리오 {index}"))
            index++;

        return $"시나리오 {index}";
    }

    private string NormalizeScenarioName(string? scenario)
        => string.IsNullOrWhiteSpace(scenario) ? DefaultScenarioName : scenario.Trim();

    private List<DdsScenarioGroupVm> BuildScenarioGroups()
    {
        if (Session == null)
            return [];

        var orderedSteps = Session.ScenarioSteps
            .Select((step, index) => new { Step = step, Index = index })
            .GroupBy(item => NormalizeScenarioName(item.Step.Scenario), StringComparer.OrdinalIgnoreCase)
            .OrderBy(group => group.Min(item => item.Index))
            .Select(group => new DdsScenarioGroupVm(group.Key, group.Select(item => item.Step).ToList()))
            .ToList();

        return orderedSteps;
    }

    private static string ScenarioStepPayloadPreview(DdsScenarioStep step)
    {
        var text = (step.JsonPayload ?? "{}").Replace('\r', ' ').Replace('\n', ' ').Trim();
        if (string.IsNullOrWhiteSpace(text))
            return "Payload 비어 있음";

        return text.Length > 120 ? text[..120] + "..." : text;
    }

    private static string ScenarioStepWhenLabel(DdsScenarioStep step)
    {
        var repeatLabel = $"단계 반복 {Math.Max(1, step.RepeatCount)}회";
        var delayLabel = step.DelayAfterMs > 0 ? $"\n다음 단계 전 {step.DelayAfterMs}ms 대기" : string.Empty;

        return step.Mode switch
        {
            DdsStepMode.Manual => $"수동 단계 전체 실행에 포함\n{repeatLabel}{delayLabel}",
            DdsStepMode.Periodic => $"자동화 시작 후 {step.IntervalMs}ms 주기 발행{(step.MaxFires.HasValue ? $"\n최대 {step.MaxFires}회" : string.Empty)}\n{repeatLabel}{delayLabel}",
            DdsStepMode.Bulk => $"자동화 시작 후 {Math.Max(1, step.BulkCount)}건 {(step.BulkParallel ? "병렬" : "순차")} 발행\n{repeatLabel}{delayLabel}",
            DdsStepMode.OnIncoming => $"자동화 시작 후 {(string.IsNullOrWhiteSpace(step.MatchTopicName) ? "전체 토픽" : step.MatchTopicName)} 수신 반응\n최소 간격 {Math.Max(0, step.MinFireIntervalMs)}ms · 분당 최대 {Math.Max(0, step.MaxFiresPerMinute)}회\n{repeatLabel}{delayLabel}",
            _ => repeatLabel
        };
    }

    private void OnSampleReceived(DdsSubscriptionInfo info, DdsSampleEntry sample)
    {
        if (Session == null || info.SessionId != Session.SessionId) return;
    }

    private DdsTopicConfig? FindTopic(string topicName)
    {
        return Session?.Topics.FirstOrDefault(topic => topic.TopicName == topicName);
    }

    private void SelectOutboundTopic(string topicName)
    {
        _selectedOutboundTopicName = topicName;
        _selectedOutboundKey = null;
    }

    private void ClearReceiveHistory()
    {
        if (Session == null)
            return;

        DdsState.ClearSamples(Session.SessionId);
        _selectedSampleSeq = 0;
        _cachedSamplesSubscriptionId = null;
        _cachedSamplesVersion = -1;
        _cachedSamples = [];
        State.AddLog($"DDS 수신 기록 초기화: {Session.Name}", LogLevel.Info);
    }

    private void ClearOutboundHistory()
    {
        if (Session == null)
            return;

        DdsState.ClearOutbound(Session.SessionId);
        _selectedOutboundTopicName = null;
        _selectedOutboundKey = null;
        _cachedDdsOutboundVersion = -1;
        _cachedRecentOutbound = [];
        State.AddLog($"DDS 송신 기록 초기화: {Session.Name}", LogLevel.Info);
    }

    private static string? ResolveSelectedOutboundTopic(IReadOnlyList<string> topics, string? selected)
    {
        if (topics.Count == 0)
            return null;

        return !string.IsNullOrWhiteSpace(selected) && topics.Contains(selected, StringComparer.Ordinal)
            ? selected
            : null;
    }

    private static DdsOutboundEntry? ResolveSelectedOutboundMessage(IReadOnlyList<DdsOutboundEntry> messages, string? selectedKey)
    {
        if (messages.Count == 0)
            return null;

        return messages.FirstOrDefault(message => OutboundKey(message) == selectedKey) ?? messages[0];
    }

    private static string OutboundKey(DdsOutboundEntry entry)
        => $"{entry.Timestamp.Ticks}:{entry.TopicName}:{entry.TypeName}:{entry.Success}";

    private async void OnDdsStateChanged()
    {
        if (Interlocked.Exchange(ref _renderQueued, 1) == 1)
            return;

        try
        {
            var elapsedMs = (DateTime.UtcNow.Ticks - Interlocked.Read(ref _lastRenderTicks)) / TimeSpan.TicksPerMillisecond;
            if (elapsedMs < 120)
                await Task.Delay((int)(120 - elapsedMs));

            Interlocked.Exchange(ref _lastRenderTicks, DateTime.UtcNow.Ticks);
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            Interlocked.Exchange(ref _renderQueued, 0);
        }
    }

    private void AppendLog(string scope, string level, string message)
    {
        var logLevel = level switch
        {
            "ERROR" => LogLevel.Error,
            "WARN" => LogLevel.Warn,
            _ => LogLevel.Info,
        };

        if (logLevel == LogLevel.Info)
            return;

        State.AddLog(message, logLevel);
    }

    private static Color LogColor(string level) => level switch
    {
        "ERROR" => Color.Error,
        "WARN" => Color.Warning,
        _ => Color.Default,
    };

    public void Dispose()
    {
        DdsState.StateChanged -= OnDdsStateChanged;
        DdsState.SampleReceived -= OnSampleReceived;
    }

    private static string SanitizeFileName(string value)
    {
        var invalid = Path.GetInvalidFileNameChars();
        var cleaned = new string(value.Select(ch => invalid.Contains(ch) ? '-' : ch).ToArray()).Trim();
        return string.IsNullOrWhiteSpace(cleaned) ? "dds-scenario" : cleaned;
    }

    private sealed class DdsScenarioExportFile
    {
        public int Version { get; set; }
        public DateTimeOffset ExportedAt { get; set; }
        public List<DdsScenarioStep> Steps { get; set; } = [];
    }

    private sealed record DdsScenarioGroupVm(string Name, List<DdsScenarioStep> OrderedSteps);
    private sealed record DdsOutboundTopicVm(string TopicName, List<DdsOutboundEntry> Messages);

