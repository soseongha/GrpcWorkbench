@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using ASAP.Models.Dds
@using ASAP.Models.Session
@using ASAP.Models.Ui
@using ASAP.Services
@using ASAP.Dds
@using LogLevel = ASAP.Models.Ui.LogLevel
@inject IDdsSessionService DdsSessions
@inject DdsStateService DdsState
@inject DdsTriggerService Triggers
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject WorkbenchStateService State
@implements IDisposable

@if (Session == null)
{
    <div class="wb-empty"><div>DDS 세션이 선택되지 않았습니다</div></div>
}
else
{
    EnsureDdsCache();
    var activeSubscriptions = ActiveSubscriptions.ToList();
    var outbound = RecentOutbound;
    var outboundByTopic = outbound
        .GroupBy(x => x.TopicName, StringComparer.Ordinal)
        .OrderBy(group => group.Key, StringComparer.Ordinal)
        .Select(group => new DdsOutboundTopicVm(group.Key, group.ToList()))
        .ToList();
    var outboundTopics = outboundByTopic.Select(x => x.TopicName).ToList();
    var selectedOutboundTopic = ResolveSelectedOutboundTopic(outboundTopics, _selectedOutboundTopicName);
    var selectedOutboundMessages = selectedOutboundTopic == null
        ? []
        : outbound.Where(x => string.Equals(x.TopicName, selectedOutboundTopic, StringComparison.Ordinal)).ToList();
    var selectedOutboundMessage = ResolveSelectedOutboundMessage(selectedOutboundMessages, _selectedOutboundKey);

    <div class="wb-panel wb-panel--major wb-panel--contain pa-3 mb-4">
        <div class="d-flex align-center flex-wrap mb-2" style="gap:8px;">
            <MudIcon Icon="@Icons.Material.Filled.Cable" Size="Size.Small" Color="Color.Success" />
            <div>
                <div class="wb-panel-kicker">DDS</div>
                <div class="wb-panel-heading">@Session.Name · domain @Session.Transport.DomainId</div>
            </div>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@Session.Topics.Count 토픽</MudChip>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@Session.Types.Count 타입</MudChip>
            @if (Session.QosProfiles.Count > 0)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">QoS: @string.Join(",", Session.QosProfiles)</MudChip>
            }
        </div>

        <div class="wb-subpanel mb-3 pa-3">
            <div class="d-flex align-center flex-wrap" style="gap:8px;">
                <div>
                    <div class="wb-panel-kicker">요약</div>
                    <div class="wb-panel-heading" title="핵심 연결 정보와 바로 할 일을 먼저 보여줍니다">상태</div>
                </div>
                <MudSpacer />
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">세션 @Session.SessionId[..8]</MudChip>
            </div>

            <div class="wb-summary-grid mt-3">
                <div class="wb-code wb-summary-card">
                    <span style="color:var(--mud-palette-text-secondary);">생성 시각</span><br />
                    @Session.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                </div>
                <div class="wb-code wb-summary-card">
                    <span style="color:var(--mud-palette-text-secondary);">네트워크</span><br />
                    domain @Session.Transport.DomainId · @(string.IsNullOrWhiteSpace(Session.Transport.MulticastAddress) ? "multicast 미설정" : Session.Transport.MulticastAddress)
                </div>
                <div class="wb-code wb-summary-card">
                    <span style="color:var(--mud-palette-text-secondary);">버퍼</span><br />
                    send @(Session.Transport.SendBufferSize?.ToString() ?? "default") / receive @(Session.Transport.ReceiveBufferSize?.ToString() ?? "default")
                </div>
                <div class="wb-code wb-summary-card">
                    <span style="color:var(--mud-palette-text-secondary);">로드된 파일</span><br />
                    @(string.IsNullOrWhiteSpace(Session.TypesXmlFileName) ? "DDSSim.xml 미기록" : Session.TypesXmlFileName)<br />
                    @(string.IsNullOrWhiteSpace(Session.ConfigXmlFileName) ? "dds-config.xml 미기록" : Session.ConfigXmlFileName)
                </div>
            </div>

            <div class="wb-inline-note mt-3" title="원본 XML 본문보다 수신 토픽 선택, 수동 발행, 자동 실행 단계 편집을 중심으로 구성합니다.">
                XML: @(Session.TypesXmlFileName ?? "types") · @(Session.ConfigXmlFileName ?? "config")
            </div>
        </div>

    </div>
    <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <div class="wb-panel wb-panel--major wb-panel--contain pa-3">
                    <div class="d-flex align-center mb-2" style="gap:8px;">
                        <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" Color="Color.Info" />
                        <div>
                            <div class="wb-panel-kicker">수신</div>
                            <div class="wb-panel-heading" title="수신 토픽과 샘플을 함께 봅니다">샘플</div>
                        </div>
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Class="ma-0">@activeSubscriptions.Count 활성</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@SelectedReceivableTopicCount 선택</MudChip>
                        <MudSpacer />
                    </div>

                    @if (ReceivableTopics.Count == 0)
                    {
                        <div class="wb-empty"><div>수신 가능한 DDS 토픽이 없습니다</div></div>
                    }
                    else
                    {
                        <div class="wb-subpanel mb-3 pa-3">
                            <div class="d-flex align-center mb-2" style="gap:8px;">
                                <div>
                                    <div class="wb-panel-kicker">선택</div>
                                    <div class="wb-panel-heading" title="팝업에서 수신 토픽을 선택하고 한 번에 시작/중지합니다">토픽</div>
                                </div>
                                <MudSpacer />
                                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Checklist"
                                           OnClick="OpenReceiveTopicPicker">수신 토픽 선택</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.PlayArrow"
                                           Disabled="@(SelectedStartableSubscriptionCount == 0)"
                                           OnClick="StartSelectedSubscriptions">수신 시작</MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Stop"
                                           Disabled="@(SelectedActiveSubscriptionCount == 0)"
                                           OnClick="StopSelectedSubscriptions">선택 중지</MudButton>
                                <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.DeleteSweep"
                                           Disabled="@(activeSubscriptions.Count == 0)"
                                           OnClick="ClearReceiveHistory">초기화</MudButton>
                            </div>

                            <div class="d-flex flex-wrap" style="gap:8px;">
                                @if (SelectedReceivableTopicCount == 0)
                                {
                                    <div class="wb-inline-note" title="수신 토픽 선택 버튼으로 먼저 골라 주세요.">선택 없음</div>
                                }
                                else
                                {
                                    @foreach (var topicName in SelectedReceivableTopicNames)
                                    {
                                        var selectedTopic = FindTopic(topicName);
                                        var isActive = ActiveSubscriptions.Any(s => s.TopicName == topicName);
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@(isActive ? Color.Success : Color.Default)"
                                                 Variant="Variant.Outlined"
                                                 OnClose="@(() => RemoveSelectedSubscriptionTopic(topicName))">
                                            @topicName@if (selectedTopic != null) { <text> · @selectedTopic.TypeName</text> }
                                        </MudChip>
                                    }
                                }
                            </div>
                        </div>

                        @if (activeSubscriptions.Count == 0)
                        {
                            <div class="wb-empty"><div>수신 중인 토픽이 없습니다</div></div>
                        }
                        else
                        {
                            var selectedSubscription = SelectedSubscription;
                            var selectedTopic = selectedSubscription == null ? null : FindTopic(selectedSubscription.TopicName);
                            var samples = selectedSubscription == null ? [] : GetCachedSamples(selectedSubscription.SubscriptionId);
                            <div class="wb-message-split">
                                <div class="wb-scroll wb-message-list">
                                    <Virtualize TItem="DdsSubscriptionInfo" Items="@activeSubscriptions" Context="subscription" ItemSize="62">
                                        <button type="button"
                                                class="wb-call-row @(selectedSubscription?.SubscriptionId == subscription.SubscriptionId ? "is-selected" : null)"
                                                @onclick="@(() => SelectSubscription(subscription.SubscriptionId))">
                                            <div class="wb-call-row-top">
                                                <span class="wb-mono wb-call-row-title">@subscription.TopicName</span>
                                                <span class="wb-call-row-count">@subscription.ReceivedCount 개 수신</span>
                                            </div>
                                            <div class="wb-call-row-meta">
                                                <span>@subscription.TypeName</span>
                                                <span>@subscription.StartedAt.ToLocalTime().ToString("HH:mm:ss")</span>
                                            </div>
                                        </button>
                                    </Virtualize>
                                </div>
                                <div class="wb-message-content">
                                    @if (selectedSubscription == null)
                                    {
                                        <div class="wb-empty"><div>왼쪽에서 수신 토픽을 선택하세요</div></div>
                                    }
                                    else if (samples.Count == 0)
                                    {
                                        <div class="wb-inline-note mb-2">@($"type: {selectedTopic?.TypeName ?? selectedSubscription.TypeName} · qos: {selectedTopic?.QosProfileName ?? "(미확인)"}")</div>
                                        <div class="wb-empty"><div>아직 수신된 샘플 없음</div></div>
                                    }
                                    else
                                    {
                                        <div class="wb-inline-note mb-2">@($"type: {selectedTopic?.TypeName ?? selectedSubscription.TypeName} · qos: {selectedTopic?.QosProfileName ?? "(미확인)"}")</div>
                                        var sel = samples.FirstOrDefault(x => x.SequenceNumber == _selectedSampleSeq) ?? samples.First();
                                        <div class="wb-message-split">
                                            <div class="wb-scroll wb-message-list">
                                                <Virtualize TItem="DdsSampleEntry" Items="@samples" Context="sample" ItemSize="38">
                                                    <button type="button"
                                                            class="wb-call-row wb-message-row @(sel.SequenceNumber == sample.SequenceNumber ? "is-selected" : null)"
                                                            @onclick="@(() => _selectedSampleSeq = sample.SequenceNumber)">
                                                        <div class="wb-message-row-main">
                                                            <span class="wb-mono">@sample.ReceivedAt.ToLocalTime().ToString("HH:mm:ss")</span>
                                                            <span>#@sample.SequenceNumber</span>
                                                        </div>
                                                    </button>
                                                </Virtualize>
                                            </div>
                                            <div class="wb-message-content">
                                             <JsonDataView Json="@sel.JsonData" AutoExpandDepth="3" />
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </MudItem>

            <MudItem xs="12" md="6">
                <div class="wb-panel wb-panel--major wb-panel--contain pa-3">
                    <div class="d-flex align-center mb-2" style="gap:8px;">
                        <MudIcon Icon="@Icons.Material.Filled.NorthEast" Size="Size.Small" Color="Color.Primary" />
                        <div>
                            <div class="wb-panel-kicker">송신</div>
                            <div class="wb-panel-heading" title="최근 DDS 송신 결과">결과</div>
                        </div>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@outbound.Count 메시지</MudChip>
                        <MudSpacer />
                        <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                                   Disabled="@(outbound.Count == 0)"
                                   OnClick="ClearOutboundHistory"
                                   StartIcon="@Icons.Material.Filled.DeleteSweep">초기화</MudButton>
                    </div>

                    @if (outbound.Count == 0)
                    {
                        <div class="wb-empty"><div>아직 송신된 DDS 메시지 없음</div></div>
                    }
                    else
                    {
                        <div class="wb-message-split">
                            <div class="wb-scroll wb-message-list">
                                <Virtualize TItem="DdsOutboundTopicVm" Items="@outboundByTopic" Context="topicGroup" ItemSize="62">
                                    @{
                                        var topicName = topicGroup.TopicName;
                                        var topicMessages = topicGroup.Messages;
                                        var last = topicMessages.First();
                                    }
                                    <button type="button"
                                            class="wb-call-row @(selectedOutboundTopic == topicName ? "is-selected" : null)"
                                            @onclick="@(() => SelectOutboundTopic(topicName))"
                                            title="@topicName">
                                        <div class="wb-call-row-top">
                                            <span class="wb-mono wb-call-row-title">@topicName</span>
                                            <span class="wb-call-row-count">@topicMessages.Count 개 송신</span>
                                        </div>
                                        <div class="wb-call-row-meta">
                                            <span>@last.TypeName</span>
                                            <span>@last.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                                        </div>
                                    </button>
                                </Virtualize>
                            </div>

                            <div class="wb-message-content">
                                @if (selectedOutboundMessage == null)
                                {
                                    <div class="wb-empty"><div>왼쪽에서 송신 토픽을 선택하세요</div></div>
                                }
                                else
                                {
                                    <div class="wb-inline-note mb-2">topic: @selectedOutboundMessage.TopicName · @selectedOutboundMessages.Count 개 송신</div>
                                    <div class="wb-message-split">
                                        <div class="wb-scroll wb-message-list">
                                            <Virtualize TItem="DdsOutboundEntry" Items="@selectedOutboundMessages" Context="message" ItemSize="38">
                                                @{
                                                    var messageKey = OutboundKey(message);
                                                }
                                                <button type="button"
                                                        class="wb-call-row wb-message-row @(OutboundKey(selectedOutboundMessage) == messageKey ? "is-selected" : null)"
                                                        @onclick="@(() => _selectedOutboundKey = messageKey)">
                                                    <div class="wb-message-row-main">
                                                        <span class="wb-mono">@message.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                                                        <span>@(message.Success ? "OK" : "실패")</span>
                                                    </div>
                                                </button>
                                            </Virtualize>
                                        </div>
                                        <div class="wb-message-content">
                                            <div class="wb-inline-note mb-2">@($"Outbound · {selectedOutboundMessage.Timestamp.ToLocalTime():yyyy-MM-dd HH:mm:ss} · {selectedOutboundMessage.TypeName}")</div>
                                            @if (selectedOutboundMessage.Success)
                                            {
                                                <JsonDataView Json="@selectedOutboundMessage.JsonPayload" AutoExpandDepth="3" />
                                            }
                                            else
                                            {
                                                <div class="wb-inline-note mb-2">@selectedOutboundMessage.Error</div>
                                                <JsonDataView Json="@selectedOutboundMessage.JsonPayload" AutoExpandDepth="3" />
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </MudItem>

            <MudItem xs="12">
                <div class="wb-panel wb-panel--major wb-panel--contain pa-3">
                    <div class="d-flex align-center mb-2" style="gap:8px;">
                        <MudIcon Icon="@Icons.Material.Filled.AutoMode" Size="Size.Small" Color="Color.Primary" />
                        <div>
                            <div class="wb-panel-kicker">DDS</div>
                            <div class="wb-panel-heading" title="시나리오 안에서 수동 단계와 자동 단계를 함께 운용합니다">자동화</div>
                        </div>
                    </div>

                    <div class="wb-subpanel pa-3">
                        <div class="d-flex align-center mb-2" style="gap:8px;">
                            <MudIcon Icon="@Icons.Material.Filled.PlaylistPlay" Size="Size.Small" Color="Color.Secondary" />
                            <div>
                                <div class="wb-panel-kicker">단계</div>
                                <div class="wb-panel-heading" title="시나리오를 만들고 그 안에서 단계 순서와 자동화를 구성합니다">시나리오</div>
                            </div>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@Session.ScenarioSteps.Count 단계</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">시나리오 @BuildScenarioGroups().Count</MudChip>
                            <MudSpacer />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="AddScenarioGroup"
                                       Disabled="@(DefaultPublishTopic == null)">시나리오 추가</MudButton>
                        </div>

                        <div class="wb-inline-note mb-2" title="시나리오 추가를 누르면 첫 단계가 포함된 새 시나리오를 만들고, 각 시나리오 안에서 실행 범위를 제어합니다.">시나리오 단위로 실행합니다</div>

                        <div class="d-flex align-center mb-2" style="gap:8px;">
                            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Download"
                                       OnClick="ExportScenarioJson"
                                       Disabled="@(Session.ScenarioSteps.Count == 0)">전체 내보내기</MudButton>
                            <MudFileUpload T="IBrowserFile" FilesChanged="ImportScenarioJson" Accept=".json">
                                <ActivatorContent>
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.UploadFile">전체 불러오기</MudButton>
                                </ActivatorContent>
                            </MudFileUpload>
                        </div>

                        @if (Session.ScenarioSteps.Count == 0)
                        {
                            <div class="wb-empty"><div>등록된 자동화 단계가 없습니다<br />시나리오 추가 후 단계와 자동화를 구성하세요</div></div>
                        }
                        else
                        {
                            var scenarioGroups = BuildScenarioGroups();
                            <div class="d-flex flex-wrap" style="gap:8px;">
                                @foreach (var group in scenarioGroups)
                                {
                                    <div class="wb-panel pa-3 wb-scenario-group" style="min-width:320px;flex:1 1 520px;">
                                        <div class="wb-scenario-step-top">
                                            <div>
                                                <div class="wb-scenario-step-order">시나리오</div>
                                                <div class="wb-scenario-step-title">@group.Name</div>
                                            </div>
                                            <div class="wb-chip-row">
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@group.OrderedSteps.Count 단계</MudChip>
                                                <MudChip T="string" Size="Size.Small" Color="@(IsScenarioAutomationRunning(group.Name) ? Color.Success : Color.Default)" Variant="Variant.Text" Class="ma-0">@(IsScenarioAutomationRunning(group.Name) ? "자동화 동작 중" : "자동화 대기")</MudChip>
                                            </div>
                                        </div>
                                        <div class="wb-scenario-step-actions mt-2">
                                            <MudButton Variant="Variant.Text" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Add"
                                                       OnClick="@(() => AddScenarioStep(group.Name))">단계</MudButton>
                                            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.PlayArrow"
                                                       OnClick="@(() => RunScenario(group.Name))"
                                                       title="수동 단계를 순서대로 실행합니다"
                                                       Disabled="@(ManualScenarioStepCountFor(group.Name) == 0 || _runningScenario)">수동</MudButton>
                                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.AutoMode"
                                                       OnClick="@(() => StartAutomation(group.Name))"
                                                       title="주기, 다발, 수신 반응 단계를 등록합니다"
                                                       Disabled="@(AutomaticScenarioStepCountFor(group.Name) == 0 || _runningScenario || IsScenarioAutomationRunning(group.Name))">자동</MudButton>
                                            <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.PlayCircle"
                                                       OnClick="@(() => StartScenarioWorkflow(group.Name))"
                                                       title="수동 단계를 실행한 뒤 자동 단계를 시작합니다"
                                                       Disabled="@((ManualScenarioStepCountFor(group.Name) == 0 && AutomaticScenarioStepCountFor(group.Name) == 0) || _runningScenario || IsScenarioAutomationRunning(group.Name))">전체</MudButton>
                                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Stop"
                                                       OnClick="@(() => StopAutomation(group.Name))"
                                                       Disabled="@(!IsScenarioAutomationRunning(group.Name))">중지</MudButton>
                                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Cancel"
                                                       OnClick="StopScenario"
                                                       Disabled="@(!_runningScenario)">중단</MudButton>
                                        </div>
                                        <div class="wb-scenario-list mt-2 wb-scroll" style="max-height:320px;overflow:auto;">
                                            @for (var i = 0; i < group.OrderedSteps.Count; i++)
                                            {
                                                var step = group.OrderedSteps[i];
                                                var isLastStep = i == group.OrderedSteps.Count - 1;
                                                <div class="wb-scenario-step mb-2">
                                                    <div class="wb-scenario-step-top">
                                                        <div>
                                                            <div class="wb-scenario-step-order">단계 @(i + 1)</div>
                                                            <div class="wb-scenario-step-title">@ScenarioStepDisplayName(step)</div>
                                                        </div>
                                                        <div class="wb-chip-row">
                                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@StepModeLabel(step.Mode)</MudChip>
                                                            <MudChip T="string" Size="Size.Small" Color="@(ScenarioStepStatusColor(step))" Variant="Variant.Text" Class="ma-0">@ScenarioStepStatusLabel(step)</MudChip>
                                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@step.TypeName</MudChip>
                                                        </div>
                                                    </div>
                                                    <div class="wb-scenario-step-meta">
                                                        <div>
                                                            <span class="wb-scenario-label">조건</span>
                                                            <span class="wb-scenario-value wb-preline">@ScenarioStepWhenLabel(step)</span>
                                                        </div>
                                                        <div>
                                                            <span class="wb-scenario-label">대상</span>
                                                            <span class="wb-scenario-value">@ScenarioStepDestinationLabel(step)</span>
                                                        </div>
                                                    </div>
                                                    <div class="wb-scenario-step-actions">
                                                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                                                   StartIcon="@Icons.Material.Filled.KeyboardArrowUp"
                                                                   Disabled="@(i == 0)"
                                                                   OnClick="@(() => MoveScenarioStep(step, -1))">위</MudButton>
                                                        <MudButton Variant="Variant.Text" Size="Size.Small"
