    {
        if (!_scenarioStepSchemaFields.TryGetValue(step.Id, out var fields) || fields.Count == 0)
            return;

        step.JsonPayload = JsonSerializer.Serialize(
            BuildJsonObject(fields),
            new JsonSerializerOptions { WriteIndented = true });
