@inherits LayoutComponentBase
@inject UiStateService Ui
@inject IJSRuntime JS
@inject ISessionService SessionService
@inject WorkbenchStateService State
@inject IDdsSessionService DdsSessions
@inject DdsStateService DdsState
@inject INatsSessionService NatsSessions
@implements IDisposable
@using System.Reflection
@using ASAP.Models.Dds
@using ASAP.Models.Session
@using ASAP.Models.Ui
@using ASAP.Services
@using ASAP.Nats

<MudThemeProvider Theme="_theme" IsDarkMode="Ui.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Color="Color.Surface"
               Style="border-bottom:1px solid var(--mud-palette-lines-default);">
        <MudIcon Icon="@Icons.Material.Filled.Hub" Color="Color.Primary" Class="mr-2" />
        <MudText Typo="Typo.subtitle1" Style="font-weight:700;letter-spacing:.02em;">
            Signal Forge
        </MudText>
        <MudText Typo="Typo.caption" Class="ml-2 wb-brand-mark d-none d-sm-inline-flex">
            LIG Defense&amp;Aerospace
        </MudText>
        <MudText Typo="Typo.caption" Class="ml-2 wb-brand-mark d-inline-flex d-sm-none">
            LIG
        </MudText>
        <MudTooltip Text="@AuthorInfoText">
            <MudIconButton Icon="@Icons.Material.Filled.Info"
                           Color="Color.Inherit"
                           Size="Size.Small"
                           Class="ml-1" />
        </MudTooltip>
        <MudText Typo="Typo.caption" Class="ml-3 d-none d-sm-flex"
                 Style="color:var(--mud-palette-text-disabled);">
            @AppVersion
        </MudText>
        <MudText Typo="Typo.caption" Class="ml-3 d-none d-md-flex wb-mono"
                 Style="color:var(--mud-palette-text-secondary);font-weight:600;">
            @CurrentTimeText
        </MudText>
        <MudMenu Dense="true" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
            <ActivatorContent>
                <MudTooltip Text="시간 표기 기준">
                    <MudIconButton Icon="@Icons.Material.Filled.Schedule"
                                   Color="Color.Inherit"
                                   Size="Size.Small" />
                </MudTooltip>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem OnClick="@(() => SetTimeDisplayAsync(TimeDisplayMode.Kst))">KST</MudMenuItem>
                <MudMenuItem OnClick="@(() => SetTimeDisplayAsync(TimeDisplayMode.Utc))">UTC</MudMenuItem>
                <MudMenuItem OnClick="@(() => SetTimeDisplayAsync(TimeDisplayMode.UnixEpoch))">Unix Epoch</MudMenuItem>
            </ChildContent>
        </MudMenu>
        <MudButton Variant="Variant.Text" Color="Color.Inherit" Size="Size.Small"
                   Class="ml-2" StartIcon="@Icons.Material.Filled.MonitorHeart"
                   OnClick="@(() => _statusOpen = !_statusOpen)">
            상태
        </MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Inherit" Size="Size.Small"
                   Class="ml-1" StartIcon="@Icons.Material.Filled.Terminal"
                   OnClick="@(() => _logsOpen = !_logsOpen)">
            로그 @State.LogCount
        </MudButton>

        <MudSpacer />

        <MudTooltip Text="@(Ui.IsDarkMode ? "라이트 모드" : "다크 모드")">
            <MudIconButton Icon="@(Ui.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit" Size="Size.Small"
                           OnClick="ToggleDarkAsync" />
        </MudTooltip>
    </MudAppBar>

    @if (_statusOpen)
    {
        <div class="wb-top-status-popover">
            <div class="d-flex align-center mb-2" style="gap:8px;">
                <MudIcon Icon="@Icons.Material.Filled.MonitorHeart" Size="Size.Small" Color="Color.Info" />
                <div>
                    <div class="wb-panel-kicker">상태</div>
                    <div class="wb-panel-heading">Signal Forge</div>
                </div>
                <MudSpacer />
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _statusOpen = false)" />
            </div>
            <div class="wb-forge-status-grid">
                @foreach (var item in BuildForgeStatus())
                {
                    <div class="wb-forge-status-card">
                        <div class="wb-forge-status-head">
                            <div>
                                <div class="wb-panel-kicker">@item.Kind</div>
                                <div class="wb-panel-heading">@item.State</div>
                            </div>
                            <span class="wb-dot @(item.IsOnline ? "wb-dot--on" : "wb-dot--off")"></span>
                        </div>
                        <div class="wb-forge-status-row">
                            <span>대상</span>
                            <strong title="@item.TargetTitle">@item.Target</strong>
                        </div>
                        <div class="wb-forge-status-row">
                            <span>브로커</span>
                            <strong>@item.Broker</strong>
                        </div>
                        <div class="wb-forge-status-row">
                            <span>메시지</span>
                            <strong>@item.Flow</strong>
                        </div>
                        <div class="wb-forge-status-row">
                            <span>P2P 지연</span>
                            <strong title="@item.LatencyTitle">@item.Latency</strong>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (_logsOpen)
    {
        <div class="wb-top-log-popover">
            <div class="d-flex align-center mb-2" style="gap:8px;">
                <MudIcon Icon="@Icons.Material.Filled.Terminal" Size="Size.Small" Color="Color.Info" />
                <div>
                    <div class="wb-panel-kicker">통합</div>
                    <div class="wb-panel-heading">로그</div>
                </div>
                <MudSpacer />
                <MudIconButton Icon="@Icons.Material.Filled.DeleteSweep" Size="Size.Small" OnClick="ClearGlobalLogs" />
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _logsOpen = false)" />
            </div>
            <div class="wb-code wb-scroll" style="max-height:360px;">
                @{
                    var logs = State.SnapshotLogs();
                }
                @if (logs.Count == 0)
                {
                    <span style="color:var(--mud-palette-text-disabled);">로그 없음</span>
                }
                else
                {
                    @for (var index = logs.Count - 1; index >= 0; index--)
                    {
                        var log = logs[index];
                        <div class="d-flex" style="gap:8px;align-items:flex-start;line-height:1.7;">
                            <MudIcon Icon="@LogIcon(log.Level)" Size="Size.Small"
                                     Style="@($"font-size:14px;color:{LogColorVar(log.Level)};flex:none;")" />
                            <span style="color:var(--mud-palette-text-disabled);">@log.Time.ToString("HH:mm:ss")</span>
                            <span style="color:@LogColorVar(log.Level);">@log.Text</span>
                        </div>
                    }
                }
            </div>
        </div>
    }

    <MudMainContent Style="background:var(--mud-palette-background);min-height:100vh;">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private static readonly string AppVersion =
        $"v{Assembly.GetExecutingAssembly().GetName().Version?.ToString(3) ?? "1.0.0"}";
    private const string AuthorInfoText =
        "author : 서태원\n" +
        "department : 미사일시스템통제기술연구소.M&S개발단.3팀\n" +
        "email : taewon.seo2@ligdna.com";
    private bool _statusOpen;
    private bool _logsOpen;
    private IReadOnlyList<ForgeStatusVm> _cachedForgeStatus = [];
    private DateTime _forgeStatusCacheUntil = DateTime.MinValue;
    private DateTimeOffset _currentUtc = DateTimeOffset.UtcNow;
    private PeriodicTimer? _clockTimer;
    private readonly CancellationTokenSource _clockCts = new();
    private TimeDisplayMode _timeDisplayMode = TimeDisplayMode.Kst;

    private string CurrentTimeText
    {
        get
        {
            return _timeDisplayMode switch
            {
                TimeDisplayMode.Utc => $"{_currentUtc:yyyy-MM-dd ddd HH:mm:ss.fff} UTC",
                TimeDisplayMode.UnixEpoch => $"epoch {_currentUtc.ToUnixTimeSeconds()}s / {_currentUtc.ToUnixTimeMilliseconds()}ms UTC",
                _ => $"{TimeZoneInfo.ConvertTime(_currentUtc, KstTimeZone):yyyy-MM-dd ddd HH:mm:ss.fff} KST"
            };
        }
    }

    protected override void OnInitialized()
    {
        Ui.Changed += OnUiChanged;
        State.Changed += OnUiChanged;
        StartClock();
    }

    private void OnUiChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "wb_dark");
            if (stored is "0" or "1")
                Ui.SetDarkMode(stored == "1");

            var storedTimeMode = await JS.InvokeAsync<string?>("localStorage.getItem", "wb_time_format");
            if (Enum.TryParse<TimeDisplayMode>(storedTimeMode, ignoreCase: true, out var parsed))
                _timeDisplayMode = parsed;
        }
        catch { /* localStorage 접근 실패 시 기본값(dark) 유지 */ }
    }

    private async Task ToggleDarkAsync()
    {
        Ui.SetDarkMode(!Ui.IsDarkMode);
        try { await JS.InvokeVoidAsync("localStorage.setItem", "wb_dark", Ui.IsDarkMode ? "1" : "0"); }
        catch { }
    }

    public void Dispose()
    {
        Ui.Changed -= OnUiChanged;
        State.Changed -= OnUiChanged;
        _clockCts.Cancel();
        _clockCts.Dispose();
        _clockTimer?.Dispose();
    }

    private void ClearGlobalLogs() => State.ClearLogs();

    private async Task SetTimeDisplayAsync(TimeDisplayMode mode)
    {
        _timeDisplayMode = mode;
        try { await JS.InvokeVoidAsync("localStorage.setItem", "wb_time_format", mode.ToString()); }
        catch { }
    }

    private static string LogColorVar(LogLevel level) => level switch
    {
        LogLevel.Success => "var(--mud-palette-success)",
        LogLevel.Warn => "var(--mud-palette-warning)",
        LogLevel.Error => "var(--mud-palette-error)",
        _ => "var(--mud-palette-text-secondary)"
    };

    private static string LogIcon(LogLevel level) => level switch
    {
        LogLevel.Success => Icons.Material.Filled.CheckCircle,
        LogLevel.Warn => Icons.Material.Filled.Warning,
        LogLevel.Error => Icons.Material.Filled.Error,
        _ => Icons.Material.Filled.Info
    };

    private void StartClock()
    {
        _clockTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = Task.Run(async () =>
        {
            try
            {
                while (await _clockTimer.WaitForNextTickAsync(_clockCts.Token))
                {
                    _currentUtc = DateTimeOffset.UtcNow;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException)
            {
            }
        });
    }

    private static TimeZoneInfo KstTimeZone { get; } = ResolveKstTimeZone();

    private static TimeZoneInfo ResolveKstTimeZone()
    {
        foreach (var id in new[] { "Asia/Seoul", "Korea Standard Time" })
        {
            try { return TimeZoneInfo.FindSystemTimeZoneById(id); }
            catch { }
        }

        return TimeZoneInfo.Local;
    }

    private enum TimeDisplayMode
    {
        Kst,
        Utc,
        UnixEpoch
    }

    private IReadOnlyList<ForgeStatusVm> BuildForgeStatus()
    {
        var now = DateTime.UtcNow;
        if (now < _forgeStatusCacheUntil)
            return _cachedForgeStatus;

        var grpcSessions = SessionService.GetAllSessions().ToList();
        var ddsSessions = DdsSessions.GetAll().ToList();
        var ddsSubscriptions = DdsState.SnapshotSubscriptions();
        var natsSessions = NatsSessions.GetAll().ToList();
        var natsSubscriptions = natsSessions
            .SelectMany(session => NatsSessions.SnapshotSubscriptions(session.SessionId))
            .ToList();
        var natsInbound = natsSessions.Sum(session => NatsSessions.InboundCount(session.SessionId));
        var natsOutbound = natsSessions.Sum(session => NatsSessions.OutboundCount(session.SessionId));
        var grpcCalls = State.SnapshotAggregates().Sum(aggregate => State.SnapshotRecentCalls(aggregate).Count);
        var grpcOutbound = State.SnapshotOutbound().Count;

        _cachedForgeStatus =
        [
            new ForgeStatusVm(
                "gRPC",
                grpcSessions.Count > 0 ? "연결" : "대기",
                grpcSessions.Count > 0,
                grpcSessions.Count > 0 ? string.Join(", ", grpcSessions.Select(FormatGrpcTarget).Distinct().Take(3)) : "대상 없음",
                grpcSessions.Count > 0 ? string.Join(", ", grpcSessions.Select(s => s.UnixSocketPath ?? s.SessionId).Distinct().Take(3)) : "gRPC 세션 없음",
                "직접",
                $"수신 {grpcCalls} · 송신 {grpcOutbound}",
                "평균 측정 대기",
                "현재 gRPC 평균 왕복 지연 측정 루프는 없습니다. echo/ping RPC를 열면 ms 단위 평균값을 붙일 수 있습니다."),
            new ForgeStatusVm(
                "DDS",
                ddsSessions.Count > 0 ? "활성" : "대기",
                ddsSessions.Count > 0,
                ddsSessions.Count > 0 ? string.Join(", ", ddsSessions.Select(FormatDdsTarget).Distinct().Take(3)) : "대상 없음",
                ddsSessions.Count > 0 ? string.Join(", ", ddsSessions.Select(FormatDdsTarget).Distinct().Take(3)) : "DDS 세션 없음",
                ddsSessions.Count > 0 ? "RTPS" : "없음",
                $"구독 {ddsSubscriptions.Count} · 수신 {ddsSubscriptions.Sum(s => s.ReceivedCount)}",
                ResolveAverageDdsLatency(ddsSubscriptions),
                "DDS source timestamp가 들어온 최근 샘플들의 평균 지연입니다."),
            new ForgeStatusVm(
                "NATS",
                natsSessions.Count > 0 ? "활성" : "대기",
                natsSessions.Count > 0,
                natsSessions.Count > 0 ? string.Join(", ", natsSessions.Select(s => s.Url).Distinct().Take(3)) : "대상 없음",
                natsSessions.Count > 0 ? string.Join(", ", natsSessions.Select(s => s.Url).Distinct().Take(3)) : "브로커 없음",
                natsSessions.Count > 0 ? "브로커" : "없음",
                $"구독 {natsSubscriptions.Count} · 수신 {natsInbound} · 송신 {natsOutbound}",
                "평균 측정 대기",
                "NATS 메시지에는 현재 원격 송신 timestamp가 없어 평균 왕복/브로커 지연은 별도 probe subject가 필요합니다.")
        ];
        _forgeStatusCacheUntil = now.AddMilliseconds(500);
        return _cachedForgeStatus;
    }

    private static string FormatGrpcTarget(GrpcSession session)
        => string.IsNullOrWhiteSpace(session.DisplayName)
            ? session.UnixSocketPath ?? session.SessionId[..Math.Min(8, session.SessionId.Length)]
            : session.DisplayName;

    private static string FormatDdsTarget(DdsSession session)
        => $"domain {session.Transport.DomainId}"
            + (string.IsNullOrWhiteSpace(session.Transport.MulticastAddress) ? string.Empty : $" · {session.Transport.MulticastAddress}");

    private static string ResolveAverageDdsLatency(IReadOnlyList<DdsSubscriptionInfo> subscriptions)
    {
        double totalMs = 0;
        long count = 0;

        foreach (var subscription in subscriptions)
        {
            lock (subscription)
            {
                totalMs += subscription.TotalLatencyMs;
                count += subscription.LatencySampleCount;
            }
        }

        return count == 0 ? "평균 측정 대기" : $"평균 {totalMs / count:0.0} ms";
    }

    private sealed record ForgeStatusVm(
        string Kind,
        string State,
        bool IsOnline,
        string Target,
        string TargetTitle,
        string Broker,
        string Flow,
        string Latency,
        string LatencyTitle);

    private readonly MudTheme _theme = new()
    {
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "8px",
            AppbarHeight = "52px"
        },
        // 폐쇄망: 외부 폰트 다운로드 없이 로컬 설치 글꼴 우선 사용
        // (타입명은 MudBlazor 버전마다 달라 중첩 초기자로 기존 Default 인스턴스만 수정)
        Typography = new Typography
        {
            Default = { FontFamily = ["AppSans", "Noto Sans KR", "Segoe UI", "Malgun Gothic",
                                      "Apple SD Gothic Neo", "Roboto", "Helvetica Neue", "Arial", "sans-serif"] }
        },
        PaletteDark = new PaletteDark
        {
            Primary          = "#5B8CFF",
            Secondary        = "#2DD4BF",
            Info             = "#38BDF8",
            Success          = "#22C55E",
            Warning          = "#F59E0B",
            Error            = "#F87171",
            Background       = "#101216",
            Surface          = "#1A1F26",
            AppbarBackground = "#13171D",
            AppbarText       = "rgba(255,255,255,0.94)",
            DrawerBackground = "#151A21",
            TextPrimary      = "rgba(255,255,255,0.94)",
            TextSecondary    = "rgba(255,255,255,0.70)",
            TextDisabled     = "rgba(255,255,255,0.40)",
            ActionDefault    = "rgba(255,255,255,0.70)",
            LinesDefault     = "#3A4350",
            LinesInputs      = "#465160",
            TableLines       = "#3A4350",
            Divider          = "#3A4350",
            DividerLight     = "#465160"
        },
        PaletteLight = new PaletteLight
        {
            Primary          = "#365DFF",
            Secondary        = "#0F766E",
            Info             = "#0369A1",
            Success          = "#15803D",
            Warning          = "#B45309",
            Error            = "#B91C1C",
            Background       = "#F3F5F8",
            Surface          = "#FFFFFF",
            AppbarBackground = "#FAFBFC",
            AppbarText       = "rgba(0,0,0,0.87)",
            TextPrimary      = "rgba(0,0,0,0.87)",
            TextSecondary    = "rgba(0,0,0,0.66)",
            TextDisabled     = "rgba(0,0,0,0.38)",
            LinesDefault     = "#CBD2DC",
            LinesInputs      = "#B7C0CE",
            Divider          = "#CBD2DC",
            DividerLight     = "#E2E7EF"
        }
    };
}
