<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>5bf98269-8435-485b-94d1-5f4cb48bfd0a</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
    <!-- src/ 폴더를 네임스페이스 경로에서 제외: src/Grpc/Foo.cs → ASAP.Grpc (not ASAP.src.Grpc) -->
    <RootNamespace>ASAP</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.64.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.64.0" />
    <PackageReference Include="Google.Protobuf" Version="3.31.1" />
    <PackageReference Include="Grpc.Tools" Version="2.78.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" />
    <PackageReference Include="MudBlazor" Version="7.15.0" />
    <PackageReference Include="NATS.Client.Abstractions" Version="2.8.0" />
    <PackageReference Include="NATS.Client.Core" Version="2.8.0" />
    <PackageReference Include="NATS.NKeys" Version="1.0.2" />

    <!-- RTI Connext DDS (rti/nupkg/에 .nupkg 4개; DDS 탭이 DynamicData로 사용) -->
    <PackageReference Include="Rti.ConnextDds" Version="7.3.1" />
    <PackageReference Include="Rti.ConnextDds.Extra" Version="7.3.1" />
    <PackageReference Include="Rti.ConnextDds.Native" Version="7.3.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="schema\proto\**\*.proto">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="schema\dds\definitions\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="samples\dds\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="ValidateSchemaArtifacts" BeforeTargets="CoreCompile">
      <Error Condition="!Exists('schema\dds\definitions\DDSSim.xml')"
        Text="schema/dds/definitions/DDSSim.xml 가 없습니다. ASAP의 DDS 테스트용 XML 정의를 직접 배치하세요." />
    <Error Condition="!Exists('schema\proto\grpc\DDSSim.proto')"
      Text="schema/proto/grpc/DDSSim.proto 가 없습니다. ASAP gRPC 테스트용 proto를 직접 배치하세요." />
    <Error Condition="!Exists('schema\proto\nats\DDSSim.proto')"
      Text="schema/proto/nats/DDSSim.proto 가 없습니다. ASAP NATS 테스트용 proto를 직접 배치하세요." />
  </Target>

  <Target Name="CopyGrpcToolsToPublish" AfterTargets="Publish"
          Condition="'$(PublishDir)' != '' and Exists('$(PkgGrpc_Tools)\tools\linux_x64\protoc') and Exists('$(PkgGrpc_Tools)\build\native\include')">
    <ItemGroup>
      <GrpcToolPublishFiles Include="$(PkgGrpc_Tools)\tools\linux_x64\protoc">
        <TargetPath>tools/protoc</TargetPath>
      </GrpcToolPublishFiles>
      <GrpcToolPublishFiles Include="$(PkgGrpc_Tools)\tools\linux_x64\grpc_csharp_plugin">
        <TargetPath>tools/grpc_csharp_plugin</TargetPath>
      </GrpcToolPublishFiles>
      <GrpcToolIncludeFiles Include="$(PkgGrpc_Tools)\build\native\include\**\*" />
    </ItemGroup>

    <MakeDir Directories="$(PublishDir)tools" />
    <MakeDir Directories="$(PublishDir)tools\include" />
    <Copy SourceFiles="@(GrpcToolPublishFiles)"
          DestinationFiles="@(GrpcToolPublishFiles->'$(PublishDir)%(TargetPath)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(GrpcToolIncludeFiles)"
          DestinationFiles="@(GrpcToolIncludeFiles->'$(PublishDir)tools\include\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
