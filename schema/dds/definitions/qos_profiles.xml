<qos_library name="AmbassadorProfiles">

  <!-- ReliableRealtime
       RELIABLE KEEP_ALL on both writer and reader.
       This prioritizes no intentional DDS history loss; slow consumers apply backpressure
       and memory can grow if downstream remains stalled. -->
  <qos_profile name="ReliableRealtime">
    <datawriter_qos>
      <reliability>
        <kind>RELIABLE_RELIABILITY_QOS</kind>
      </reliability>
      <history>
        <kind>KEEP_ALL_HISTORY_QOS</kind>
      </history>
      <liveliness>
        <kind>AUTOMATIC_LIVELINESS_QOS</kind>
        <lease_duration>
          <sec>1</sec>
          <nanosec>0</nanosec>
        </lease_duration>
      </liveliness>
    </datawriter_qos>
    <datareader_qos>
      <reliability>
        <kind>RELIABLE_RELIABILITY_QOS</kind>
      </reliability>
      <history>
        <kind>KEEP_ALL_HISTORY_QOS</kind>
      </history>
      <liveliness>
        <kind>AUTOMATIC_LIVELINESS_QOS</kind>
        <lease_duration>
          <sec>1</sec>
          <nanosec>0</nanosec>
        </lease_duration>
      </liveliness>
    </datareader_qos>
  </qos_profile>

</qos_library>
