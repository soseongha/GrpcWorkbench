@page
@model GrpcWorkbench.Pages.IndexModel
@{
    ViewData["Title"] = "GrpcWorkbench";
}

<div class="container-fluid mt-4 mb-4 px-3">
    <div style="margin: 0 auto; max-width: 1400px;">
        <div class="row mb-4">
            <div class="col">
                <h1>🚀 gRPC Workbench</h1>
                <p class="lead text-muted">gRPC Proto 파일을 업로드하거나 직접 작성하여 클라이언트로서 요청을 보낼 수 있습니다.</p>
            </div>
        </div>

        <div class="row">
            <!-- 좌측 패널: 설정 및 제어 -->
            <div class="col-lg-3">
                <!-- Step 1: 세션 설정 -->
                <div class="card border-primary mb-3">
                    <div class="card-header bg-primary text-white" data-bs-toggle="collapse" data-bs-target="#step1" style="cursor: pointer;">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">
                                <span class="badge bg-white text-primary me-2">1</span>세션 설정
                            </h6>
                            <div class="d-flex align-items-center gap-2">
                                <div id="serverHealth" class="d-flex align-items-center gap-1 px-2 py-1 rounded bg-white border border-light" style="font-size: 0.8rem;">
                                    <span id="healthDot" class="rounded-circle d-inline-block" style="width: 10px; height: 10px; background-color: #6c757d; border: 1px solid #adb5bd;"></span>
                                    <span id="healthText" class="text-dark fw-semibold">확인 중...</span>
                                </div>
                                <i class="bi bi-chevron-down" id="step1-icon"></i>
                            </div>
                        </div>
                    </div>
                    <div class="collapse show" id="step1">
                        <div class="card-body">
                            <div class="alert alert-secondary small mb-3">
                                UDS 소켓 경로는 서버 설정(환경변수/설정파일)에서 사용합니다.
                            </div>

                            <div class="form-group mb-3">
                                <label for="timeoutSeconds" class="form-label small">타임아웃 (초)</label>
                                <input type="number" id="timeoutSeconds" class="form-control form-control-sm" value="30" min="1" max="300">
                            </div>
                            <div class="d-grid">
                                <button class="btn btn-primary btn-sm" onclick="createSession()">세션 생성</button>
                            </div>
                            <div id="sessionStatus" class="mt-2 alert alert-info d-none mb-0" style="font-size: 0.85rem;">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>세션:</strong> <span id="sessionStatusText"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Step 2: Proto 파일 -->
                <div class="card border-success mb-3">
                    <div class="card-header bg-success text-white" data-bs-toggle="collapse" data-bs-target="#step2" style="cursor: pointer;">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">
                                <span class="badge bg-white text-success me-2">2</span>Proto 정의
                            </h6>
                            <i class="bi bi-chevron-down" id="step2-icon"></i>
                        </div>
                    </div>
                    <div class="collapse" id="step2">
                        <div class="card-body">
                            <!-- 탭: 업로드 / 편집 -->
                            <div class="form-group mb-3">
                                <input type="file" id="protoFile" class="form-control form-control-sm" accept=".proto">
                                <small class="text-muted d-block mt-1">.proto 파일만 허용</small>
                            </div>
                            <div class="d-grid gap-2">
                                <button class="btn btn-success btn-sm" onclick="uploadProto()" id="uploadBtn" disabled>파일 업로드</button>
                                <button class="btn btn-outline-success btn-sm" onclick="showProtoFile()" id="viewProtoBtn" disabled>📄 파일 전문 보기</button>
                            </div>
                            <div id="uploadStatus" class="mt-2 alert alert-info d-none mb-0" style="font-size: 0.85rem;">
                                <strong>상태:</strong> <span id="uploadStatusText"></span>
                            </div>
                            <!-- Proto 파일 전문 -->
                            <div id="protoFileContent" class="alert alert-light border d-none mt-3 mb-0" style="font-size: 0.8rem;">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="mb-0"><strong>📄 Proto 파일 내용</strong></h6>
                                    <button class="btn btn-sm btn-link" onclick="hideProtoFile()" style="padding: 0; color: #6c757d;">✕</button>
                                </div>
                                <pre id="protoFileText" class="mb-0 small" style="max-height: 200px; overflow-y: auto;"></pre>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Step 3: 요청 설정 -->
                <div class="card border-info mb-3">
                    <div class="card-header bg-info text-white" data-bs-toggle="collapse" data-bs-target="#step3" style="cursor: pointer;">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">
                                <span class="badge bg-white text-info me-2">3</span>요청 설정
                            </h6>
                            <i class="bi bi-chevron-down" id="step3-icon"></i>
                        </div>
                    </div>
                    <div class="collapse" id="step3">
                        <div class="card-body" style="max-height: 600px; overflow-y: auto;">
                            <div class="form-group mb-3">
                                <label for="serviceSelect" class="form-label small">서비스</label>
                                <select id="serviceSelect" class="form-select form-select-sm" onchange="onServiceChanged()">
                                    <option value="">-- 서비스 선택 --</option>
                                </select>
                            </div>
                            <div class="form-group mb-3">
                                <label for="methodSelect" class="form-label small">메서드</label>
                                <select id="methodSelect" class="form-select form-select-sm" onchange="onMethodChanged()">
                                    <option value="">-- 메서드 선택 --</option>
                                </select>
                            </div>
                            <div id="methodInfo" class="alert alert-secondary d-none mb-3" style="font-size: 0.85rem;">
                                <small id="methodInfoText"></small>
                            </div>

                            <!-- 메시지 정의 -->
                            <div id="messageDefinitions" class="alert alert-light border d-none mt-3 mb-0" style="font-size: 0.8rem;">
                                <h6 class="mb-2"><strong>📋 메시지 정의</strong></h6>
                                <div id="requestMessageDef" class="mb-3 d-none">
                                    <h7 class="text-info"><strong>요청:</strong> <span id="requestMessageName"></span></h7>
                                    <pre id="requestMessageContent" class="mb-0 small bg-white p-2 rounded" style="max-height: 120px; overflow-y: auto;"></pre>
                                </div>
                                <div id="responseMessageDef" class="d-none">
                                    <h7 class="text-success"><strong>응답:</strong> <span id="responseMessageName"></span></h7>
                                    <pre id="responseMessageContent" class="mb-0 small bg-white p-2 rounded" style="max-height: 120px; overflow-y: auto;"></pre>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 우측 패널: 요청 및 응답 -->
            <div class="col-lg-9">
                <div class="row mb-3">
                    <!-- 요청 입력 -->
                    <div class="col-lg-6">
                        <div class="card h-100">
                            <div class="card-header bg-light border-bottom">
                                <h5 class="mb-0">📝 요청 데이터 입력</h5>
                            </div>
                            <div class="card-body" style="max-height: 450px; overflow-y: auto;">
                                <div id="requestFormContainer" class="d-none">
                                    <p class="text-muted small mb-3">메서드의 입력 메시지 필드를 입력하세요.</p>
                                    <form id="requestForm"></form>

                                    <!-- 메타데이터 입력 -->
                                    <div class="mt-3">
                                        <label class="form-label small d-flex justify-content-between">
                                            <span>📎 메타데이터</span>
                                            <button class="btn btn-outline-secondary btn-sm py-0 px-1" type="button" onclick="addMetadataRow()" style="font-size: 0.7rem;">+ 추가</button>
                                        </label>
                                        <div id="metadataContainer"></div>
                                    </div>
                                </div>
                                <div id="requestPlaceholder" class="alert alert-info mb-0" style="font-size: 0.85rem;">
                                    <p class="mb-0">좌측에서 메서드를 선택하면 입력 폼이 표시됩니다.</p>
                                </div>
                                <!-- 스트리밍 설정 (Client/Bidirectional 선택 시 표시) -->
                                <div id="streamingSettings" class="d-none mt-3">
                                    <hr class="my-2">
                                    <label class="form-label small fw-bold">⚡ 스트리밍 설정</label>
                                    <div class="row g-2 mb-2">
                                        <div class="col-6">
                                            <label class="form-label small">전송 간격 (ms)</label>
                                            <input type="number" id="streamInterval" class="form-control form-control-sm" value="500" min="50" max="10000">
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small">전송 횟수</label>
                                            <input type="number" id="streamCount" class="form-control form-control-sm" value="5" min="1" max="1000">
                                        </div>
                                    </div>
                                    <div id="streamProgress" class="d-none mb-2">
                                        <div class="d-flex justify-content-between small text-muted mb-1">
                                            <span>전송 진행</span>
                                            <span id="streamProgressText">0 / 0</span>
                                        </div>
                                        <div class="progress" style="height: 6px;">
                                            <div id="streamProgressBar" class="progress-bar bg-warning" role="progressbar" style="width: 0%"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer bg-light border-top">
                                <!-- Unary / Server Streaming 용 -->
                                <div id="unaryButtons" class="d-grid">
                                    <button class="btn btn-warning btn-sm" onclick="sendRequest()" id="sendBtn" disabled>
                                        🚀 요청 보내기
                                    </button>
                                </div>
                                <!-- Client / Bidirectional Streaming 용 -->
                                <div id="streamingButtons" class="d-none">
                                    <div class="d-grid gap-2 d-md-flex">
                                        <button class="btn btn-success btn-sm flex-grow-1" onclick="startStreaming()" id="startStreamBtn" disabled>
                                            ▶ 스트리밍 시작
                                        </button>
                                        <button class="btn btn-danger btn-sm" onclick="stopStreaming()" id="stopStreamBtn" disabled>
                                            ⏹ 종료
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 응답 표시 -->
                    <div class="col-lg-6">
                        <div class="card h-100">
                            <div class="card-header bg-light border-bottom d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">📤 응답 결과</h5>
                                <button class="btn btn-sm btn-outline-secondary" onclick="copyResponse()" id="copyBtn" disabled>
                                    📋 복사
                                </button>
                            </div>
                            <div class="card-body" style="max-height: 450px; overflow-y: auto; background-color: #f8f9fa;">
                                <div id="responseContainer" class="text-muted" style="font-size: 0.9rem;">
                                    아직 요청을 보내지 않았습니다.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 로그 -->
                <div class="card">
                    <div class="card-header bg-light border-bottom d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">📝 실행 로그</h5>
                        <button class="btn btn-sm btn-outline-secondary" onclick="clearLogs()">🗑️ 로그 지우기</button>
                    </div>
                    <div class="card-body" style="max-height: 250px; overflow-y: auto; background-color: #f8f9fa;">
                        <div id="logContainer" class="font-monospace small text-muted">
                            <p>로그가 여기에 표시됩니다.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/grpc-workbench.js" asp-append-version="true"></script>
}
